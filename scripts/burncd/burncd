#!/usr/bin/env bash
#
# burncd — burn a directory of audio files to an audio CD.
#
#   burncd --check                 check this machine is ready to burn
#   burncd ~/Music/Album           burn it
#   burncd -n ~/Music/Album        dry run: show the plan, burn nothing
#   burncd --dummy ~/Music/Album   rehearse the burn with the laser off
#   burncd --verify ~/Music/Album  read the disc back afterwards and check it
#   burncd --level ~/Music/Album   raise a quiet album to normal CD loudness
#   burncd --split-long ~/Music/X  cut tracks longer than a disc into parts
#   burncd --no-cdtext ~/Music/X   burn without CD-Text (fallback path)
#   burncd --from-disc 3 ~/Music/X resume a multi-disc job at disc 3
#   burncd --demo ~/Music/Album    build everything and simulate the burn
#
# Takes aiff, flac, mp3, ogg, wav, m4a, opus — anything ffmpeg reads.
# Track order comes from embedded metadata, not filenames. Audio is converted
# to 16-bit/44.1kHz stereo and written disc-at-once, so there are no gaps
# between tracks. Album, artist and track titles are written as CD-Text. Sets
# too long for one disc are split across as many as it takes, balanced so the
# last disc is not a stub.
#
# The plan shown before every burn is the editor, not a printout: arrow to any
# row and press Enter to fix a title, a for the artist, shift-arrows to
# reorder, x to drop a track, b to burn, q to walk away. Tags are wrong often
# enough that spotting it on the preview has to be all it takes.
#
# Env overrides:
#   BURNCD_SPEED   burn speed (default 8)
#   BURNCD_DEV     cdrecord device (default IOCompactDiscServices)
#   BURNCD_SECONDS disc capacity in seconds (default 4797 = 79:57, a real 80min blank)
#   BURNCD_MINUTES same, in whole minutes, if you prefer
#   BURNCD_LEVEL   album | track | off — default for --level (default off)
#   BURNCD_LUFS    loudness target in LUFS (default -11, typical for a CD)
#   BURNCD_PEAK    true-peak ceiling in dBTP (default -1)

set -euo pipefail

# Every rule, meter cell and track title on the edit screen is UTF-8, and ${#s}
# counts bytes unless the ctype locale says otherwise — one accented title would
# then shove the whole column grid sideways. Only the ctype category is changed,
# so collation and number formatting are left exactly as the user has them.
#
# LC_ALL has to be dismantled first when it is what pins the locale: bash ignores
# LC_CTYPE for as long as LC_ALL is set and non-empty, so exporting one under the
# other looks like a fix and does nothing. Someone with LC_ALL=C in their profile
# for reproducible sorting is exactly the person this block exists for. Handing
# its value to the other five categories keeps every one of them where it was.
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
  *UTF-8*|*utf-8*|*UTF8*|*utf8*) ;;
  *) if [ -n "${LC_ALL:-}" ]; then
       export LC_COLLATE="$LC_ALL"  LC_NUMERIC="$LC_ALL"  LC_TIME="$LC_ALL" \
              LC_MONETARY="$LC_ALL" LC_MESSAGES="$LC_ALL"
       unset LC_ALL
     fi
     LOCALES=$( (locale -a 2>/dev/null || true) | tr '\n' ' ' )
     case " $LOCALES " in
       *" en_US.UTF-8 "*) export LC_CTYPE=en_US.UTF-8 ;;
       *" C.UTF-8 "*)     export LC_CTYPE=C.UTF-8 ;;
       *)                 export LC_CTYPE=UTF-8 ;;   # BSD libc accepts the bare name
     esac ;;
esac

# Whether any of that worked, asked of the shell rather than of the locale's
# name: this one comparison is the exact property every width calculation in the
# file rests on. One character, two bytes. Everywhere else that wants to know
# reads UTF8 instead of re-deriving it from the environment and getting a
# slightly different answer.
UTF8_PROBE='é'
if [ "${#UTF8_PROBE}" -eq 1 ]; then UTF8=1; else UTF8=0; fi

SPEED="${BURNCD_SPEED:-8}"
DEV="${BURNCD_DEV:-IOCompactDiscServices}"
DRY_RUN=0
DEMO=0
CHECK=0
SPLIT_LONG=0
CDTEXT=1
DUMMY=0
VERIFY=0
FROM=1

# Loudness matching. "album" applies one gain to the whole job so the relative
# levels the mastering engineer chose survive; "track" levels each track on its
# own, which is only right for a compilation of unrelated masters.
LEVEL="${BURNCD_LEVEL:-off}"
# -11 LUFS is about where a normal commercial CD sits. Chasing much louder than
# that needs compression, which this deliberately will not do.
LUFS_TARGET="${BURNCD_LUFS:--11}"
# Leave a dB of true-peak headroom: inter-sample peaks can exceed the highest
# sample, and some DACs clip reconstructing them even when the PCM is legal.
PEAK_CEIL="${BURNCD_PEAK:--1}"

BAR_WIDTH=42
# The panel is a fixed 71 columns: 2 of margin plus a 69-column grid that the
# header rule, the track rows and the meter all share. Fixed rather than fluid
# because every column here has a job — 34 for a title, 20 for an artist — and
# a grid that reflows is a grid you cannot learn.
PANEL=69
# The meter gets the whole grid minus its two brackets, and its readout moves to
# a line of its own. Width is the only thing that buys resolution here: eleven
# tracks across a half-full disc had about two cells each, and at two cells the
# difference between a 3:14 and a 2:58 is not a thing the bar can say.
STRIP_WIDTH=$(( PANEL - 2 ))
# Every row of the edit panel that is not a track, and the shortest window that
# can still hold one. Up here rather than beside tui_fit_rows, which is what
# counts with them, because the decision to open the screen at all is made before
# any of the display exists — see the screen gate after the requirements check.
TUI_CHROME=14
TUI_MIN_LINES=$(( TUI_CHROME + 5 ))
MAX_TRACKS=99          # Red Book hard limit: a CD cannot hold more than 99 tracks.
SECTOR=2352            # bytes per CD audio sector: 588 stereo 16-bit samples
BYTES_PER_SEC=176400   # 44100 Hz * 2 channels * 2 bytes
CDTEXT_BUDGET=3800     # rough byte ceiling for CD-Text packs in the lead-in

# Panel palette. The edit screen is dressed as the faceplate of a deck that never
# existed: amber silkscreen on black, backlit keycaps, a tape-counter readout.
# Amber is the chrome — rules, labels, the badge — and never the data, so the
# titles stay the brightest thing on the screen.
AMBER='\033[38;5;214m'      # lit amber, for the readout and keycap legends
ETCH='\033[38;5;172m'       # the darker amber of paint on a metal panel
BADGE='\033[48;5;214m\033[38;5;232m'   # engraved plate: black on amber
CAP='\033[48;5;236m\033[38;5;214m'     # a keycap, backlit from behind
OFF='\033[0m'
DIM='\033[2m'
INV='\033[7m'
# Four steps around the panel's own amber rather than four cool hues: cyan and
# violet on an amber faceplate read as a different instrument bolted on. These
# stay in the lamp-and-oxide family — amber, brown, gold, burnt orange — and
# zigzag light/dark/light/dark, so neighbouring bands separate on brightness even
# where the hues are cousins, and the edges survive without colour vision. The
# plan's capacity meter and the burn screen's progress bar share them, because
# they are the same picture at two moments.
SHADES=(214 130 220 166)
RUNOUT=94              # the darkest amber on the ramp: everything not yet used
HEAD=231               # the write head, the brightest thing on the screen

# Repeat one character n times, for panel rules.
rep() {  # rep <char> <count>
  repv "$1" "$2"
  printf '%s' "$REP"
}

# The same, and the padding it is built from, returned in a global instead of on
# stdout. Every $( ) is a fork, forks on macOS cost a millisecond or two, and one
# frame of the edit screen wanted about 130 of them — a quarter of a second of
# lag after an arrow key, which is exactly long enough to feel. Nothing on the
# panel's hot path spawns a process now; it all writes into REP, PAD, FIT, MMSS.
SPACES='                                                                                '
pad() {  # pad <count> -> $PAD
  PAD=''
  [ "$1" -gt 0 ] || return 0
  while [ "$1" -gt "${#SPACES}" ]; do SPACES="$SPACES$SPACES"; done
  PAD=${SPACES:0:$1}
}
repv() {  # repv <char> <count> -> $REP
  REP=''
  [ "$2" -gt 0 ] || return 0
  pad "$2"
  REP=${PAD// /$1}
}

# How big the window actually is. Not plain `tput lines`: tput measures the
# terminal attached to its own stdout, and inside $( ) that is a pipe, so it
# falls back to whatever static size the terminfo entry declares — 24x80 for
# most xterm entries. The edit screen would then page a 30-track album in a
# 50-row window for no reason. stty asks the kernel for the real window size
# off /dev/tty, which no redirection can move.
#
# The answer lands in globals and is cached, because asking costs an exec and the
# edit screen asks once per keypress. A SIGWINCH handler clears the cache, so a
# resized window is still noticed at the next redraw.
TERM_LINES='' TERM_COLS=''
term_size() {  # term_size -> $TERM_LINES, $TERM_COLS
  local sz
  [ -n "$TERM_LINES" ] && [ -n "$TERM_COLS" ] && return 0
  sz=$( (stty size </dev/tty) 2>/dev/null || true )
  TERM_LINES=${sz%% *}
  TERM_COLS=${sz##* }
  case "$TERM_LINES" in ''|*[!0-9]*|0) TERM_LINES=$(tput lines 2>/dev/null || true) ;; esac
  case "$TERM_COLS"  in ''|*[!0-9]*|0) TERM_COLS=$(tput cols 2>/dev/null || true) ;; esac
  case "$TERM_LINES" in ''|*[!0-9]*|0) TERM_LINES=24 ;; esac
  case "$TERM_COLS"  in ''|*[!0-9]*|0) TERM_COLS=80 ;; esac
  return 0
}

# ---------------------------------------------------------------- the screen --

# burncd is one instrument for the length of a job, not a program that prints.
#
# Everything from the edit panel to the last disc happens on the alternate
# screen: the plan, the prompt for a blank disc, the conversion, the burn and the
# summary are stages of one display, and each one is laid over the last from the
# home position. Nothing scrolls, nothing stacks, and the scrollback underneath
# is untouched until the job is over — at which point burncd steps off the
# alternate screen and prints the plan and the summary into the terminal proper,
# so there is still a record of what was burned.
#
# It is all-or-nothing on purpose. A pipe, a dry run, or a window too small to
# hold the panel gets the old behaviour, printed line by line, and every stage
# below checks $SCREEN rather than assuming it owns the terminal.
SCREEN=0
SCREEN_STTY=''

screen_on() {
  [ "$SCREEN" -eq 1 ] && return 0
  [ -t 0 ] && [ -t 1 ] || return 1
  SCREEN_STTY=$(stty -g 2>/dev/null || true)
  # Erase on the way in only. Every frame after this one is laid over its
  # predecessor rather than drawn on a cleared screen — see paint().
  printf '\033[?1049h\033[?25l\033[H\033[2J'
  SCREEN=1
  # Drop the cached window size when the window changes, so the next frame
  # measures again and every other frame does not have to.
  trap 'TERM_LINES=; TERM_COLS=' WINCH
  # From here to the end of the job there is no moment where a Ctrl-C leaves the
  # terminal on the alternate screen in raw mode. The burn loop replaces this
  # with one that also takes the working directory with it.
  trap 'int_nl; screen_off; exit 130' INT
  return 0
}

# The newline a Ctrl-C prints is for the shell prompt's benefit: the terminal
# echoes ^C where the cursor is, and without it the prompt lands beside it. On a
# screened run that echo went to the alternate buffer and leaves with it, so the
# primary screen's cursor is still at the start of the line after the command
# that was typed — printing here would open a blank line under it instead. Call
# this before screen_off, while SCREEN still says which case this is.
int_nl() {
  [ "$SCREEN" -eq 1 ] || printf '\n'
  return 0
}

# Idempotent, and called from die() and from the exit trap as much as from the
# ordinary end of a job: whatever goes wrong, the terminal is handed back with
# its cursor visible, its modes as they were, and the scrollback intact.
screen_off() {
  [ "$SCREEN" -eq 1 ] || return 0
  SCREEN=0
  [ -n "$SCREEN_STTY" ] && stty "$SCREEN_STTY" 2>/dev/null || true
  printf '\033[?25h\033[?1049l'
  return 0
}

# Lay one frame over the screen from the home position.
#
# No erase first, and one write for the whole frame. Clearing and then drawing is
# two pictures the terminal genuinely paints, so the blank one shows through as a
# flash — and printing a panel line by line lets the screen refresh mid-frame on
# top of that. Instead: end every line with an erase-to-end-of-line so a line that
# got shorter cannot leave the tail of the old one behind, and \033[J at the
# bottom to clear whatever the previous frame had below this one. Nothing is ever
# blank in between, so there is nothing to flicker.
#
# The frame must be at most one line shorter than the window. \033[H is absolute,
# so a frame that scrolls the terminal loses its own top row permanently — the
# next frame homes to a row that now holds something else.
paint() {  # paint <frame>
  local nl=$'\n' eol=$'\033[K\n'
  printf '\033[H%s\033[K\n\033[J' "${1//$nl/$eol}"
  return 0
}

# The faceplate every screen wears: engraved badge, a rule across the panel, and
# the state of the machine stamped at the far end the way a deck prints its mode.
# The plan, the editor, each burn stage and the summary all print this same line,
# which is most of why they read as one instrument.
faceplate() {  # faceplate <meta>
  local rule=$(( PANEL - 10 - ${#1} ))
  [ "$rule" -lt 2 ] && rule=2
  repv '━' "$rule"
  printf '  %b BURNCD %b %b%s%b %b%s%b\n' \
    "$BADGE" "$OFF" "$ETCH" "$REP" "$OFF" "$ETCH" "$1" "$OFF"
  return 0
}

die() { screen_off; printf '\nburncd: %s\n' "$1" >&2; exit 1; }

usage() {
  awk 'NR > 2 && /^#/ { sub(/^# ?/, ""); print; next } NR > 2 { exit }' "$0"
  exit "${1:-0}"
}

# Seconds -> M:SS, on stdout or (on the panel's hot path) in $MMSS.
mmss() { printf '%d:%02d' $(( $1 / 60 )) $(( $1 % 60 )); }
mmssv() { printf -v MMSS '%d:%02d' $(( $1 / 60 )) $(( $1 % 60 )); }

# Sectors -> MM:SS:FF, the addressing a cue sheet uses (75 frames per second).
msf() { printf '%02d:%02d:%02d' $(( $1 / 4500 )) $(( $1 % 4500 / 75 )) $(( $1 % 75 )); }

human() { awk -v b="$1" 'BEGIN { printf "%.1f GB", b / 1073741824 }'; }

# Free space, in bytes, on the filesystem holding $1.
free_bytes() { df -k "$1" 2>/dev/null | awk 'NR == 2 { print $4 * 1024; exit }'; }

file_size() { stat -f%z "$1" 2>/dev/null || stat -c%s "$1"; }

# Quiet match on a pipe. Not `grep -q`: that exits at the first match and closes
# the pipe, and under `set -o pipefail` the SIGPIPE that kills the writer fails
# the whole test — so a capability that is present reads as absent, depending on
# whether the writer happened to finish first. Reading to EOF is the difference
# between a check that works and one that lies.
qgrep() { grep "$@" >/dev/null; }

# Env values reach arithmetic contexts, so reject junk before it becomes a
# confusing shell error mid-burn.
numeric() {
  case "$2" in ''|*[!0-9]*) die "$1 must be a whole number, got: $2" ;; esac
}
numeric BURNCD_SPEED "$SPEED"

# A blank sold as "80 minute" / 700 MB actually holds 79:57 — 359,849 sectors
# at 75 per second. 80:00 is rounding on the packaging, not real capacity.
# Track lengths are rounded up when read, so aiming at the true figure is safe.
if [ -n "${BURNCD_SECONDS:-}" ]; then
  numeric BURNCD_SECONDS "$BURNCD_SECONDS"; CAPACITY=$BURNCD_SECONDS
elif [ -n "${BURNCD_MINUTES:-}" ]; then
  numeric BURNCD_MINUTES "$BURNCD_MINUTES"; CAPACITY=$(( BURNCD_MINUTES * 60 ))
else
  CAPACITY=4797
fi

DISC_BYTES=$(( CAPACITY * BYTES_PER_SEC ))

case "$LEVEL" in
  album|track|off) ;;
  *) die "--level must be album, track or off, got: $LEVEL" ;;
esac

# Signed decimals, so numeric() is the wrong check for these two.
for pair in "BURNCD_LUFS=$LUFS_TARGET" "BURNCD_PEAK=$PEAK_CEIL"; do
  case "${pair#*=}" in
    -[0-9]*|[0-9]*) ;;
    *) die "${pair%%=*} must be a number in dB, got: ${pair#*=}" ;;
  esac
done

# ---------------------------------------------------------------- arguments --

while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run)   DRY_RUN=1 ;;
    --demo)         DEMO=1 ;;
    --check)        CHECK=1 ;;
    --split-long)   SPLIT_LONG=1 ;;
    --no-cdtext)    CDTEXT=0 ;;
    --dummy)        DUMMY=1 ;;
    --verify)       VERIFY=1 ;;
    --level)        LEVEL=album ;;
    --level=*)      LEVEL="${1#--level=}" ;;
    --from-disc)    shift; FROM="${1:-}"
                    case "$FROM" in ''|*[!0-9]*|0) die "--from-disc needs a disc number" ;; esac ;;
    -h|--help)      usage 0 ;;
    -*)             die "unknown option: $1" ;;
    *)              [ -z "${DIR:-}" ] || die "only one directory at a time"; DIR="$1" ;;
  esac
  shift
done

# ------------------------------------------------------------- health check --

CHECK_FAIL=0
CHECK_WARN=0

ck() {   # ck <ok|warn|fail> <label> <detail>
  case "$1" in
    ok)   printf '  \033[32m✓\033[0m  %-20s %s\n' "$2" "$3" ;;
    warn) printf '  \033[33m!\033[0m  %-20s %s\n' "$2" "$3"; CHECK_WARN=1 ;;
    fail) printf '  \033[31m✗\033[0m  %-20s %s\n' "$2" "$3"; CHECK_FAIL=1 ;;
  esac
}

run_check() {
  local dstat mtype blank tmpdir avail need caps helptext

  printf '\n  \033[1mburncd health check\033[0m\n\n'

  # --- converters -----------------------------------------------------------
  if command -v ffmpeg >/dev/null; then
    ck ok "ffmpeg" "$(ffmpeg -version 2>/dev/null | head -1 | cut -d' ' -f1-3)"
  else
    ck fail "ffmpeg" "missing — brew install ffmpeg"
  fi
  if command -v ffprobe >/dev/null; then
    ck ok "ffprobe" "present"
  else
    ck fail "ffprobe" "missing — brew install ffmpeg"
  fi

  # Dither is not ffmpeg's default; confirm the filter accepts our request,
  # otherwise hi-res sources get truncated to 16-bit instead of dithered.
  if command -v ffmpeg >/dev/null; then
    if ffmpeg -hide_banner -h filter=aresample 2>/dev/null | qgrep dither_method; then
      ck ok "dither support" "triangular dither available"
    else
      ck warn "dither support" "no dither_method; 24-bit sources will truncate"
    fi

    # --level measures with ebur128 and applies the result with volume.
    if ffmpeg -hide_banner -filters 2>/dev/null | qgrep ' ebur128 '; then
      ck ok "loudness" "ebur128 present — --level can measure"
    else
      ck warn "loudness" "no ebur128 filter; --level unavailable"
    fi
  fi

  # --- burner ---------------------------------------------------------------
  if command -v cdrecord >/dev/null; then
    ck ok "cdrecord" "$(cdrecord -version 2>/dev/null | head -1 | cut -c1-40)"

    # CD-Text is written from a cue sheet, so this build needs both options.
    helptext=$(cdrecord -help 2>&1 || true)
    if printf '%s' "$helptext" | qgrep 'cuefile' \
       && printf '%s' "$helptext" | qgrep '\-text'; then
      ck ok "cue + CD-Text" "cdrecord supports cuefile= and -text"
    else
      ck warn "cue + CD-Text" "this build lacks cuefile=/-text; use --no-cdtext"
    fi
  else
    ck fail "cdrecord" "missing — brew install cdrtools"
  fi

  # Only --verify needs this, so its absence is not a failure.
  if command -v cdda2wav >/dev/null; then
    ck ok "cdda2wav" "present — --verify can read discs back"
  else
    ck warn "cdda2wav" "missing; --verify will check the TOC only"
  fi

  # --- drive ----------------------------------------------------------------
  if command -v cdrecord >/dev/null; then
    if cdrecord -checkdrive dev="$DEV" >/dev/null 2>&1; then
      ck ok "drive" "cdrecord can open dev=$DEV"

      # The drive itself has to be willing to write CD-Text. Most are; the
      # cheap bus-powered ones are worth confirming before you buy discs.
      caps=$(cdrecord -prcap dev="$DEV" 2>/dev/null || true)
      if printf '%s' "$caps" | qgrep -i 'CD-Text'; then
        ck ok "drive CD-Text" \
          "$(printf '%s' "$caps" | grep -i 'CD-Text' | head -1 | sed 's/^ *//' | cut -c1-46)"
      else
        ck warn "drive CD-Text" "drive does not advertise CD-Text; try one disc first"
      fi

      # --dummy rehearses a burn with the write laser off. Not every drive
      # can do it, and the ones that can't say so here rather than mid-burn.
      if printf '%s' "$caps" | qgrep -i 'test writing'; then
        ck ok "drive --dummy" "$(printf '%s' "$caps" | grep -i 'test writing' | head -1 | sed 's/^ *//' | cut -c1-46)"
      else
        ck warn "drive --dummy" "drive does not advertise test writing; --dummy may fail"
      fi
    else
      ck fail "drive" "cannot open dev=$DEV — see 'cdrecord -scanbus'"
    fi
  fi

  if command -v drutil >/dev/null; then
    dstat=$(drutil status 2>/dev/null || true)
    if [ -z "$dstat" ]; then
      ck warn "media" "no optical drive visible to drutil"
    elif printf '%s' "$dstat" | qgrep -i 'no media'; then
      ck warn "media" "drive found, no disc inserted"
    else
      mtype=$(printf '%s' "$dstat" | awk -F: '/Type:/ { gsub(/^ +/, "", $2); print $2; exit }')
      blank=$(printf '%s' "$dstat" | grep -ci 'blank' || true)
      if [ "$blank" -gt 0 ]; then
        ck ok "media" "blank ${mtype:-disc} ready"
      else
        ck warn "media" "${mtype:-disc} present but not blank"
      fi
    fi
  fi

  # --- scratch space --------------------------------------------------------
  tmpdir="${TMPDIR:-/tmp}"
  avail=$(free_bytes "$tmpdir" || echo 0)
  need=$(( DISC_BYTES + 104857600 ))     # one full disc of PCM plus headroom
  if [ "${avail:-0}" -ge "$need" ]; then
    ck ok "scratch space" "$(human "$avail") free in $tmpdir"
  else
    ck fail "scratch space" "need $(human "$need"), have $(human "${avail:-0}") in $tmpdir"
  fi

  # --- display --------------------------------------------------------------
  # The flag the rest of the file uses, not a second reading of the environment:
  # this has to report what the width code will actually do, including the case
  # where the preamble tried to fix the locale and the system had nothing to
  # fix it with.
  if [ "$UTF8" -eq 1 ]; then
    ck ok "terminal" \
      "UTF-8 locale (${LC_ALL:-${LC_CTYPE:-${LANG:-unset}}}), progress bar will render"
  else
    ck warn "terminal" "non-UTF-8 locale; bar characters may look wrong"
  fi

  printf '\n'
  if [ "$CHECK_FAIL" -eq 1 ]; then
    printf '  \033[31mNot ready to burn.\033[0m Fix the ✗ items above.\n\n'
    return 1
  elif [ "$CHECK_WARN" -eq 1 ]; then
    printf '  \033[33mMostly ready.\033[0m Warnings above are usually fine.\n\n'
  else
    printf '  \033[32mReady to burn.\033[0m\n\n'
  fi
  return 0
}

if [ "$CHECK" -eq 1 ]; then
  run_check || exit 1
  exit 0
fi

# ------------------------------------------------------------- requirements --

[ -n "${DIR:-}" ] || usage 1
[ -d "$DIR" ] || die "not a directory: $DIR"

command -v ffmpeg  >/dev/null || die "ffmpeg not found. brew install ffmpeg"
command -v ffprobe >/dev/null || die "ffprobe not found. brew install ffmpeg"
if [ "$DRY_RUN" -eq 0 ] && [ "$DEMO" -eq 0 ]; then
  command -v cdrecord >/dev/null || die "cdrecord not found. brew install cdrtools"
fi

# The screen opens here, before the first line of output, and does not close
# again until the job is over. Everything from reading the tags onwards happens
# inside it, so what is left in the scrollback afterwards is the command you
# typed and nothing else — no progress lines, no plan, no summary. That is the
# whole point of an application: it occupies the terminal while it runs and gives
# it back the way it found it.
#
# A dry run has nothing to steer, a pipe has no one driving it, and a window too
# small for the panel has nowhere to draw it; all three keep the plain output
# they always had. See TUI_MIN_LINES, and PANEL for the width, which does not
# reflow.
term_size
if [ "$DRY_RUN" -eq 0 ] && [ -t 0 ] && [ -t 1 ] \
   && [ "$TERM_LINES" -ge "$TUI_MIN_LINES" ] && [ "$TERM_COLS" -ge $(( PANEL + 2 )) ]; then
  screen_on || true
fi

# ------------------------------------------------------------ read metadata --

FILES=(); DURS=(); TITLES=(); ARTISTS=(); TRKNOS=(); DISCNOS=()
ALBUM=""; ALBUM_ARTIST=""; YEAR=""; UNTAGGED=0

printf 'Reading %s\n' "$DIR" >&2

while IFS= read -r f; do
  # One ffprobe call per file for duration and the tags we sort and label by.
  dur=""; trk=""; disc=""; title=""; album=""; artist=""; aartist=""; year=""
  while IFS='=' read -r key val; do
    case "$key" in
      duration)                         dur="$val" ;;
      TAG:track|TAG:tracknumber)        trk="$val" ;;
      TAG:disc|TAG:discnumber)          disc="$val" ;;
      TAG:title)                        title="$val" ;;
      TAG:album)                        album="$val" ;;
      TAG:artist)                       artist="$val" ;;
      TAG:album_artist|TAG:albumartist) aartist="$val" ;;
      TAG:date|TAG:year|TAG:originalyear) [ -z "$year" ] && year="$val" ;;
    esac
  done < <(ffprobe -v error -show_entries \
      'format=duration:format_tags=track,tracknumber,disc,discnumber,title,album,artist,album_artist,albumartist,date,year,originalyear' \
      -of default=nw=1 "$f" 2>/dev/null || true)

  [ -n "$dur" ] && [ "$dur" != "N/A" ] || die "cannot read audio from $(basename "$f")"

  # Tags are often "3/12" — keep the part before the slash. Missing track
  # numbers sort last, so tagged files keep their album order regardless.
  trk="${trk%%/*}";  case "$trk"  in ''|*[!0-9]*) trk=9999;  UNTAGGED=1 ;; esac
  disc="${disc%%/*}"; case "$disc" in ''|*[!0-9]*) disc=1 ;; esac

  FILES+=("$f")
  # Round up, never down: underestimating runtime is how a burn dies at 99%.
  DURS+=("$(awk -v d="$dur" 'BEGIN { printf "%d", (d == int(d) ? d : int(d) + 1) }')")
  TITLES+=("${title:-$(basename "$f")}")
  ARTISTS+=("$artist")
  TRKNOS+=("$trk")
  DISCNOS+=("$disc")
  [ -z "$ALBUM" ] && ALBUM="$album"
  [ -z "$ALBUM_ARTIST" ] && ALBUM_ARTIST="${aartist:-$artist}"
  # Dates are often full ISO stamps; the year is the only part anyone labels with.
  [ -z "$YEAR" ] && YEAR="${year%%-*}"
done < <(
  find "$DIR" -maxdepth 1 -type f \
    \( -iname '*.aif' -o -iname '*.aiff' -o -iname '*.flac' -o -iname '*.mp3' \
    -o -iname '*.ogg' -o -iname '*.opus' -o -iname '*.wav'  -o -iname '*.m4a' \
    -o -iname '*.wma' -o -iname '*.ape'  -o -iname '*.alac' \) | LC_ALL=C sort
)

[ ${#FILES[@]} -gt 0 ] || die "no audio files in $DIR"

# ------------------------------------------------------------------ ordering --

# Sort by disc, then track number, then filename. Files without track tags all
# share key 9999 and fall back to a natural filename sort among themselves.
ORDER=()
while IFS= read -r idx; do
  ORDER+=("$idx")
done < <(
  for i in $(seq 0 $(( ${#FILES[@]} - 1 ))); do
    printf '%04d\t%04d\t%s\t%d\n' \
      "${DISCNOS[$i]}" "${TRKNOS[$i]}" "$(basename "${FILES[$i]}")" "$i"
  done | LC_ALL=C sort -t"$(printf '\t')" -k1,1n -k2,2n -k3,3V | cut -f4
)

ORDER_ORIG=("${ORDER[@]}")

if [ "$UNTAGGED" -eq 1 ]; then
  ORDER_NOTE="filename (some files have no track number)"
else
  ORDER_NOTE="embedded track numbers"
fi

# ------------------------------------------------------------ loudness pass --

# Measuring means decoding everything an extra time, so results are cached by
# path+size+mtime. Re-burning the same album, or changing the order, is free.
LEVEL_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/burncd/levels.tsv"

hash_str() {
  if   command -v md5    >/dev/null 2>&1; then printf '%s' "$1" | md5 -q
  elif command -v md5sum >/dev/null 2>&1; then printf '%s' "$1" | md5sum | cut -d' ' -f1
  else printf '%s' "$1" | cksum | tr -d ' '
  fi
}

# EBU R128 integrated loudness and true peak, as "<LUFS><TAB><dBTP>".
# Digital silence reads as -inf, which is not a number anything downstream can
# use, so it is clamped to a value low enough to contribute no energy.
measure_file() {  # measure_file <path>
  ffmpeg -nostdin -nostats -i "$1" -map a:0 -af ebur128=peak=true -f null - 2>&1 \
    | awk '
        /^ *I: /    { lufs = $2 }
        /^ *Peak: / { peak = $2 }
        END {
          if (lufs !~ /^-?[0-9.]+$/) lufs = -70
          if (peak !~ /^-?[0-9.]+$/) peak = -70
          printf "%s\t%s\n", lufs, peak
        }'
}

LUFS_OF=(); PEAK_OF=(); TRACK_GAIN=()

measure_all() {
  local i f key hit line lufs peak n=0 total=${#FILES[@]} fresh=0

  # The cache is an optimisation, never a requirement. If the directory cannot
  # be created or written — read-only home, sandbox, odd permissions — measure
  # every time and say nothing about it.
  if mkdir -p "$(dirname "$LEVEL_CACHE")" 2>/dev/null &&
     { [ -f "$LEVEL_CACHE" ] || : > "$LEVEL_CACHE"; } 2>/dev/null; then
    :
  else
    LEVEL_CACHE=/dev/null
  fi

  for i in $(seq 0 $(( total - 1 ))); do
    f=${FILES[$i]}
    n=$(( n + 1 ))
    key=$(hash_str "$f:$(file_size "$f"):$(stat -f%m "$f" 2>/dev/null || stat -c%Y "$f")")

    hit=$(grep -m1 "^$key	" "$LEVEL_CACHE" 2>/dev/null || true)
    if [ -n "$hit" ]; then
      lufs=$(printf '%s' "$hit" | cut -f2); peak=$(printf '%s' "$hit" | cut -f3)
    else
      [ "$fresh" -eq 0 ] && printf '  Measuring loudness (first time for these files)\n' >&2
      fresh=1
      printf '\r\033[K    %d of %d — %.40s' "$n" "$total" "$(basename "$f")" >&2
      line=$(measure_file "$f")
      lufs=$(printf '%s' "$line" | cut -f1); peak=$(printf '%s' "$line" | cut -f2)
      printf '%s\t%s\t%s\n' "$key" "$lufs" "$peak" >> "$LEVEL_CACHE" 2>/dev/null || true
    fi

    LUFS_OF+=("$lufs"); PEAK_OF+=("$peak")
  done
  [ "$fresh" -eq 1 ] && printf '\r\033[K' >&2

  # Per-track gains are order-independent, so they are settled here once.
  # Unlike album mode this may attenuate: matching unrelated masters to each
  # other is the entire point, and that means bringing the loud ones down.
  for i in $(seq 0 $(( total - 1 ))); do
    TRACK_GAIN+=( "$(awk -v l="${LUFS_OF[$i]}" -v p="${PEAK_OF[$i]}" \
      -v t="$LUFS_TARGET" -v c="$PEAK_CEIL" 'BEGIN {
        gl = t - l; gh = c - p
        printf "%.1f", (gl < gh ? gl : gh)
      }')" )
  done
  return 0
}

# One gain for everything in the current playlist. Energy-weighted by duration,
# which is how album gain has always been computed — averaging the dB figures
# would let a short quiet intro drag the whole record up.
ALBUM_GAIN=0.0
ALBUM_BOUND=""
compute_album_gain() {
  local i out
  out=$(
    for i in $(seq 0 $(( N - 1 ))); do
      printf '%s\t%s\t%s\n' "${P_DUR[$i]}" "${LUFS_OF[${P_SRC[$i]}]}" "${PEAK_OF[${P_SRC[$i]}]}"
    done | awk -v t="$LUFS_TARGET" -v c="$PEAK_CEIL" '
        { e += $1 * (10 ^ ($2 / 10)); d += $1; if (NR == 1 || $3 > pk) pk = $3 }
        END {
          if (d == 0 || e <= 0) { print "0.0\t"; exit }
          lufs = 10 * log(e / d) / log(10)
          gl = t - lufs           # how far under the target the album sits
          gh = c - pk             # how much room is left before clipping
          g  = (gl < gh ? gl : gh)
          # Album mode only ever boosts. Turning a loud record down is not what
          # "this disc plays quiet" asks for, and cutting to hit a loudness
          # target would need a limiter, which would change the sound.
          if (g < 0) g = 0
          printf "%.1f\t%s\n", g, (gl < gh ? "loudness" : "peak")
        }'
  )
  ALBUM_GAIN=$(printf '%s' "$out" | cut -f1)
  ALBUM_BOUND=$(printf '%s' "$out" | cut -f2)
}

# The gain to apply to one playlist entry, as a bare dB number.
gain_for() {  # gain_for <playlist-index>
  case "$LEVEL" in
    album) printf '%s' "$ALBUM_GAIN" ;;
    track) printf '%s' "${TRACK_GAIN[${P_SRC[$1]}]}" ;;
    *)     printf '0.0' ;;
  esac
}

[ "$LEVEL" != off ] && measure_all

# ------------------------------------------------------- playlist expansion --

# Flatten into play order, cutting any track that cannot fit on one disc into
# equal parts. P_OFF/P_LEN are empty for whole files and set for slices, which
# is what tells the converter to seek. P_SRC points back at the source file, so
# a measured loudness can be found again after slicing and reordering.
# Everything downstream reads P_* only.
P_FILE=(); P_DUR=(); P_TITLE=(); P_ARTIST=(); P_OFF=(); P_LEN=(); P_SRC=()
SPLIT_NOTE=""

# Rebuilt from scratch on every call, because the edit screen changes ORDER and the
# whole layout has to be derived again from the new order.
build_playlist() {
  local k parts plen p off len
  P_FILE=(); P_DUR=(); P_TITLE=(); P_ARTIST=(); P_OFF=(); P_LEN=(); P_SRC=()
  SPLIT_NOTE=""

  for k in "${ORDER[@]}"; do
    if [ "${DURS[$k]}" -le "$CAPACITY" ]; then
      P_FILE+=("${FILES[$k]}"); P_DUR+=("${DURS[$k]}")
      P_TITLE+=("${TITLES[$k]}"); P_ARTIST+=("${ARTISTS[$k]}")
      P_OFF+=(""); P_LEN+=(""); P_SRC+=("$k")
      continue
    fi

    if [ "$SPLIT_LONG" -eq 0 ]; then
      die "\"${TITLES[$k]}\" is $(mmss "${DURS[$k]}"), longer than a $(mmss "$CAPACITY") disc.
  Pass --split-long to cut it into equal parts across discs."
    fi

    # Equal parts, so the tail is not a few-second stub.
    parts=$(( (DURS[k] + CAPACITY - 1) / CAPACITY ))
    plen=$(( (DURS[k] + parts - 1) / parts ))
    for p in $(seq 0 $(( parts - 1 ))); do
      off=$(( p * plen ))
      len=$plen
      [ $(( off + len )) -gt "${DURS[$k]}" ] && len=$(( DURS[k] - off ))
      P_FILE+=("${FILES[$k]}"); P_DUR+=("$len")
      P_TITLE+=("${TITLES[$k]} (part $(( p + 1 ))/$parts)")
      P_ARTIST+=("${ARTISTS[$k]}")
      P_OFF+=("$off"); P_LEN+=("$len"); P_SRC+=("$k")
    done
    SPLIT_NOTE="split $parts ways"
  done

  N=${#P_FILE[@]}
  [ "$N" -gt 0 ] || die "no tracks left to burn"
}

# -------------------------------------------------------------- disc layout --

# Greedy fill: how many discs does a given per-disc capacity need?
discs_needed() {
  local cap=$1 count=1 cur=0 ntrk=0 i d
  for i in $(seq 0 $(( N - 1 ))); do
    d=${P_DUR[$i]}
    [ "$d" -le "$cap" ] || { echo 0; return; }   # single track too long
    if [ $((cur + d)) -gt "$cap" ] || [ "$ntrk" -ge "$MAX_TRACKS" ]; then
      count=$((count + 1)); cur=$d; ntrk=1
    else
      cur=$((cur + d)); ntrk=$((ntrk + 1))
    fi
  done
  echo "$count"
}

TOTAL=0; NDISCS=1; DISC_OF=()

layout_discs() {
  local i LO HI MID R NEEDED cur ntrk disc

  TOTAL=0
  for i in $(seq 0 $(( N - 1 ))); do TOTAL=$(( TOTAL + P_DUR[i] )); done

  NEEDED=$(discs_needed "$CAPACITY")
  [ "$NEEDED" -gt 0 ] || die "a track is longer than a $(mmss "$CAPACITY") disc; pass --split-long"

  # Using the fewest discs, find the smallest capacity that still fits in that
  # many. This balances the discs instead of cramming disc 1 and leaving a stub.
  LO=0
  for i in $(seq 0 $(( N - 1 ))); do [ "${P_DUR[$i]}" -gt "$LO" ] && LO=${P_DUR[$i]}; done
  HI=$CAPACITY
  while [ "$LO" -lt "$HI" ]; do
    MID=$(( (LO + HI) / 2 ))
    R=$(discs_needed "$MID")
    if [ "$R" -gt 0 ] && [ "$R" -le "$NEEDED" ]; then HI=$MID; else LO=$((MID + 1)); fi
  done
  BALANCED=$LO

  # Assign tracks to discs at the balanced capacity, preserving album order.
  # Must use the same rule as discs_needed() or the plan and the layout diverge.
  DISC_OF=(); cur=0; ntrk=0; disc=1
  for i in $(seq 0 $(( N - 1 ))); do
    if [ $((cur + P_DUR[i])) -gt "$BALANCED" ] || [ "$ntrk" -ge "$MAX_TRACKS" ]; then
      disc=$((disc + 1)); cur=${P_DUR[$i]}; ntrk=1
    else
      cur=$((cur + P_DUR[i])); ntrk=$((ntrk + 1))
    fi
    DISC_OF+=("$disc")
  done
  NDISCS=$disc
}

# Everything after this point derives from ORDER, so a reorder is just a
# rebuild of these three.
replan() { build_playlist; layout_discs; [ "$LEVEL" = album ] && compute_album_gain; return 0; }
replan

# ----------------------------------------------------------------- the plan --

plan_header() {
  local why
  if [ -n "$ALBUM" ]; then
    if [ -n "$ALBUM_ARTIST" ]; then
      printf '  \033[1m%s\033[0m — %s' "$ALBUM" "$ALBUM_ARTIST"
    else
      printf '  \033[1m%s\033[0m' "$ALBUM"
    fi
    [ -n "$YEAR" ] && printf ' \033[2m(%s)\033[0m' "$YEAR"
    printf '\n'
  fi
  printf '  %d tracks, %s, ordered by %s\n' "$N" "$(mmss "$TOTAL")" "$ORDER_NOTE"
  if [ "$CDTEXT" -eq 1 ]; then
    printf '  CD-Text: on — disc and track names written to the lead-in\n'
  else
    printf '  CD-Text: off (--no-cdtext)\n'
  fi
  level_note
  [ -n "$SPLIT_NOTE" ] && printf '  A track was longer than one disc and was %s\n' "$SPLIT_NOTE"

  if [ "$NDISCS" -gt 1 ]; then
    # Say which limit was hit — runtime and the 99-track ceiling are very
    # different problems, and "too long" is wrong when the album is 9 minutes.
    if [ "$N" -gt "$MAX_TRACKS" ] && [ "$TOTAL" -gt "$CAPACITY" ]; then
      why="too long and over $MAX_TRACKS tracks"
    elif [ "$N" -gt "$MAX_TRACKS" ]; then
      why="over the $MAX_TRACKS track limit of a CD"
    else
      why="too long for one disc"
    fi
    printf '  Splitting across %d discs — %s\n' "$NDISCS" "$why"
  fi
  return 0
}

# What the loudness pass decided, and — just as important — why it stopped
# where it did, so a disc that stays quiet is explained rather than mysterious.
level_note() {
  case "$LEVEL" in
    off) return 0 ;;
    track)
      printf '  Level: each track matched to %s LUFS\n' "$LUFS_TARGET" ;;
    album)
      if [ "$ALBUM_GAIN" = "0.0" ]; then
        printf '  Level: already at CD loudness, no change\n'
      elif [ "$ALBUM_BOUND" = peak ]; then
        printf '  Level: +%s dB — all the headroom there is before clipping\n' "$ALBUM_GAIN"
      else
        printf '  Level: +%s dB to reach %s LUFS\n' "$ALBUM_GAIN" "$LUFS_TARGET"
      fi ;;
  esac
  return 0
}

# The capacity meter: one band per track, sized by its share of a whole disc,
# with the unused tail left unlit. Makes "disc 2 is only two-thirds full" obvious
# at a glance, which is the moment to reorder the folder rather than after
# burning it.
#
# Everything about it is in service of one comparison — is this track longer than
# that one — so it is drawn at eighth-cell resolution: each column is eight units,
# and a boundary landing mid-column is drawn as a partial block of the outgoing
# band over the incoming one. That is eight times what the bar could otherwise
# resolve without taking a single extra column, which matters because a half-full
# disc of eleven tracks only has a few cells to give each one.
#
# The plan's meter and the burn screen's progress bar are the same instrument at
# two moments, so they are the same two functions: bands() decides the widths and
# bandbar() draws them. They were a copy of each other for a while and promptly
# drifted — the burn bar quietly stopped drawing partial blocks, which threw away
# every eighth bands() had just worked out and let a 3:00 track and a 3:18 track
# come out the same width. One copy, so that cannot happen again.

# Widths by largest remainder, not by walking a cumulative total. Truncating each
# running total independently made a longer track look narrower than a shorter
# one — a 3:14 rounded down while the 2:58 after it landed on a boundary and got
# more — which is exactly the comparison the meter exists to support. Here every
# track gets floor(its share) and the leftover units go to the largest fractions,
# so the total is still exact and a longer track can never be drawn narrower than
# a shorter one.
BEND=(); BCOL=()
bands() {  # bands <total-units> <duration>...  -> $BEND, $BCOL
  local units=$1 n=0 cum=0 used=0 left=0 best bi i pos=0 nb=0
  local -a D HC REM
  BEND=(); BCOL=(); D=(); HC=(); REM=()
  shift

  for i in "$@"; do
    D[$n]=$i
    cum=$(( cum + i ))
    n=$(( n + 1 ))
  done
  [ "$n" -gt 0 ] && [ "$cum" -gt 0 ] && [ "$units" -gt 0 ] || return 0

  i=0
  while [ "$i" -lt "$n" ]; do
    HC[$i]=$(( D[i] * units / cum ))
    REM[$i]=$(( D[i] * units % cum ))
    used=$(( used + HC[i] ))
    i=$(( i + 1 ))
  done
  left=$(( units - used ))
  while [ "$left" -gt 0 ]; do
    best=-1; bi=-1
    i=0
    while [ "$i" -lt "$n" ]; do
      [ "${REM[$i]}" -gt "$best" ] && { best=${REM[$i]}; bi=$i; }
      i=$(( i + 1 ))
    done
    [ "$bi" -lt 0 ] && break
    HC[$bi]=$(( HC[bi] + 1 ))
    REM[$bi]=-1          # spent, and -1 keeps it out of later rounds
    left=$(( left - 1 ))
  done

  # Where each band ends, in units, and what colour it is. A track too short to
  # earn a single unit ends up with no band at all and does not consume a colour,
  # so the two tracks either side of it still contrast.
  i=0
  while [ "$i" -lt "$n" ]; do
    if [ "${HC[$i]}" -gt 0 ]; then
      pos=$(( pos + HC[i] ))
      BEND[$nb]=$pos
      BCOL[$nb]=${SHADES[$(( nb % 4 ))]}
      nb=$(( nb + 1 ))
    fi
    i=$(( i + 1 ))
  done
  return 0
}

# One row of meter, in $BANDBAR. A column wholly inside a band is a shaded block,
# a column a boundary runs through is a partial block of the outgoing colour laid
# over the incoming one as background, and anything past the last band is run-out.
#
# The head argument is where the write laser has got to, in the same units. The
# plan's meter has no laser and passes the full width, so nothing is ever behind
# the head there; the burn screen passes the real position and gets the same bar
# with an unwritten tail and a bright edge creeping along it. In a column the head
# is actually inside, the head wins over any band boundary sharing that column —
# it is the one thing on the bar that is moving, and it is gone again in a second.
#
# Not returned on stdout: a $( ) here is a fork, and the burn screen redraws this
# on every message from the drive.
BANDBAR=''
bandbar() {  # bandbar <head-units>  -- reads $BEND/$BCOL -> $BANDBAR
  local head=$1 j=0 b=0 nb=${#BEND[@]} cs ce t nxt
  local out='' curfg='' curbg=''
  # Unicode has a full set of left-aligned partial blocks, and a cell can show
  # two colours — foreground for the left part, background for the right — so a
  # boundary can be drawn where it actually falls rather than snapped to the
  # nearest whole character. At one unit per column a 3:14 and a 2:58 are the
  # same two cells; at eight it is about nine seconds to the unit.
  local PARTS=('' '▏' '▎' '▍' '▌' '▋' '▊' '▉')

  while [ "$j" -lt "$STRIP_WIDTH" ]; do
    cs=$(( j * 8 )); ce=$(( cs + 8 ))
    while [ "$b" -lt "$nb" ] && [ "${BEND[$b]}" -le "$cs" ]; do b=$(( b + 1 )); done
    if [ "$head" -gt "$cs" ] && [ "$head" -lt "$ce" ]; then
      strip_sgr "$HEAD" ''; out="${out}${PARTS[$(( head - cs ))]}"
    elif [ "$head" -le "$cs" ] || [ "$b" -ge "$nb" ]; then
      # Not yet written, or past the last band: the run-out, dithered in the
      # darkest amber on the ramp rather than left blank, so it still reads as
      # part of the meter.
      strip_sgr "$RUNOUT" ''; out="${out}░"
    elif [ "${BEND[$b]}" -ge "$ce" ]; then
      # Shade rather than solid, for the phosphor-and-oxide texture the rest of
      # the panel has. The same shade the whole way across a band, though — an
      # earlier version varied the density within a band and the speckle read as
      # gaps, which broke the one thing the bar is for. Uniform grain costs
      # nothing: a shaded cell is exactly as wide as a solid one.
      strip_sgr "${BCOL[$b]}" ''; out="${out}▓"
    else
      t=$(( BEND[b] - cs ))
      nxt=$(( b + 1 ))
      if [ "$nxt" -lt "$nb" ]; then
        strip_sgr "${BCOL[$b]}" "${BCOL[$nxt]}"
      else
        strip_sgr "${BCOL[$b]}" ''      # last band meeting the run-out
      fi
      out="${out}${PARTS[$t]}"
    fi
    j=$(( j + 1 ))
  done
  BANDBAR="$out\033[0m"
  return 0
}

strip() {  # strip <disc-number> [panel-label]
  local d=$1 lbl="${2:-}" i n=0 cum=0 units filled
  local scale="" col=0 m p tot step want
  local -a DUR
  DUR=()

  i=0
  while [ "$i" -lt "$N" ]; do
    if [ "${DISC_OF[$i]}" -eq "$d" ]; then
      DUR[$n]=${P_DUR[$i]}
      cum=$(( cum + P_DUR[i] ))
      n=$(( n + 1 ))
    fi
    i=$(( i + 1 ))
  done

  units=$(( STRIP_WIDTH * 8 ))
  filled=$(( cum * units / CAPACITY ))
  [ "$filled" -gt "$units" ] && filled=$units

  # The tracks share only as much of the bar as the disc is full; the rest is
  # run-out. Nothing here is unwritten, so the head goes past the right-hand end.
  if [ "$n" -gt 0 ]; then bands "$filled" "${DUR[@]}"; else bands 0; fi
  bandbar "$units"

  # Label on the left, readout on the right, meter across the full grid below
  # them. The readout used to sit beside the bar and cost it eighteen columns,
  # which is eighteen columns of resolution the comparison needed more.
  mmssv "$cum"; tot=$MMSS
  mmssv "$CAPACITY"
  printf -v want '%s / %s' "$tot" "$MMSS"
  pad $(( PANEL - ${#lbl} - ${#want} ))
  printf '  %b%s%b%s%b%s%b %b/ %s%b\n' \
    "$ETCH" "$lbl" "$OFF" "$PAD" "$AMBER" "$tot" "$OFF" "$DIM" "$MMSS" "$OFF"
  printf '  %b▐%b%b%b▌%b\n' "$ETCH" "$OFF" "$BANDBAR" "$ETCH" "$OFF"

  # A minute scale under it, so the meter answers "how far in does this disc
  # end?" and not only "how full is it?". Positions are derived from CAPACITY
  # rather than hard-coded, so changing BURNCD_MINUTES moves the ticks with it.
  #
  # The spacing follows the capacity: every 20 minutes across a Red Book disc,
  # closer together on the short ones BURNCD_MINUTES can ask for. Ticks past the
  # end are dropped rather than clamped — pinning 20, 40, 60 and 80 to the right
  # edge of a twelve-minute disc printed "20406080" and meant nothing. A minute
  # of slack keeps the last tick on a disc whose capacity just misses it, which
  # is every CD: 80 minutes is 79:57.
  step=20
  [ "$CAPACITY" -le 2700 ] && step=10
  [ "$CAPACITY" -le 1200 ] && step=5
  m=0
  while [ $(( m * 60 )) -le $(( CAPACITY + 60 )) ]; do
    p=$(( m * 60 * STRIP_WIDTH / CAPACITY ))
    [ $(( p + ${#m} )) -gt "$STRIP_WIDTH" ] && p=$(( STRIP_WIDTH - ${#m} ))
    if [ "$p" -ge "$col" ]; then
      pad $(( p - col ))
      scale="$scale$PAD$m"
      col=$(( p + ${#m} ))
    fi
    m=$(( m + step ))
  done
  printf '   %b%s%b\n' "$DIM" "$scale" "$OFF"
}

# One meter cell's colour, appended to $out only when it differs from what is
# already in effect — a fresh pair of escapes per cell would treble the size of
# the frame for nothing.
strip_sgr() {  # strip_sgr <fg> <bg-or-empty>
  [ "$1" = "$curfg" ] || { out="$out\033[38;5;$1m"; curfg=$1; }
  if [ -n "$2" ]; then
    [ "$2" = "$curbg" ] || { out="$out\033[48;5;$2m"; curbg=$2; }
  elif [ -n "$curbg" ]; then
    out="$out\033[49m"; curbg=''
  fi
}

# ---------------------------------------------------------------- edit screen --

# A small full-screen editor for the things you only notice are wrong once you
# see them laid out: the order, the names, and whether a disc is half empty.
#
# It edits ORDER and the source-level TITLES/ARTISTS rather than the flattened
# playlist, so a track that had to be split across discs stays one row and one
# name. replan() re-derives the split after every change, which is what makes
# the disc boundaries move under the cursor as you reorder.

tui_block()  { stty -echo -icanon min 1 time 0 2>/dev/null || true; }
tui_cooked() { stty echo icanon 2>/dev/null || true; }

# Every read here blocks. bash 3.2 has no sub-second read timeout, and the
# obvious alternative — flipping the terminal between blocking and polling
# around each keystroke — is worse than useless: stty flushes input that has
# already arrived, so a fast escape sequence loses bytes and arrow keys go
# missing. Staying in one mode means the three bytes of an arrow key are
# always read together. The cost is that a bare ESC waits for another key,
# which is why ESC is not bound to anything.
KEY=""
read_key() {
  local k c
  KEY=""
  IFS= read -rsn1 k 2>/dev/null || return 1
  # read discards its delimiter, so Return comes back as an empty string
  # rather than as a newline. Reading exactly one byte makes that unambiguous.
  [ -z "$k" ] && { KEY=$'\n'; return 0; }
  if [ "$k" = $'\033' ]; then
    IFS= read -rsn1 c 2>/dev/null || c=""
    k="$k$c"
    # CSI and SS3 sequences run until the first letter or tilde.
    if [ "$c" = "[" ] || [ "$c" = "O" ]; then
      while :; do
        IFS= read -rsn1 c 2>/dev/null || break
        [ -z "$c" ] && break
        k="$k$c"
        case "$c" in [A-Za-z~]) break ;; esac
      done
    fi
  fi
  KEY="$k"
  return 0
}

# Ask for one value on the bottom line. Cooked mode, so backspace and paste
# behave the way they do everywhere else. Empty input keeps what was there.
#
# The prompt is drawn on the terminal directly rather than on stdout: callers
# capture this function's stdout to get the new value, and anything printed
# there would end up inside the value.
tui_prompt() {  # tui_prompt <label> <current>
  local reply
  tui_cooked
  printf '\033[?25h\r\033[K  %b▶%b %b%-7s%b %b[%s]%b ' \
    "$AMBER" "$OFF" "$ETCH" "$1" "$OFF" "$DIM" "${2:-empty}" "$OFF" > /dev/tty
  IFS= read -r reply || reply=""
  printf '\033[?25l' > /dev/tty
  tui_block
  [ -n "$reply" ] && printf '%s' "$reply" || printf '%s' "$2"
}

# How many columns one character takes. Characters are not all one column wide:
# a CJK ideograph, a kana, a Hangul syllable, a fullwidth form or an emoji is
# drawn two columns wide, so ${#s} — which counts characters — is half the truth
# for a Japanese title, and the grid built on it comes out with the artist column
# a dozen places to the right and the whole panel bent out of shape.
#
# Testing by glob range rather than by code point because there is no code point
# to test: bash 3.2 is what ships with macOS, and printf '%d' "'字" there gives
# the first byte of the character as a signed char, not its code point. Range
# patterns over multibyte characters do work, so that is the mechanism.
CW=1
cwidth() {  # cwidth <character> -> $CW
  case "$1" in
    [⺀-〿]|[぀-ヿ]|[一-鿿]|[가-힣]|[！-｠]|[🀀-🿿]) CW=2 ;;
    *) CW=1 ;;
  esac
}

# Columns a whole string takes. The common case in this program is a Latin title
# with no wide character in it anywhere, and for that ${#s} is already the answer
# — so ask that question of the whole string once, and only walk it character by
# character if the answer is yes. Same ranges as cwidth, written as a substring
# test; they have to stay in step.
WCOLS=0
wcols() {  # wcols <string> -> $WCOLS
  local s=$1 i=0 n=0
  case "$s" in
    *[⺀-〿]*|*[぀-ヿ]*|*[一-鿿]*|*[가-힣]*|*[！-｠]*|*[🀀-🿿]*) ;;
    *) WCOLS=${#s}; return 0 ;;
  esac
  while [ "$i" -lt "${#s}" ]; do
    cwidth "${s:$i:1}"
    n=$(( n + CW ))
    i=$(( i + 1 ))
  done
  WCOLS=$n
  return 0
}

# Pad or truncate to an exact column count. Not printf's own width and precision:
# those are counted in bytes even under a UTF-8 locale, so "Björk — Homogénic"
# cut to 34 loses 34 bytes rather than 34 columns and the artist column after it
# slides left. Substring expansion counts characters, which is closer but still
# not columns; wcols is. A cut title ends in … so the truncation is visible.
fit() {  # fit <string> <columns>
  fitv "$1" "$2"
  printf '%s' "$FIT"
}
fitv() {  # fitv <string> <columns> -> $FIT
  local s=$1 i=0 w=0 keep='' lim
  wcols "$s"
  if [ "$WCOLS" -gt "$2" ]; then
    # Cut by columns, taking whole characters: a two-column character that would
    # straddle the last place is left out rather than half-drawn, which leaves a
    # column over for pad to fill.
    lim=$(( $2 - 1 ))
    while [ "$i" -lt "${#s}" ]; do
      cwidth "${s:$i:1}"
      [ $(( w + CW )) -gt "$lim" ] && break
      keep="$keep${s:$i:1}"
      w=$(( w + CW ))
      i=$(( i + 1 ))
    done
    # Braces are not optional: bash 3.2 reads "$keep…" as one name and hands back
    # the tail of the ellipsis's own bytes.
    s="${keep}…"
    WCOLS=$(( w + 1 ))
  fi
  pad $(( $2 - WCOLS ))
  FIT="$s$PAD"
}

# One row of backlit keycaps, given as key/label pairs. Assembled in a string
# rather than one substitution per cap so the legend costs nothing to draw and
# still reads here as keys and labels instead of as escape codes.
keys() {  # keys <key> <label> [<key> <label> ...]
  local line='' sep=''
  while [ "$#" -gt 1 ]; do
    line="$line$sep$CAP $1 $OFF $2"
    sep='   '
    shift 2
  done
  printf '  %b\n' "$line"
}

# One track, in the three columns that the editor and the disc prompt both lay
# out. They are showing the same list on purpose — the prompt is where the
# editor's work gets checked, and a listing you cannot compare at a glance is
# not a check — so the widths live here and the two screens move together.
#
# Cells rather than a finished line, because the editor's selected row wraps the
# same four cells in a single reverse-video bar and an inner colour reset would
# punch a hole in the highlight partway along.
ROW_NUM=''; ROW_TTL=''; ROW_ART=''; ROW_TM=''
track_cells() {  # track_cells <n> <title> <artist> <seconds>
  printf -v ROW_NUM '%02d' "$1"
  fitv "$2" 34; ROW_TTL=$FIT
  fitv "$3" 20; ROW_ART=$FIT
  mmssv "$4"; printf -v ROW_TM '%5s' "$MMSS"
  return 0
}

track_row() {  # track_row <n> <title> <artist> <seconds>
  track_cells "$1" "$2" "$3" "$4"
  printf '    %b%s%b  %s  %b%s%b  %b%s%b\n' \
    "$ETCH" "$ROW_NUM" "$OFF" "$ROW_TTL" "$DIM" "$ROW_ART" "$OFF" "$ETCH" "$ROW_TM" "$OFF"
  return 0
}

# What is below the fold, worded the same way wherever a list gets clamped.
more_row() {  # more_row <count>
  printf '    %b▾ %d MORE%b\n' "$ETCH" "$1" "$OFF"
  return 0
}

TUI_ROWS=0

# Everything the panel says, printed to stdout so tui_draw can capture the whole
# frame and hand it to the terminal in one piece. Split out for that reason only.
tui_frame() {  # tui_frame <cursor> <top> <visible-rows> <status>
  local cur=$1 top=$2 vis=$3 status=$4 i k row d lastd=0 meta
  local body ts='' ds='' last=$(( top + vis ))

  # DISC_AT is built by tui_fit_rows before this runs — it has to be, since the
  # row budget depends on where the disc rules fall.

  [ "${#ORDER[@]}" -eq 1 ] || ts=S
  [ "$NDISCS" -eq 1 ]      || ds=S
  mmssv "$TOTAL"
  printf -v meta '%d TRACK%s · %s · %d DISC%s' \
    "${#ORDER[@]}" "$ts" "$MMSS" "$NDISCS" "$ds"
  faceplate "$meta"
  printf '\n'

  # The three disc-level fields, selectable as cursor rows 0, 1 and 2. They sit
  # on the same mark-plus-body grid as the tracks, so the selection bar is the
  # same width wherever the cursor is.
  tui_field() {  # tui_field <slot> <label> <value>
    local b
    if [ "$cur" -eq "$1" ]; then
      printf -v b '%-7s %s' "$2" "${3:-—}"
      fitv "$b" 67
      printf '  %b▶%b %b%s%b\n' "$AMBER" "$OFF" "$INV" "$FIT" "$OFF"
    else
      printf '    %b%-7s%b %s\n' "$ETCH" "$2" "$OFF" "${3:-—}"
    fi
  }
  tui_field 0 ALBUM  "$ALBUM"
  tui_field 1 ARTIST "$ALBUM_ARTIST"
  tui_field 2 YEAR   "$YEAR"
  printf '\n'

  k=$top
  while [ "$k" -lt "$last" ]; do
    [ "$k" -lt "${#ORDER[@]}" ] || break
    row=$(( k + 3 ))
    i=${ORDER[$k]}
    d=${DISC_AT[$i]:-1}
    if [ "$d" != "$lastd" ]; then
      repv '━' $(( PANEL - 9 - ${#d} ))
      printf '  %b━━ DISC %s %s%b\n' "$ETCH" "$d" "$REP" "$OFF"
      lastd=$d
    fi
    if [ "$cur" -eq "$row" ]; then
      track_cells $(( k + 1 )) "${TITLES[$i]}" "${ARTISTS[$i]}" "${DURS[$i]}"
      printf -v body '%s  %s  %s  %s' "$ROW_NUM" "$ROW_TTL" "$ROW_ART" "$ROW_TM"
      printf '  %b▶%b %b%s%b\n' "$AMBER" "$OFF" "$INV" "$body" "$OFF"
    else
      track_row $(( k + 1 )) "${TITLES[$i]}" "${ARTISTS[$i]}" "${DURS[$i]}"
    fi
    k=$(( k + 1 ))
  done

  [ $(( top + vis )) -lt "${#ORDER[@]}" ] && more_row $(( ${#ORDER[@]} - top - vis ))

  printf '\n'
  # The meter for whichever disc the cursor is sitting on, so the effect of a
  # reorder on disc fullness is visible while you are doing it. On the header
  # fields there is no track to follow, so it falls back to disc 1 rather than
  # going blank — a gauge that disappears is worse than one that idles.
  d=1
  [ "$cur" -ge 3 ] && d=${DISC_AT[${ORDER[$(( cur - 3 ))]}]:-1}
  strip "$d" "DISC $d"

  printf '\n'
  keys '↑↓' SELECT '⇧↑↓' MOVE '⏎' RENAME A ARTIST X DROP
  keys U UNDO R RESET B BURN Q QUIT
  [ -n "$status" ] && printf '\n  %b%s%b\n' "$AMBER" "$status" "$OFF"
  return 0
}

# How many track rows fit, given the window and what else the frame has to say.
#
# It matters more than it looks. tui_draw deliberately does not erase the screen,
# and \033[H is absolute, so a frame one line taller than the window scrolls the
# terminal and the panel's top row is gone — not overdrawn, gone, permanently,
# because the next frame homes to a row that now holds something else. The badge
# and the ALBUM/ARTIST/YEAR fields simply vanish and never come back. A fixed
# TERM_LINES-16 was one row short in the ordinary case (eleven tracks, one disc,
# a status message) and several short with the disc rules a multi-disc job draws.
#
# So the rows are counted rather than assumed. Everything except the track list
# is fixed: the badge and its blank line, three fields, a blank, the blank before
# the meter, the meter's three lines, a blank, and two keycap rows — thirteen. A
# status message adds a blank and itself. What is not fixed is the disc rules,
# one per disc boundary inside the visible window, and the "▾ n MORE" line, which
# only appears if the list is cut short — which depends on how many rows fit. So
# tui_walk is run once, and if that turns out to leave a remainder, again with a
# row given back for the MORE line.
#
# The +1 in TUI_CHROME is the cursor: a frame of N newlines drawn from row 1 puts
# the cursor on row 1+N, so N has to stay one under the window or the last
# newline scrolls the very thing this is protecting. TUI_MIN_LINES is that
# chrome, plus the two a status message costs, plus the three the shortest
# possible list still needs: a disc rule, one track, and the "▾ n MORE" line.
# Both are set at the top of the file, where PANEL is.
tui_fit_rows() {  # tui_fit_rows <top> <status> -> $TUI_ROWS
  local budget
  term_size
  budget=$(( TERM_LINES - TUI_CHROME ))
  [ -n "$2" ] && budget=$(( budget - 2 ))
  tui_disc_map
  tui_walk "$1" "$budget"
  [ $(( $1 + TUI_ROWS )) -lt "${#ORDER[@]}" ] && tui_walk "$1" $(( budget - 1 ))
  # A row is spent whether or not there was one to spend: showing no tracks at
  # all is not a panel. It only bites in a window too short for the editor, which
  # tui_edit turns away at the door — see TUI_MIN_LINES.
  [ "$TUI_ROWS" -lt 1 ] && TUI_ROWS=1
  return 0
}

# Walks the list the way tui_frame prints it, spending a row on each disc rule as
# it crosses one, and stops when the budget runs out.
tui_walk() {  # tui_walk <top> <rows> -> $TUI_ROWS
  local k=$1 left=$2 lastd=0 d
  TUI_ROWS=0
  while [ "$k" -lt "${#ORDER[@]}" ]; do
    d=${DISC_AT[${ORDER[$k]}]:-1}
    [ "$d" = "$lastd" ] || { left=$(( left - 1 )); lastd=$d; }
    [ "$left" -ge 1 ] || break
    left=$(( left - 1 ))
    TUI_ROWS=$(( TUI_ROWS + 1 ))
    k=$(( k + 1 ))
  done
  return 0
}

tui_draw() {  # tui_draw <cursor> <top> <status>
  local frame
  tui_fit_rows "$2" "$3"
  # Built in memory and handed to paint() in one piece; see paint() for why.
  frame=$(tui_frame "$1" "$2" "$TUI_ROWS" "$3")
  paint "$frame"
  return 0
}

# Which disc each source track lands on, keyed by source index: the disc of its
# first playlist entry. Built once per frame rather than rescanned per row —
# looking it up per track made drawing quadratic in the track count, which a
# hundred-track folder can feel even without a fork in the loop.
DISC_AT=()
tui_disc_map() {
  local i
  DISC_AT=()
  i=0
  while [ "$i" -lt "$N" ]; do
    [ -n "${DISC_AT[${P_SRC[$i]}]:-}" ] || DISC_AT[${P_SRC[$i]}]=${DISC_OF[$i]}
    i=$(( i + 1 ))
  done
}

DROPPED=()
tui_edit() {
  local cur=3 top=0 status="" n k tmp

  # The screen is already ours by the time this runs — the editor is the first
  # stage of the display, not the owner of it. Guarded here as well because
  # returning is kinder than dying if that ever changes: the static plan still
  # says everything that matters.
  [ "$SCREEN" -eq 1 ] || return 0

  tui_block

  while :; do
    n=${#ORDER[@]}
    [ "$cur" -lt 3 ] || [ "$cur" -lt $(( n + 3 )) ] || cur=$(( n + 2 ))
    [ "$cur" -ge 0 ] || cur=0
    # Keep the cursor inside the viewport. How many rows fit depends on where the
    # window starts — a disc rule scrolling into view costs one — so scrolling
    # down means measuring again, not once. It settles: each pass moves top up
    # towards the cursor, and at top = k a single row is enough.
    if [ "$cur" -ge 3 ]; then
      k=$(( cur - 3 ))
      [ "$k" -lt "$top" ] && top=$k
      [ "$top" -lt 0 ] && top=0
      tui_fit_rows "$top" "$status"
      while [ "$k" -ge $(( top + TUI_ROWS )) ]; do
        top=$(( k - TUI_ROWS + 1 ))
        tui_fit_rows "$top" "$status"
      done
    fi
    [ "$top" -lt 0 ] && top=0

    tui_draw "$cur" "$top" "$status"
    status=""
    read_key || break

    case "$KEY" in
      $'\033[A'|k)      cur=$(( cur - 1 )) ;;
      $'\033[B'|j)      cur=$(( cur + 1 )) ;;
      $'\033[1;2A'|K)   tui_move "$cur" -1 && cur=$(( cur - 1 )) ;;
      $'\033[1;2B'|J)   tui_move "$cur"  1 && cur=$(( cur + 1 )) ;;
      $'\033[5~')       cur=$(( cur - TUI_ROWS )) ;;
      $'\033[6~')       cur=$(( cur + TUI_ROWS )) ;;
      $'\n'|$'\r')      tui_rename "$cur" ;;
      a|A)              tui_artist "$cur" ;;
      x|d)              tui_drop "$cur" && status="▪ TRACK DROPPED — PRESS U TO UNDO" ;;
      u|U)              tui_undo && status="▪ TRACK RESTORED" ;;
      r|R)              ORDER=("${ORDER_ORIG[@]}"); DROPPED=(); replan
                        status="▪ ORIGINAL ORDER RESTORED" ;;
      b|B|$' ')         break ;;
      q|Q)              die "cancelled" ;;
    esac
  done

  # Cooked again, but still on the alternate screen: the next stage is the disc
  # prompt, and it takes over the same frame the editor was drawing on.
  tui_cooked
  return 0
}

# Swap a track with its neighbour. Returns nonzero when the move is impossible,
# so the caller knows not to move the cursor with it.
tui_move() {  # tui_move <cursor> <delta>
  local cur=$1 delta=$2 k j tmp
  [ "$cur" -ge 3 ] || return 1
  k=$(( cur - 3 )); j=$(( k + delta ))
  [ "$j" -ge 0 ] && [ "$j" -lt "${#ORDER[@]}" ] || return 1
  tmp=${ORDER[$k]}; ORDER[$k]=${ORDER[$j]}; ORDER[$j]=$tmp
  replan
  return 0
}

tui_rename() {  # tui_rename <cursor>
  local cur=$1 i
  case "$cur" in
    0) ALBUM=$(tui_prompt "ALBUM" "$ALBUM") ;;
    1) ALBUM_ARTIST=$(tui_prompt "ARTIST" "$ALBUM_ARTIST") ;;
    2) YEAR=$(tui_prompt "YEAR" "$YEAR") ;;
    *) i=${ORDER[$(( cur - 3 ))]}
       TITLES[$i]=$(tui_prompt "TITLE" "${TITLES[$i]}")
       replan ;;
  esac
  return 0
}

tui_artist() {  # tui_artist <cursor>
  local cur=$1 i
  if [ "$cur" -lt 3 ]; then
    ALBUM_ARTIST=$(tui_prompt "ARTIST" "$ALBUM_ARTIST")
  else
    i=${ORDER[$(( cur - 3 ))]}
    ARTISTS[$i]=$(tui_prompt "ARTIST" "${ARTISTS[$i]}")
    replan
  fi
  return 0
}

# Dropping keeps the removed entry and its position, so undo puts it back
# where it was rather than on the end.
tui_drop() {  # tui_drop <cursor>
  local cur=$1 k j
  local -a rest; rest=()
  [ "$cur" -ge 3 ] || return 1
  [ "${#ORDER[@]}" -gt 1 ] || return 1
  k=$(( cur - 3 ))
  DROPPED+=("$k:${ORDER[$k]}")
  for j in $(seq 0 $(( ${#ORDER[@]} - 1 ))); do
    [ "$j" -eq "$k" ] || rest+=("${ORDER[$j]}")
  done
  ORDER=("${rest[@]}")
  replan
  return 0
}

tui_undo() {
  local last k i j placed=0
  local -a out; out=()
  [ "${#DROPPED[@]}" -gt 0 ] || return 1
  last=${DROPPED[$(( ${#DROPPED[@]} - 1 ))]}
  k=${last%%:*}; i=${last#*:}
  for j in $(seq 0 $(( ${#ORDER[@]} - 1 ))); do
    [ "$j" -eq "$k" ] && { out+=("$i"); placed=1; }
    out+=("${ORDER[$j]}")
  done
  [ "$placed" -eq 1 ] || out+=("$i")
  ORDER=("${out[@]}")
  unset "DROPPED[$(( ${#DROPPED[@]} - 1 ))]"
  DROPPED=(${DROPPED[@]+"${DROPPED[@]}"})
  replan
  return 0
}

show_plan() {
  local d dtot num i
  printf '\n'
  plan_header
  printf '\n'
  for d in $(seq 1 "$NDISCS"); do
    dtot=0; num=0
    [ "$NDISCS" -gt 1 ] && printf '  \033[1mDisc %d\033[0m\n' "$d"
    for i in $(seq 0 $(( N - 1 ))); do
      [ "${DISC_OF[$i]}" -eq "$d" ] || continue
      num=$((num + 1)); dtot=$((dtot + P_DUR[i]))
      printf '   %2d. %s %6s\n' "$num" "$(fit "${P_TITLE[$i]}" 52)" "$(mmss "${P_DUR[$i]}")"
    done
    printf '       %*s %6s\n' 52 "" "$(mmss "$dtot")"
    strip "$d" "DISC $d"
    printf '\n'
  done
  return 0
}

# The preview IS the editor. A wrong title or a bad order is noticed and fixed
# on the same screen it was spotted on, so there is no flag to predict in
# advance. Whether there is a screen to draw on was settled before the tags were
# read; tui_edit returns straight away if there isn't.
tui_edit

# Printed only when there is no panel to print it on. A screened run has the plan
# on the display instead, and leaves nothing behind when it closes.
[ "$SCREEN" -eq 1 ] || show_plan

[ "$DRY_RUN" -eq 1 ] && exit 0

# ----------------------------------------------------------------- stages --

# Everything between the editor and the summary is a stage of the same display:
# a faceplate, the album being worked on, a body the stage supplies, and the log
# of what has happened so far. Each one replaces the last from the home position,
# so waiting for a disc, converting it, writing it and reporting on it are four
# states of one instrument rather than four messages stacked up the terminal.
#
# The stage is remembered rather than just drawn, because a note arriving later —
# a disc finished, a verify result — has to redraw the frame it belongs to
# instead of printing on top of it.
STAGE_META='' STAGE_BODY='' STAGE_FOOT=''
LOG=()

stage() {  # stage <meta> <body> [foot]
  STAGE_META=$1
  STAGE_BODY=$2
  STAGE_FOOT=${3:-}
  stage_paint
  return 0
}

stage_paint() {
  local frame
  [ "$SCREEN" -eq 1 ] && [ -n "$STAGE_META" ] || return 0
  frame=$(stage_frame)
  paint "$frame"
  return 0
}

# One frame's worth of stage, on stdout for paint() to lay down in a piece. What
# is going on sits at the top, what has happened under it, and what to press last
# of all, so the eye ends the frame on the thing it has to answer.
#
# The log is trimmed to whatever is left of the window, oldest lines first: a
# frame taller than the window would scroll the panel's own top row away for good.
stage_frame() {
  local nls used=3 room i n
  faceplate "$STAGE_META"
  printf '\n'
  printf '    %b%-8s%b %s\n' "$ETCH" ALBUM "$OFF" "${ALBUM:-—}"
  # No blank line here: the body opens with one if it wants one, and the insert
  # stage does not — its ARTIST and YEAR belong to the same block of fields.
  if [ -n "$STAGE_BODY" ]; then
    printf '%s\n' "$STAGE_BODY"
    nls=${STAGE_BODY//[!$'\n']/}
    used=$(( used + ${#nls} + 1 ))
  fi
  if [ -n "$STAGE_FOOT" ]; then
    nls=${STAGE_FOOT//[!$'\n']/}
    used=$(( used + ${#nls} + 2 ))
  fi

  n=${#LOG[@]}
  term_size
  # One row for the blank before the log, and one for the row the cursor has to
  # land on after the frame's last newline.
  room=$(( TERM_LINES - 2 - used ))
  if [ "$n" -gt 0 ] && [ "$room" -gt 0 ]; then
    printf '\n'
    i=0
    [ "$n" -gt "$room" ] && i=$(( n - room ))
    while [ "$i" -lt "$n" ]; do
      printf '  %b\n' "${LOG[$i]}"
      i=$(( i + 1 ))
    done
  fi

  [ -n "$STAGE_FOOT" ] && printf '\n%s\n' "$STAGE_FOOT"
  return 0
}

# What used to be a bare printf into the scroll. On a screened run it joins the
# log and the current stage is redrawn around it; everywhere else it is the line
# it always was.
note() {  # note <line>
  LOG+=("$1")
  if [ "$SCREEN" -eq 1 ]; then
    stage_paint
  else
    printf '  %b\n' "$1"
  fi
  return 0
}

# Block for one key without disturbing the frame. Cooked mode is no good here:
# the prompt is part of the picture, not a line at the bottom of a scrolling
# terminal, so the terminal goes raw for exactly as long as it takes to read one
# key. Returns nonzero if stdin is gone, which callers treat differently — a
# closed stdin partway through a multi-disc job is a failure, at the end of one
# it is just the end.
wait_key() {  # wait_key -> $KEY
  local rc=0
  tui_block
  read_key || rc=1
  tui_cooked
  return "$rc"
}

# Waiting for a blank disc — and the last look at what is about to be permanent.
# It shows the same fields and the same track rows the editor showed, for this
# disc, because this is the moment the edits stop being reversible: the next key
# starts writing them into a lead-in. Reading the listing off a summary two
# screens back is not checking it.
#
# The tracks come from IDX, which the burn loop has already gathered for this
# disc by the time this runs.
#
# ROOM: everything that is not a track row — the faceplate and its blank, the
# three fields, the blank under them, the blank and three lines of meter, the
# blank and two rows at the foot, and the row the cursor lands on. Whatever is
# left is the listing, less one row for "▾ n MORE" if the list is cut, and less
# whatever the log needs — up to four rows of it, since a disc prompt with the
# last disc's result hidden is the one place the log has something to say.
stage_insert() {  # stage_insert <disc-number>
  local d=$1 body foot prompt rows reserve=0 n k i
  n=${#IDX[@]}
  term_size
  [ "${#LOG[@]}" -gt 0 ] && reserve=$(( ${#LOG[@]} + 1 ))
  [ "$reserve" -gt 4 ] && reserve=4
  rows=$(( TERM_LINES - 14 - reserve ))
  [ "$n" -gt "$rows" ] && rows=$(( rows - 1 ))
  [ "$rows" -lt 1 ] && rows=1

  body=$(
    printf '    %b%-8s%b %s\n' "$ETCH" ARTIST "$OFF" "${ALBUM_ARTIST:-—}"
    printf '    %b%-8s%b %s\n' "$ETCH" YEAR   "$OFF" "${YEAR:-—}"
    printf '\n'
    k=0
    while [ "$k" -lt "$n" ] && [ "$k" -lt "$rows" ]; do
      i=${IDX[$k]}
      track_row $(( k + 1 )) "${P_TITLE[$i]}" "${P_ARTIST[$i]}" "${P_DUR[$i]}"
      k=$(( k + 1 ))
    done
    if [ "$k" -lt "$n" ]; then
      more_row $(( n - k ))
    fi
    printf '\n'
    strip "$d" "DISC $d"
  )

  if [ "$NDISCS" -gt 1 ]; then
    printf -v prompt '  %bINSERT%b a blank CD-R for disc %d of %d' \
      "$AMBER" "$OFF" "$d" "$NDISCS"
  else
    printf -v prompt '  %bINSERT%b a blank CD-R' "$AMBER" "$OFF"
  fi

  # Going back is only offered on the first disc of the job, and only when the
  # job started there. Once a disc is written the plan it came from is a fact
  # about a physical object, and re-cutting the running order underneath it would
  # renumber discs that are already in a sleeve.
  if [ "$d" -eq 1 ] && [ "$FROM" -eq 1 ]; then
    foot=$(keys '⏎' BURN E EDIT Q CANCEL)
  else
    foot=$(keys '⏎' BURN Q CANCEL)
  fi
  stage "INSERT · DISC $d OF $NDISCS" "$body" "$prompt
$foot"
  return 0
}

# Converting. The bar is the same bar the burn draws — same bands, same head —
# because from the outside these are one process with two halves, and watching
# the head cross the disc twice is a truer picture of the wait than a spinner.
stage_convert() {  # stage_convert <disc> <track-no> <of> <title> <head-units>
  local body
  bandbar "$5"
  fitv "$4" 46
  body=$(
    printf '\n'
    printf '    %b%-8s%b %02d OF %02d  %s\n' "$ETCH" TRACK "$OFF" "$2" "$3" "$FIT"
    printf '\n'
    printf '  %b▐%b%b%b▌%b\n' "$ETCH" "$OFF" "$BANDBAR" "$ETCH" "$OFF"
  )
  stage "CONVERTING · DISC $1 OF $NDISCS · $(( $5 * 100 / (STRIP_WIDTH * 8) ))%" "$body"
  return 0
}

# The job, finished, waiting to be dismissed. Every disc gets its meter if the
# window has room for them; a seventeen-disc job in a short window shows what
# fits and says how many it did not.
stage_done() {  # stage_done <meta>
  local body max
  term_size
  # Three chrome rows and the blank the body opens with, the blank and keycap row
  # at the foot, two kept back for the log, and the row the cursor lands on; each
  # disc costs three meter rows and a blank.
  max=$(( (TERM_LINES - 9) / 4 ))
  [ "$max" -lt 1 ] && max=1
  body=$(
    printf '\n'
    d=$FROM; shown=0
    while [ "$d" -le "$NDISCS" ] && [ "$shown" -lt "$max" ]; do
      strip "$d" "DISC $d"
      printf '\n'
      shown=$(( shown + 1 )); d=$(( d + 1 ))
    done
    if [ "$d" -le "$NDISCS" ]; then
      more_row $(( NDISCS - d + 1 ))
    fi
  )
  stage "$1" "$body" "$(keys Q QUIT)"
  return 0
}

# ------------------------------------------------------------- burn screen --

# The burn screen is the edit panel with the laser on: the same badge, the same
# 69-column grid, the same amber. What used to be here was a disc filling in from
# the hub — a second, unrelated machine bolted to the side of this one, drawn in
# cyan and white, telling you nothing the numbers underneath it did not already
# say. Now the screen is one instrument all the way down.
#
# The progress bar is the plan's capacity meter again, and that is the whole
# idea: the bands are the tracks, in the same alternating ambers, so the plan you
# approved and the disc being written out of it are visibly the same picture at
# two different moments. The part not yet written is the same run-out the meter
# uses for the empty end of a disc.
# It is literally the same instrument: bands() over this disc's durations, then
# bandbar() with the write head where the drive says it is. Both of those live
# with the plan's meter, above.

# A lamp sweeping a dark field, under the bar where the plan puts its minute
# scale. It exists because a burn is twenty minutes of a number that moves once
# every few seconds, and a panel with nothing moving on it looks like a panel
# that has died. This one moves on every message from the drive, so a stall in
# the write is a stall on the screen — which is exactly the thing you want to be
# able to see from across the room.
#
# Left in $SCANBAR rather than printed, for the same reason as bandbar: this is
# redrawn on every message from the drive and a $( ) around it is a fork per frame.
SCANBAR=''
burn_scan() {  # burn_scan <frame> -> $SCANBAR
  local f=$1 span p dir j dd out='' curfg='' curbg=''
  span=$(( (STRIP_WIDTH - 1) * 2 ))
  p=$(( f % span ))
  if [ "$p" -ge "$STRIP_WIDTH" ]; then p=$(( span - p )); dir=-1; else dir=1; fi
  j=0
  while [ "$j" -lt "$STRIP_WIDTH" ]; do
    # Distance behind the lamp, measured against the way it is travelling: the
    # trail falls off the way it came and the leading edge stays sharp, so the
    # direction is never ambiguous. Getting the sign the wrong way round puts the
    # fade out in front, and the whole thing reads as moving backwards.
    dd=$(( (p - j) * dir ))
    case $dd in
      0) strip_sgr "$HEAD" ''; out="${out}█" ;;
      1) strip_sgr 220 '';     out="${out}▓" ;;
      2) strip_sgr 214 '';     out="${out}▒" ;;
      3) strip_sgr 172 '';     out="${out}▒" ;;
      4) strip_sgr 130 '';     out="${out}░" ;;
      5) strip_sgr "$RUNOUT" ''; out="${out}░" ;;
      *) strip_sgr 236 '';     out="${out}·" ;;
    esac
    j=$(( j + 1 ))
  done
  SCANBAR="$out\033[0m"
  return 0
}

# Parses cdrecord's progress output and redraws the display in place.
# cdrecord emits carriage-return-delimited lines like:
#   Track 03:  12 of  45 MB written (fifo 100%) [buf  98%]  8.0x.
render() {  # render <disc-no> <of> <ntracks> <total-mb>
  local disc_no=$1 disc_of=$2 ntracks=$3 total_mb=$4
  local chunk trk mb_done buf spd title verb meta head frame=0
  local base_mb=0 last_trk=1 done_mb=0 pct=0 eta="--:--" plain_trk=0
  local elapsed el i tty=0 cols lines wide=0 bar filled home='' tail=''
  local -a bdur

  [ -t 1 ] && tty=1
  # The panel is 71 columns and does not reflow; below that, a compact readout
  # rather than a grid folded in half.
  term_size; cols=$TERM_COLS
  if [ "$tty" -eq 1 ] && [ "$cols" -ge $(( PANEL + 2 )) ]; then
    wide=1; lines=10
    # The bands are fixed for the whole disc; only the head moves, so this is
    # worked out once here rather than per frame. The bar is the tracks end to
    # end — unlike the plan's meter there is no empty tail to leave unlit, since
    # the burn is over when the last track is written.
    bdur=(); i=0
    while [ "$i" -lt "${#IDX[@]}" ]; do
      bdur[$i]=${P_DUR[${IDX[$i]}]}
      i=$(( i + 1 ))
    done
    if [ "${#bdur[@]}" -gt 0 ]; then
      bands $(( STRIP_WIDTH * 8 )) "${bdur[@]}"
    else
      bands 0
    fi
  else
    wide=0; lines=4
  fi

  verb=WRITING
  [ "${DUMMY:-0}" -eq 1 ] && verb=REHEARSING

  # Where a frame starts and how it ends. On the alternate screen this panel is
  # the whole display, so each frame is laid over the last from the home position
  # the way every other stage is, and \033[J takes the tail of a taller
  # predecessor with it. Without the screen — a burn logged to a file, or a
  # terminal too small for the editor — the panel is the bottom of a scrolling
  # terminal instead, so it opens itself a hole and redraws relatively into it.
  if [ "$SCREEN" -eq 1 ]; then
    home='\033[H'; tail='\033[J'
  else
    printf -v home '\033[%dA\r' "$lines"
  fi

  SECONDS=0                                  # a builtin, so elapsed costs no fork
  if [ "$tty" -eq 1 ]; then
    printf '\033[?25l'                       # hide cursor
    if [ "$SCREEN" -eq 0 ]; then
      for (( i = 0; i < lines; i++ )); do printf '\n'; done
    fi
  fi

  while IFS= read -r -d $'\r' chunk || [ -n "$chunk" ]; do
    [[ "$chunk" =~ Track[[:space:]]+0*([0-9]+):[[:space:]]+([0-9]+)[[:space:]]+of[[:space:]]+([0-9]+)[[:space:]]+MB ]] || continue
    trk="${BASH_REMATCH[1]}"; mb_done="${BASH_REMATCH[2]}"

    # cdrecord counts MB per track; accumulate finished tracks for a disc total.
    if [ "$trk" -ne "$last_trk" ]; then
      base_mb=$done_mb; last_trk=$trk
    fi
    done_mb=$((base_mb + mb_done))

    buf="--"; spd="--"
    [[ "$chunk" =~ buf[[:space:]]+([0-9]+)% ]] && buf="${BASH_REMATCH[1]}"
    [[ "$chunk" =~ ([0-9]+\.[0-9]+)x ]]       && spd="${BASH_REMATCH[1]}"

    [ "$total_mb" -gt 0 ] && pct=$(( done_mb * 100 / total_mb ))
    [ "$pct" -gt 100 ] && pct=100

    # No forks in the redraw path: $SECONDS is a builtin and mmssv leaves its
    # answer in a variable. This loop runs on every message from the drive, and a
    # date(1) plus two command substitutions per frame is most of a burn's CPU.
    elapsed=$SECONDS
    if [ "$pct" -ge 3 ] && [ "$elapsed" -gt 0 ]; then
      mmssv $(( elapsed * (100 - pct) / pct )); eta=$MMSS
    fi
    mmssv "$elapsed"; el=$MMSS

    if [ "$tty" -eq 0 ]; then
      # Piped or logged: one line per track instead of redraw escapes.
      [ "$trk" -ne "$plain_trk" ] && {
        printf '  disc %d/%d track %d/%d\n' "$disc_no" "$disc_of" "$trk" "$ntracks"
        plain_trk=$trk
      }
      continue
    fi

    frame=$(( frame + 1 ))
    printf '%b' "$home"

    if [ "$wide" -eq 0 ]; then
      filled=$(( pct * BAR_WIDTH / 100 ))
      bar=''
      for (( i = 0; i < BAR_WIDTH; i++ )); do
        if [ "$i" -lt "$filled" ]; then bar="${bar}▓"; else bar="${bar}░"; fi
      done
      printf '\033[K  %b%s DISC %d OF %d%b\n' "$AMBER" "$verb" "$disc_no" "$disc_of" "$OFF"
      printf '\033[K  %b▐%b%b%s%b%b▌%b %b%3d%%%b\n' \
        "$ETCH" "$OFF" "$AMBER" "$bar" "$OFF" "$ETCH" "$OFF" "$AMBER" "$pct" "$OFF"
      printf '\033[K  %bTRACK%b %d/%d  %bDATA%b %d/%d MB  %b%sx%b\n' \
        "$ETCH" "$OFF" "$trk" "$ntracks" "$ETCH" "$OFF" "$done_mb" "$total_mb" \
        "$ETCH" "$spd" "$OFF"
      printf '\033[K  %bBUFFER%b %s%%  %bELAPSED%b %s  %bLEFT%b %s\n%b' \
        "$ETCH" "$OFF" "$buf" "$ETCH" "$OFF" "$el" "$ETCH" "$OFF" "$eta" "$tail"
      continue
    fi

    # Header, laid out exactly like every other stage's, and the album under it
    # for the same reason: the thing on screen while a disc is being written
    # should be recognisably the thing that was on screen while it was planned.
    #
    # %3d, not %d: the rule is sized from what is left after the meta, so a
    # percentage that grows a digit would shorten the rule by one and the whole
    # header would twitch sideways twice a burn.
    printf -v meta '%s · DISC %d OF %d · %3d%%' "$verb" "$disc_no" "$disc_of" "$pct"
    printf '\033[K'; faceplate "$meta"
    printf '\033[K\n'
    printf '\033[K    %b%-8s%b %s\n' "$ETCH" ALBUM "$OFF" "${ALBUM:-—}"
    printf '\033[K\n'

    title='—'
    [ "$trk" -ge 1 ] && [ "$trk" -le "${#IDX[@]}" ] && title=${P_TITLE[${IDX[$(( trk - 1 ))]}]}
    fitv "$title" 46
    printf '\033[K    %b%-8s%b %02d OF %02d  %s\n' \
      "$ETCH" TRACK "$OFF" "$trk" "$ntracks" "$FIT"
    printf '\033[K    %b%-8s%b %d OF %d MB AT %sx\n' \
      "$ETCH" WRITTEN "$OFF" "$done_mb" "$total_mb" "$spd"
    printf '\033[K    %b%-8s%b %s%%   %bELAPSED%b %s   %bREMAINING%b %s\n\033[K\n' \
      "$ETCH" BUFFER "$OFF" "$buf" "$ETCH" "$OFF" "$el" \
      "$ETCH" "$OFF" "$eta"

    head=$(( total_mb > 0 ? done_mb * STRIP_WIDTH * 8 / total_mb : 0 ))
    [ "$head" -gt $(( STRIP_WIDTH * 8 )) ] && head=$(( STRIP_WIDTH * 8 ))
    bandbar "$head"; burn_scan "$frame"
    printf '\033[K  %b▐%b%b%b▌%b\n' "$ETCH" "$OFF" "$BANDBAR" "$ETCH" "$OFF"
    printf '\033[K  %b▐%b%b%b▌%b\n%b' "$ETCH" "$OFF" "$SCANBAR" "$ETCH" "$OFF" "$tail"
  done

  # Hand the cursor back only to a terminal that is about to get its prompt. On
  # the alternate screen the next stage is drawn over this one and a cursor
  # parked in the middle of it is just a blinking artefact; screen_off puts it
  # back when the job is over.
  [ "$tty" -eq 1 ] && [ "$SCREEN" -eq 0 ] && printf '\033[?25h'
  return 0
}

# Stands in for cdrecord under --demo so the display can be previewed dry.
# Sizes itself like a real disc rather than from the sample files.
fake_cdrecord() {
  local ntracks=$1 mb_per=$2 t mb
  for ((t = 1; t <= ntracks; t++)); do
    for ((mb = 0; mb <= mb_per; mb += 2)); do
      printf 'Track %02d: %4d of %4d MB written (fifo 100%%) [buf  97%%]  8.0x.\r' \
        "$t" "$mb" "$mb_per"
      sleep 0.03
    done
    printf 'Track %02d: %4d of %4d MB written (fifo 100%%) [buf  97%%]  8.0x.\r' \
      "$t" "$mb_per" "$mb_per"
  done
  printf '\n'
}

# -------------------------------------------------------------- image + cue --

# Little-endian 32-bit integer as printf escapes, for the WAV header fields.
le32() {
  local v=$1
  printf '\\x%02x\\x%02x\\x%02x\\x%02x' \
    $(( v & 255 )) $(( (v >> 8) & 255 )) $(( (v >> 16) & 255 )) $(( (v >> 24) & 255 ))
}

# A canonical 44-byte PCM WAV header. The two size fields are patched in
# afterwards, once the real data length is known, so the image can be written
# in a single streaming pass instead of being assembled twice.
wav_header() {
  printf 'RIFF'
  printf "$(le32 0)"
  printf 'WAVEfmt '
  printf "$(le32 16)"
  printf '\x01\x00\x02\x00'                        # PCM, 2 channels
  printf "$(le32 44100)"
  printf "$(le32 "$BYTES_PER_SEC")"
  printf '\x04\x00\x10\x00'                        # block align 4, 16 bits
  printf 'data'
  printf "$(le32 0)"
}

# Patch a little-endian 32-bit value into an existing file at a byte offset.
patch_le32() {  # file offset value
  printf "$(le32 "$3")" \
    | dd of="$1" bs=1 seek="$2" conv=notrunc status=none 2>/dev/null
}

# CD-Text fields are plain text in the lead-in. Quotes and control characters
# break the cue parser, and very long strings overflow the packs.
cue_text() {
  printf '%s' "$1" | LC_ALL=C tr -d '\000-\037\177"\\' | cut -c1-120
}

# --------------------------------------------------------------- verifying --

# Reads the finished disc back and reports whether it is sound.
#
# Deliberately NOT a byte-for-byte comparison against the image. Every drive
# reads audio at a small fixed sample offset from where it wrote it, so an
# exact compare fails on a perfectly good disc — which is the same false alarm
# this flag exists to settle. What it checks instead is what actually goes
# wrong: the table of contents, whether every sector can be read back, and
# whether the CD-Text survived.
verify_disc() {  # verify_disc <disc-number> <expected-track-count>
  local d=$1 want=$2 toc got rc bad=0 msg ln

  note "$(printf '%bVERIFYING%b disc %d...' "$AMBER" "$OFF" "$d")"

  toc=$(cdrecord -toc dev="$DEV" 2>&1 || true)
  got=$(printf '%s\n' "$toc" | grep -c '^track:[[:space:]]*[0-9]' || true)
  if [ "$got" -eq "$want" ]; then
    note "$(printf '  %b✓%b table of contents — %d tracks' "$AMBER" "$OFF" "$got")"
  else
    note "$(printf '  \033[31m✗\033[0m table of contents — expected %d tracks, disc reports %d' \
      "$want" "$got")"
    bad=1
  fi

  if command -v cdda2wav >/dev/null; then
    # Stream every track to nowhere. We do not want the audio; we want to know
    # whether the drive can get through the disc without a read error, which is
    # exactly what a player has to do.
    set +e
    cdda2wav dev="$DEV" -q -t "1+$want" -output-format raw - \
      > /dev/null 2> "$WORK/verify-$d.log"
    rc=$?
    set -e
    if [ "$rc" -eq 0 ]; then
      note "$(printf '  %b✓%b full read — every sector came back' "$AMBER" "$OFF")"
    else
      note "$(printf '  \033[31m✗\033[0m full read failed (exit %d):' "$rc")"
      # A line at a time, so the drive's complaint joins the log rather than
      # printing straight through whatever stage is on screen.
      while IFS= read -r ln; do note "      $ln"; done < <(tail -6 "$WORK/verify-$d.log")
      bad=1
    fi

    if [ "$CDTEXT" -eq 1 ] && [ -n "$ALBUM" ]; then
      # Best effort: -J asks for information only. If the field does not come
      # back that is not proof it is missing, so this never fails the disc.
      if cdda2wav dev="$DEV" -J -v titles 2>&1 | qgrep -F "$ALBUM"; then
        note "$(printf '  %b✓%b CD-Text — album title reads back' "$AMBER" "$OFF")"
      else
        note "$(printf '  \033[33m!\033[0m CD-Text — could not read it back; check on a player')"
      fi
    fi
  else
    note "$(printf '  \033[33m!\033[0m cdda2wav not installed — TOC checked, sectors not read')"
  fi

  return "$bad"
}

# ---------------------------------------------------------------- burn loop --

WORK=$(mktemp -d "${TMPDIR:-/tmp}/burncd.XXXXXX")
STARTED=$(date +%s)

# The screen comes off first, whatever happened: a job that ends on the alternate
# screen and does not step off it leaves the terminal in raw mode with no cursor.
# The show-cursor escape is for the unscreened path, and only to a real terminal,
# so piped output and log files stay clean.
cleanup() { screen_off; rm -rf "$WORK"; [ -t 1 ] && printf '\033[?25h'; return 0; }
trap cleanup EXIT
trap 'int_nl; cleanup; exit 130' INT

if [ "$DUMMY" -eq 1 ]; then
  note "$(printf '%bTEST BURN%b — the laser stays off and nothing is written.' "$AMBER" "$OFF")"
  note 'The disc is not ejected, so you can burn it for real straight after.'
fi

if [ "$FROM" -gt 1 ]; then
  [ "$FROM" -le "$NDISCS" ] || die "--from-disc $FROM but this job is only $NDISCS discs"
  note "$(printf 'Resuming at disc %d of %d, skipping %d already burned.' \
    "$FROM" "$NDISCS" "$((FROM - 1))")"
fi

# Wrapped in a restart, because the disc prompt can send you back to the editor.
# An edit re-cuts the discs — a dropped track can change how many there are — so
# the job cannot simply resume where it left off; the seq below was expanded from
# the old layout. Going back is only offered before the first disc is written, so
# there is never anything to undo when this runs a second time.
REEDIT=1
while [ "$REEDIT" -eq 1 ]; do
REEDIT=0
for d in $(seq "$FROM" "$NDISCS"); do
  # Gather this disc's tracks in play order.
  IDX=()
  for i in $(seq 0 $(( N - 1 ))); do
    [ "${DISC_OF[$i]}" -eq "$d" ] && IDX+=("$i")
  done

  # Uncompressed audio is roughly 10 MB per minute; a full disc is ~800 MB.
  # Check before spending minutes converting into a filesystem that cannot
  # hold the result.
  need=0
  for i in "${IDX[@]}"; do need=$(( need + P_DUR[i] * BYTES_PER_SEC )); done
  need=$(( need + 10485760 ))
  avail=$(free_bytes "$WORK" || echo 0)
  if [ "${avail:-0}" -lt "$need" ]; then
    die "disc $d needs $(human "$need") of temp space, only $(human "${avail:-0}") free
  in ${TMPDIR:-/tmp}. Free some space or set TMPDIR to a bigger volume."
  fi

  # Wait for a blank disc. On the panel that is a stage of its own, showing this
  # disc exactly as it will be written and offering the way back to the editor;
  # without it, the prompt it always was.
  if [ "$SCREEN" -eq 1 ]; then
    stage_insert "$d"
    while :; do
      # Without this guard, a closed stdin makes the loop exit silently partway
      # through a multi-disc job, which looks exactly like a successful finish.
      wait_key || die "stdin closed — burncd needs a terminal to confirm each disc"
      case "$KEY" in
        q|Q)          die "cancelled" ;;
        e|E)          if [ "$d" -eq 1 ] && [ "$FROM" -eq 1 ]; then REEDIT=1; break; fi ;;
        $'\n'|$' ')   break ;;
      esac
    done
    if [ "$REEDIT" -eq 1 ]; then
      tui_edit
      break
    fi
  else
    if [ "$NDISCS" -gt 1 ]; then
      printf '  %bINSERT%b a blank CD-R for disc %d of %d, then press %b ⏎ %b %b(Ctrl-C to stop)%b ' \
        "$AMBER" "$OFF" "$d" "$NDISCS" "$CAP" "$OFF" "$DIM" "$OFF"
    else
      printf '  %bINSERT%b a blank CD-R and press %b ⏎ %b %b(Ctrl-C to stop)%b ' \
        "$AMBER" "$OFF" "$CAP" "$OFF" "$DIM" "$OFF"
    fi
    read -r _ || die "stdin closed — burncd needs a terminal to confirm each disc"
  fi

  IMAGE="$WORK/disc$d.wav"
  CUE="$WORK/disc$d.cue"
  FFLOG="$WORK/ffmpeg-$d.log"
  : > "$FFLOG"

  # The bands the conversion and the burn both draw against: this disc's tracks
  # end to end across the full bar. Worked out once here, then bandbar() moves a
  # head along them twice — once while the image is built, once while it is
  # written — so the two halves of the wait are the same picture.
  DSECS=0; CSECS=0
  BDUR=()
  n=0
  for i in "${IDX[@]}"; do
    BDUR[$n]=${P_DUR[$i]}
    DSECS=$(( DSECS + P_DUR[i] ))
    n=$(( n + 1 ))
  done
  if [ "$n" -gt 0 ]; then bands $(( STRIP_WIDTH * 8 )) "${BDUR[@]}"; else bands 0; fi

  [ "$SCREEN" -eq 1 ] || printf '  %bCONVERTING%b to 16-bit/44.1kHz...\n' "$ETCH" "$OFF"

  # One continuous image rather than a file per track. Two reasons: cdrecord
  # only writes CD-Text from a cue sheet, and a cue sheet must point at a
  # single file; and a single image is genuinely gapless, because track
  # boundaries become index marks in one stream rather than separate writes.
  wav_header > "$IMAGE"
  HDR=44
  STARTS=(); n=0

  for i in "${IDX[@]}"; do
    n=$((n + 1))
    if [ "$SCREEN" -eq 1 ]; then
      stage_convert "$d" "$n" "${#IDX[@]}" "${P_TITLE[$i]}" \
        $(( DSECS > 0 ? CSECS * STRIP_WIDTH * 8 / DSECS : 0 ))
    fi
    CSECS=$(( CSECS + P_DUR[i] ))
    # Track boundaries must land on sector boundaries, so record where this
    # track begins before appending it.
    STARTS+=( $(( ($(file_size "$IMAGE") - HDR) / SECTOR )) )

    # ffmpeg does NOT dither by default (dither_method=0), so a 24-bit source
    # would be truncated to 16-bit. Triangular dither is the safe default.
    # Raw s16le out, appended straight onto the image.
    #
    # Any level change goes in ahead of the dither and in floating point, so
    # the gain is applied once, at full precision, and quantisation happens
    # exactly once at the end. It is a plain gain — no compression, no
    # limiting — which is why it can only go as loud as the headroom allows.
    g=$(gain_for "$i")
    if [ "$g" = "0.0" ]; then
      FILTER='aresample=out_sample_fmt=s16:dither_method=triangular'
    else
      FILTER="aformat=sample_fmts=fltp,volume=${g}dB,aresample=out_sample_fmt=s16:dither_method=triangular"
    fi

    # stderr to a log rather than to the terminal: on the alternate screen a
    # stray ffmpeg warning would print through the middle of the panel and be
    # gone with the next frame. If the conversion fails, the log is what the
    # error message is made of — and by then the screen is off.
    ok=1
    if [ -n "${P_OFF[$i]}" ]; then
      ffmpeg -nostdin -v error -ss "${P_OFF[$i]}" -i "${P_FILE[$i]}" \
        -t "${P_LEN[$i]}" -map a:0 -af "$FILTER" \
        -ar 44100 -ac 2 -c:a pcm_s16le -f s16le - 2>> "$FFLOG" >> "$IMAGE" || ok=0
    else
      ffmpeg -nostdin -v error -i "${P_FILE[$i]}" -map a:0 -af "$FILTER" \
        -ar 44100 -ac 2 -c:a pcm_s16le -f s16le - 2>> "$FFLOG" >> "$IMAGE" || ok=0
    fi
    [ "$ok" -eq 1 ] || die "ffmpeg failed on ${P_FILE[$i]}
$(tail -8 "$FFLOG" | sed 's/^/    /')"

    # Pad out to a whole sector so the next track starts aligned. Same job
    # cdrecord's -pad used to do, moved here where the offsets are computed.
    rem=$(( ($(file_size "$IMAGE") - HDR) % SECTOR ))
    if [ "$rem" -ne 0 ]; then
      dd if=/dev/zero bs=1 count=$(( SECTOR - rem )) status=none >> "$IMAGE" 2>/dev/null
    fi
  done

  DATA=$(( $(file_size "$IMAGE") - HDR ))
  patch_le32 "$IMAGE" 4  $(( DATA + 36 ))
  patch_le32 "$IMAGE" 40 "$DATA"

  # --- cue sheet ------------------------------------------------------------
  {
    # CD-Text has no year field, so the date can only be a cue comment. Some
    # rippers and players read REM DATE; a CD player's display never will.
    [ -n "$YEAR" ] && printf 'REM DATE %s\n' "$(cue_text "$YEAR")"
    if [ "$CDTEXT" -eq 1 ]; then
      [ -n "$ALBUM_ARTIST" ] && printf 'PERFORMER "%s"\n' "$(cue_text "$ALBUM_ARTIST")"
      [ -n "$ALBUM" ]        && printf 'TITLE "%s"\n'     "$(cue_text "$ALBUM")"
    fi
    printf 'FILE "%s" WAVE\n' "$(basename "$IMAGE")"
    n=0
    for i in "${IDX[@]}"; do
      n=$((n + 1))
      printf '  TRACK %02d AUDIO\n' "$n"
      if [ "$CDTEXT" -eq 1 ]; then
        printf '    TITLE "%s"\n' "$(cue_text "${P_TITLE[$i]}")"
        [ -n "${P_ARTIST[$i]}" ] && printf '    PERFORMER "%s"\n' "$(cue_text "${P_ARTIST[$i]}")"
      fi
      printf '    INDEX 01 %s\n' "$(msf "${STARTS[$((n - 1))]}")"
    done
  } > "$CUE"

  # CD-Text lives in the lead-in, which is small. If the metadata is enormous
  # the drive rejects the whole burn, so shed per-track artists first.
  if [ "$CDTEXT" -eq 1 ] && [ "$(file_size "$CUE")" -gt "$CDTEXT_BUDGET" ]; then
    note "$(printf '\033[33m!\033[0m CD-Text too large for the lead-in; dropping per-track artists')"
    grep -v '^    PERFORMER' "$CUE" > "$CUE.trim" && mv "$CUE.trim" "$CUE"
  fi

  total_mb=$(( DATA / 1048576 ))

  # The blank line opens the burn panel's hole in a scrolling terminal. On the
  # alternate screen render() draws over the stage that is already there.
  [ "$SCREEN" -eq 1 ] || printf '\n'

  set +e
  if [ "$DEMO" -eq 1 ]; then
    demo_per=55
    fake_cdrecord "${#IDX[@]}" "$demo_per" \
      | render "$d" "$NDISCS" "${#IDX[@]}" $(( demo_per * ${#IDX[@]} ))
    rc=0
  else
    # -dao: disc-at-once, required for CD-Text and for zero gaps.
    # -text: write CD-Text from the cue sheet's TITLE/PERFORMER lines.
    # -dummy: run the whole thing with the write laser off.
    # -eject: pop the disc when done, which also cues the next one — but not
    #         when we still have to read it back, or when this was a rehearsal.
    OPTS=(-v -dao)
    [ "$CDTEXT" -eq 1 ] && OPTS+=(-text)
    [ "$DUMMY"  -eq 1 ] && OPTS+=(-dummy)
    [ "$VERIFY" -eq 0 ] && [ "$DUMMY" -eq 0 ] && OPTS+=(-eject)

    # tee keeps the real output: render() drops every line it cannot parse,
    # which would otherwise hide the reason a burn failed.
    ( cd "$WORK" && cdrecord "${OPTS[@]}" \
        dev="$DEV" speed="$SPEED" driveropts=burnfree \
        cuefile="$(basename "$CUE")" 2>&1 ) \
      | tee "$WORK/cdrecord-$d.log" \
      | render "$d" "$NDISCS" "${#IDX[@]}" "$total_mb"
    rc=${PIPESTATUS[0]}
  fi
  set -e

  if [ "$rc" -ne 0 ]; then
    # Off the alternate screen before a word of this: it is going to stderr and
    # the terminal is about to get its prompt back, so it has to land in the
    # scrollback and not on a panel that is one printf from being discarded.
    screen_off
    if [ -s "$WORK/cdrecord-$d.log" ]; then
      printf '\n  cdrecord said:\n' >&2
      tr '\r' '\n' < "$WORK/cdrecord-$d.log" \
        | grep -v 'MB written' | grep -v '^[[:space:]]*$' \
        | tail -15 | sed 's/^/    /' >&2 || true
    fi
    die "cdrecord failed on disc $d (exit $rc).
  Drive not found?          cdrecord -scanbus   then set BURNCD_DEV.
  Choked on CD-Text or cue? retry with --no-cdtext.
  Either way, burncd --check reports what this machine supports."
  fi

  rm -f "$IMAGE"

  # The disc is done, and the panel says so on a stage of its own: the meter it
  # was planned against, and the log of everything that has happened up to here.
  # The burn screen's last frame is not left sitting at 100% while the next disc
  # is being asked for.
  if [ "$DUMMY" -eq 1 ]; then
    stage "REHEARSED · DISC $d OF $NDISCS" "$(printf '\n'; strip "$d" "DISC $d")"
    note "$(printf '%b✓%b Disc %d of %d rehearsed — nothing written, disc still blank' \
      "$AMBER" "$OFF" "$d" "$NDISCS")"
    continue
  fi

  stage "WRITTEN · DISC $d OF $NDISCS" "$(printf '\n'; strip "$d" "DISC $d")"
  note "$(printf '%b✓%b Disc %d of %d written' "$AMBER" "$OFF" "$d" "$NDISCS")"

  if [ "$VERIFY" -eq 1 ] && [ "$DEMO" -eq 0 ]; then
    if verify_disc "$d" "${#IDX[@]}"; then
      note "$(printf '%b✓%b Disc %d verified' "$AMBER" "$OFF" "$d")"
    else
      VERIFY_FAILED="${VERIFY_FAILED:-}$d "
      note "$(printf '\033[31m✗\033[0m Disc %d did not verify — see above' "$d")"
    fi
    # We suppressed cdrecord's own eject to keep the disc readable; do it now
    # so a multi-disc job still cues the next one the same way.
    cdrecord -eject dev="$DEV" >/dev/null 2>&1 || true
  fi
  [ "$SCREEN" -eq 1 ] || printf '\n'
done
done

# ------------------------------------------------------------------ summary --

BURNED=$((NDISCS - FROM + 1))
ELAPSED=$(( $(date +%s) - STARTED ))

if [ "$DUMMY" -eq 1 ]; then
  printf -v SUMMARY 'REHEARSED · %d DISC%s · %s ELAPSED' \
    "$BURNED" "$([ "$BURNED" -eq 1 ] || echo S)" "$(mmss "$ELAPSED")"
else
  printf -v SUMMARY '%d DISC%s · %s · %s ELAPSED' \
    "$BURNED" "$([ "$BURNED" -eq 1 ] || echo S)" \
    "$(mmss "$TOTAL")" "$(mmss "$ELAPSED")"
fi

# The same faceplate the plan and the burn screen wear, so the last thing to be
# printed is recognisably the same machine as the first.
summary_panel() {
  local d
  faceplate "$SUMMARY"
  printf '\n'
  printf '    %b%-7s%b %s\n\n' "$ETCH" ALBUM "$OFF" "${ALBUM:-—}"
  for d in $(seq "$FROM" "$NDISCS"); do
    strip "$d" "DISC $d"
    printf '\n'
  done
  return 0
}

# The last stage: the job as a whole, and one key to leave by. Nothing scrolls
# past it and nothing prints over it — it sits there until it is dismissed, which
# is the point of having been in an application the whole time.
#
# And then nothing. Quitting hands the terminal back exactly as it was found,
# with the command you typed as the last thing in the scrollback; an application
# that unloads its screens into your history on the way out is not one you can
# run twice without scrolling. The only exception is a disc that did not verify,
# which is a result you need after the screen is gone.
if [ "$SCREEN" -eq 1 ]; then
  stage_done "$SUMMARY"
  while :; do
    wait_key || break
    case "$KEY" in q|Q|$'\n'|$' ') break ;; esac
  done
  screen_off
  if [ -n "${VERIFY_FAILED:-}" ]; then
    printf 'burncd: discs that did not verify: %s\n' "$VERIFY_FAILED" >&2
    exit 1
  fi
  exit 0
fi

if [ "$DUMMY" -eq 1 ]; then
  printf '  %bREHEARSAL COMPLETE%b — %d disc%s, %s elapsed.\n' \
    "$AMBER" "$OFF" "$BURNED" "$([ "$BURNED" -eq 1 ] || echo s)" "$(mmss "$ELAPSED")"
  printf '  Every step ran except the laser. Drop --dummy to burn for real.\n\n'
else
  summary_panel
  printf '\n'
  if [ -n "${VERIFY_FAILED:-}" ]; then
    printf '  \033[31mDiscs that did not verify: %s\033[0m\n\n' "$VERIFY_FAILED"
    exit 1
  fi
fi
