#!/usr/bin/env bash
#
# player — play an album from a zip, a folder, or the CD in the drive.
#
#   player                         pick a source from what is to hand
#   player ~/Downloads/Album.zip   play a zip without unpacking it yourself
#   player ~/Music/Album           play a folder
#   player --cd                    play the disc in the drive
#   player --check                 check this machine can play anything
#   player -n ~/Music/Album        read it, show the album, play nothing
#   player --no-mb --cd            play the disc without asking MusicBrainz
#
# Takes aiff, flac, mp3, ogg, wav, m4a, opus — anything ffmpeg reads, in a zip
# or loose in a folder. Track order comes from embedded metadata, not filenames.
# A zip is unpacked into a scratch directory under ~/.cache/player/work that is
# destroyed when the app closes, so what is left on disk afterwards is the zip
# you started with. Not $TMPDIR: macOS is entitled to reclaim that while a long
# record is still playing out of it, and it does.
#
# An audio CD is read off the disc's own table of contents: CD-Text when the
# disc carries it, MusicBrainz when it does not and the network is up, and
# plain track numbers when neither can say. Which of the three you got is
# printed on the panel, because a track list is only as good as its source.
#
# Transport is where your hands already are: space to pause, ←→ to seek and
# shift-←→ to seek further, ↑↓ to walk the list, enter to play what you are
# looking at, n and p for the next and previous track.
#
# The meters are controls as well as readouts. Click the album meter to put the
# needle anywhere in the record, whichever track that lands in; click the track
# meter to move within the track. Dragging either one scrubs, though a drag on
# the album meter stays inside the track it started in. Click a row to select it
# and again to play it, and the wheel walks the list.
#
# The cover is drawn beside the panel when the window is wide enough to hold it,
# fetched from the Cover Art Archive in the background and cached, so an album
# played twice only ever costs one download. It is never waited for: if there is
# no cover, or no network, the panel is exactly the panel it would have been.
#
# Env overrides:
#   PLAYER_DIRS    colon-separated dirs the picker scans (default ~/Music:~/Downloads)
#   PLAYER_DEV     cdrecord device for CD-Text (default: whichever the drive answers to)
#   PLAYER_MB      set to 0 to never ask MusicBrainz about a disc
#   PLAYER_ART     set to 0 to never fetch or draw the cover
#   PLAYER_WORK    where zips are unpacked (default ~/.cache/player/work)
#   PLAYER_KEEP    set to keep the scratch directory instead of destroying it

set -euo pipefail

# The faceplate, shared with burncd: the locale repair, the panel's geometry and
# palette, the alternate screen, the width primitives, the capacity meter, raw
# key reading and the health-check scaffolding all live in lib/panel.sh. The two
# tools are one instrument at two moments of the same disc, and that is only true
# for as long as one file decides what the picture is.
#
# Resolved through however many symlinks stand between $0 and the real file: the
# install is a symlink into /usr/local/bin, and BSD readlink has no -f to lean on.
APP=player
SELF=$0
while [ -L "$SELF" ]; do
  LINK=$(readlink "$SELF")
  case "$LINK" in /*) SELF=$LINK ;; *) SELF=$(dirname "$SELF")/$LINK ;; esac
done
LIB=$( (cd "$(dirname "$SELF")/../lib" && pwd) 2>/dev/null || true )
[ -n "$LIB" ] && [ -r "$LIB/panel.sh" ] \
  || { printf 'player: cannot find lib/panel.sh alongside %s\n' "$SELF" >&2; exit 1; }
. "$LIB/panel.sh"

# Both tools talk to the same drive, so a device pinned for one is a device
# pinned for the other. PLAYER_DEV still wins where someone has set only that.
DEV="${PLAYER_DEV:-${BURNCD_DEV:-}}"
DRY_RUN=0
CHECK=0
WANT_CD=0
SOURCE_ARG=""
USE_MB="${PLAYER_MB:-1}"

# How often the panel redraws while something is playing. Twenty frames a second
# is enough for the analyser to read as motion rather than as a stutter, and
# cheap because almost every one of those frames redraws the analyser's own rows
# and not the panel.
TICK=0.05
# The same number the other way round, because the loop rations frames by it and
# arithmetic in bash is integers.
TICK_HZ=20

# The analyser. Sixteen bands is the most that still leaves a bar wide enough to
# read at this panel width -- three columns each, one column between them, which
# lands at 63 of the 67 inside the rules with two to spare either side.
#
# Five rows of eight eighths gives a column forty steps of travel, which is the
# range the falling trail needs to actually be seen falling: fewer and a column
# is at the floor before the eye has followed it down.
SPEC_BANDS=16
SPEC_ROWS=5
SPEC_TOP=$(( SPEC_ROWS * 8 ))
SPEC_BAR=3
SPEC_HZ=10             # analysis frames a second, and so the table's row rate
SPEC_WINDOW=6          # narrowest scale a band is allowed, in dB
SPEC_FALL=2            # eighths a frame that an abandoned trail sinks by
# Sixteen bands log-spaced across the audible range: even steps in octaves, not
# in hertz, because that is how the ear divides it and how the low end earns
# enough bands to move independently instead of as one lump.
SPEC_FREQS='40 59 88 132 197 294 439 655 976 1456 2171 3237 4827 7197 10731 16000'

# Every row of the now-playing panel that is not a track, and the shortest window
# that can still hold one. Counted rather than guessed, for the reason set out at
# np_fit_rows: a frame one line taller than the window scrolls the panel's own
# top row away for good. The analyser stands where the lamp's single row did, so
# it costs the chrome the four rows it gained.
NP_CHROME=$(( 18 + SPEC_ROWS - 1 ))
NP_MIN_LINES=$(( NP_CHROME + 3 ))
PICK_CHROME=10
PICK_MIN_LINES=$(( PICK_CHROME + 3 ))

# ------------------------------------------------------------------ plumbing --

# mpv reports every time in float seconds. Everything on this panel is counted in
# whole ones, and a bare ${x%%.*} on "1.2e-05" or on an empty property would put
# a non-number into an arithmetic context and take the whole loop down with it.
intsec() {  # intsec <float> -> $ISEC
  ISEC=${1%%.*}
  case "$ISEC" in ''|*[!0-9]*) ISEC=0 ;; esac
  return 0
}

# ---------------------------------------------------------------- the screen --

# player is one instrument for as long as it runs, not a program that prints.
#
# The picker, the loading stage and the now-playing panel are stages of one
# display on the alternate screen, each laid over the last from the home
# position. Nothing scrolls, nothing stacks, and the scrollback underneath is
# untouched — when the app closes the terminal is exactly as it was found.
#
# The mechanics are in lib/panel.sh. What is here is the mouse, which player has
# and burncd has nothing to point at — and which screen_off has to know about,
# because a terminal handed back still in button-event tracking is a terminal
# that swallows drags. SCREEN_OFF_PRE is how it is told.
SCREEN_OFF_PRE='\033[?1006l\033[?1002l'

# The pointer, for the one part of this panel that is a control rather than a
# readout: the meters. A bar drawn to the width of the window is a scrubber
# already — it just had no way of being told so.
#
# 1002 is button-event tracking: presses, releases, and movement while a button
# is down, which is what makes dragging along a meter a scrub rather than a
# series of unrelated clicks. 1006 asks for the coordinates back in SGR form —
# decimal numbers in an ordinary CSI sequence — because the original encoding
# put the column in a single byte and gave up past column 223, which any
# terminal wide enough to show this panel comfortably will exceed.
#
# Turned on for the now-playing panel alone rather than in screen_on. The picker
# has nothing on it to point at, and a mouse report arriving there is a keystroke
# it does not recognise and would redraw for.
#
# The cost, and it is worth saying plainly: while this is on, the terminal sends
# drags to the app instead of selecting text with them. Most terminals still
# select on shift-drag, which is the usual way out.
mouse_on()  { [ "$SCREEN" -eq 1 ] && printf '\033[?1002h\033[?1006h'; return 0; }
mouse_off() { [ "$SCREEN" -eq 1 ] && printf '\033[?1006l\033[?1002l'; return 0; }

# ------------------------------------------------------------------ scratch --

# Where a zip is unpacked to, and the promise that it does not outlive the app.
#
# Not $TMPDIR, which is the obvious place and the wrong one. macOS treats
# everything under /var/folders/…/T as space it may take back whenever the disk
# gets tight, and it does not care that something is playing out of it: a
# six-hour record unpacked onto a volume with little room left can simply cease
# to exist halfway through. What that looks like from here is every remaining
# track failing to open inside two seconds and the album quietly "finishing".
#
# So it goes under the cache directory, which is ours and which nothing else
# reclaims. That trades one risk for another — $TMPDIR does at least get swept
# eventually, and a session killed outright, by a SIGKILL or a power cut, would
# leave its gigabytes here for good. Hence the sweep: every session writes its
# pid into its own directory, and every session starting up clears away the
# directories whose pid is nobody.
#
# Made once, lazily, and destroyed by the exit trap however the app ends — a
# clean quit, a die(), or a Ctrl-C. mktemp -d gives a directory nothing else is
# in, which is what makes the rm -rf at the end safe to write at all: it is only
# ever pointed at a path this process created.
WORK=''
MPV_PID=''

# The cache if it will have us, $TMPDIR if it will not. A read-only or missing
# home is a reason to take the worse directory, not a reason to refuse to play
# a record.
work_base() {
  local b="${PLAYER_WORK:-${XDG_CACHE_HOME:-$HOME/.cache}/player/work}"
  if mkdir -p "$b" 2>/dev/null && [ -w "$b" ]; then
    printf '%s' "$b"
  else
    printf '%s' "${TMPDIR:-/tmp}"
  fi
  return 0
}

# What sessions that are not running any more left behind.
scratch_sweep() {  # scratch_sweep <base>
  local d pid
  for d in "$1"/player.*; do
    [ -d "$d" ] || continue
    # Somebody asked for this one with PLAYER_KEEP. Theirs to delete, not ours.
    [ -e "$d/keep" ] && continue
    pid=''
    if [ -f "$d/pid" ]; then read -r pid < "$d/pid" 2>/dev/null || pid=''; fi
    case "$pid" in
      ''|*[!0-9]*)
        # No pid at all: a session that died between making its directory and
        # writing into it. Given five minutes before it counts as abandoned, so
        # that a player starting up this instant is not swept by one starting up
        # the next.
        if [ -n "$(find "$d" -maxdepth 0 -mmin +5 2>/dev/null)" ]; then
          rm -rf "$d" 2>/dev/null || true
        fi
        ;;
      *)
        # A pid that answers is a player still using it. Two decks at once is
        # allowed, and the second must not delete the first one's album out from
        # under it — which is the whole failure this move was made to prevent.
        kill -0 "$pid" 2>/dev/null || rm -rf "$d" 2>/dev/null || true
        ;;
    esac
  done
  return 0
}

scratch() {
  local base
  [ -n "$WORK" ] && return 0
  base=$(work_base)
  scratch_sweep "$base"
  WORK=$(mktemp -d "$base/player.XXXXXX") || die "cannot make a scratch directory in $base"
  # Written before anything else goes in, because until it exists this directory
  # is one the sweep cannot tell from an abandoned one.
  printf '%s\n' "$$" > "$WORK/pid" || die "cannot write to $WORK"
  # The analyser's tables live here too, and go the same way at the end.
  mkdir -p "$WORK/spec" || die "cannot make a scratch directory"
  return 0
}

# Whether the analyser can have real levels to show. Not fatal if it cannot:
# ffmpeg is what reads the audio, and without it the columns fall back to the
# waves and everything else about the player works exactly the same.
SPEC_OK=0
command -v ffmpeg >/dev/null && SPEC_OK=1

cleanup() {
  local rc=$?
  local p pid
  # set -e is still in force inside a trap, and every step here is something that
  # is allowed to fail: the screen may never have been on, and mpv has usually
  # quit already, which makes kill fail. Any one of those failing would abandon
  # the rest of the handler -- and the rest of the handler is the promise this
  # program makes about your disk, so nothing below is allowed to be skipped.
  set +e
  # Torn down in the order it was built: the screen first, so a message from
  # anything below lands on a terminal that can show it.
  screen_off
  [ -n "$MPV_PID" ] && kill "$MPV_PID" 2>/dev/null
  # The analyser decodes a whole track through sixteen bandpasses, and it is
  # started from inside the event loop's subshell — so nothing it knows comes
  # back here in a variable, and quitting two seconds into a track would leave
  # ffmpeg running on a machine with no player on it, writing into a scratch
  # directory the next few lines are about to delete out from under it.
  if [ -n "$WORK" ]; then
    for p in "$WORK"/spec/*.pid; do
      [ -f "$p" ] || continue
      pid=''
      read -r pid < "$p" 2>/dev/null
      case "$pid" in ''|*[!0-9]*) continue ;; esac
      kill "$pid" 2>/dev/null
    done
  fi
  if [ -n "$WORK" ] && [ -d "$WORK" ]; then
    if [ -n "${PLAYER_KEEP:-}" ]; then
      # Marked, or the next session's sweep would take it: this pid is about to
      # stop answering, which is exactly what the sweep looks for.
      : > "$WORK/keep" 2>/dev/null || true
      printf 'player: scratch kept at %s\n' "$WORK" >&2
    else
      rm -rf "$WORK"
    fi
  fi
  return $rc
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# ---------------------------------------------------------------- arguments --

while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run) DRY_RUN=1 ;;
    --check)      CHECK=1 ;;
    --cd)         WANT_CD=1 ;;
    --no-mb)      USE_MB=0 ;;
    -h|--help)    usage 0 ;;
    -*)           die "unknown option: $1 (try --help)" ;;
    *)            [ -n "$SOURCE_ARG" ] && die "one source at a time, got: $1"
                  SOURCE_ARG="$1" ;;
  esac
  shift
done

# ------------------------------------------------------------- health check --

run_check() {
  local v dev=''
  check_open

  if v=$(mpv --version 2>/dev/null | head -1 | cut -c1-40); then
    ck ok mpv "$v"
  else
    ck fail mpv "not found. brew install mpv"
  fi

  if mpv --list-protocols 2>/dev/null | qgrep '^ *archive://'; then
    ck ok "mpv archives" "libarchive present"
  else
    ck warn "mpv archives" "no archive:// — zips are unpacked to scratch anyway"
  fi

  if v=$(ffprobe -version 2>/dev/null | head -1 | cut -c1-40); then
    ck ok ffprobe "${v}"
  else
    ck fail ffprobe "not found. brew install ffmpeg"
  fi

  # ffmpeg itself, not ffprobe: the analyser measures a track's spectrum ahead
  # of playing it. Same brew formula, so a machine with one usually has both,
  # and a machine with neither still plays — the columns just stop meaning
  # anything, which is worth a warning and not a failure.
  if [ "$SPEC_OK" -eq 1 ]; then
    ck ok analyser "$(ffmpeg -version 2>/dev/null | head -1 | cut -c1-40)"
  else
    ck warn analyser "no ffmpeg — the columns fall back to a pattern"
  fi

  command -v unzip >/dev/null \
    && ck ok unzip "$(unzip -v 2>/dev/null | head -1 | cut -c1-40)" \
    || ck fail unzip "not found — zips cannot be opened"

  if command -v nc >/dev/null && nc -h 2>&1 | qgrep -- '-U'; then
    ck ok "unix sockets" "nc -U present — mpv can be driven"
  elif command -v nc >/dev/null; then
    # Apple's nc documents -U poorly but has it; only a truly missing nc is fatal.
    ck warn "unix sockets" "nc present, -U undocumented — probably fine"
  else
    ck fail "unix sockets" "nc not found — mpv cannot be driven"
  fi

  if command -v drutil >/dev/null; then
    v=$(drutil status 2>/dev/null | awk -F: '/Type:/ { print $2; exit }' | awk '{ $1=$1; print }')
    [ -n "$v" ] && ck ok "optical drive" "media: $v" || ck warn "optical drive" "no disc, or no drive"
  else
    ck warn "optical drive" "drutil not found — CDs cannot be detected"
  fi

  if command -v cdda2wav >/dev/null || command -v cdrecord >/dev/null; then
    ck ok "CD-Text" "$( command -v cdda2wav >/dev/null && echo cdda2wav || echo cdrecord ) present"
  else
    ck warn "CD-Text" "no cdrtools — discs fall back to MusicBrainz or numbers"
  fi

  # Both, not either: the disc ID is fetched with curl and the answer is a lump
  # of JSON that jq reads. Missing either one means the same thing on screen.
  if [ "$USE_MB" != 1 ]; then
    ck warn "MusicBrainz" "disabled with --no-mb — untitled discs stay untitled"
  elif command -v curl >/dev/null && command -v jq >/dev/null; then
    ck ok "MusicBrainz" "curl and jq present — untitled discs can be looked up"
  else
    v=$( command -v curl >/dev/null || printf 'curl '; command -v jq >/dev/null || printf 'jq' )
    ck warn "MusicBrainz" "no ${v% } — untitled discs stay untitled. brew install ${v% }"
  fi

  # Where a zip is unpacked to. A directory that cannot be written to is the one
  # failure that would otherwise not show up until an album was half open, and
  # the free space is worth printing because a record that does not fit is the
  # other one.
  v=$(work_base)
  if dev=$(mktemp -d "$v/check.XXXXXX" 2>/dev/null); then
    rmdir "$dev" 2>/dev/null
    if [ "$v" = "${TMPDIR:-/tmp}" ] && [ -z "${PLAYER_WORK:-}" ]; then
      # The fallback. It works, but it is the directory the OS may reclaim under
      # a playing album, so say so rather than reporting a plain ok.
      ck warn "scratch space" \
        "$(df -h "$v" 2>/dev/null | awk 'NR==2 { print $4 }') free in $v — cache dir unwritable, so long albums may be reclaimed mid-play"
    else
      ck ok "scratch space" "$(df -h "$v" 2>/dev/null | awk 'NR==2 { print $4 }') free in $v"
    fi
  else
    ck fail "scratch space" "cannot write to $v — zips cannot be opened"
  fi

  term_size
  if [ "$UTF8" -eq 1 ]; then
    ck ok terminal "UTF-8 (${LC_CTYPE:-${LANG:-?}}), ${TERM_COLS}x${TERM_LINES}"
  else
    ck warn terminal "not UTF-8 — the meters will render as mojibake"
  fi
  if [ "$TERM_LINES" -lt "$NP_MIN_LINES" ] || [ "$TERM_COLS" -lt $(( PANEL + 2 )) ]; then
    ck warn "window size" "need ${NP_MIN_LINES} rows x $(( PANEL + 2 )) cols for the panel"
  else
    ck ok "window size" "room for the panel"
  fi

  check_summary 'Ready to play.' 'Not ready to play.'
}

if [ "$CHECK" -eq 1 ]; then
  run_check || exit 1
  exit 0
fi

# ------------------------------------------------------------- requirements --

command -v mpv     >/dev/null || die "mpv not found. brew install mpv"
command -v ffprobe >/dev/null || die "ffprobe not found. brew install ffmpeg"
command -v nc      >/dev/null || die "nc not found — mpv cannot be driven"

# ------------------------------------------------------------ the meters --

# The album meter is burncd's capacity meter, drawn by bands() and bandbar() in
# lib/panel.sh: bands are tracks in four alternating ambers, the head is where
# the laser was and is now where the playhead is, the run-out is everything not
# yet reached. The picture you approved before burning a disc is the picture you
# watch while playing it back, which is only true for as long as one file decides
# what the picture is.
#
# What is here is the bar burncd has no use for.

# A plain single-band bar, for the one track playing now. Same cells and the same
# partial blocks as the album meter so the two read as one family, but one colour
# and one head: a track has no internal structure worth banding.
TRACKBAR=''
trackbar() {  # trackbar <done> <total> -> $TRACKBAR
  local done=$1 total=$2 units head j=0 cs ce
  local out='' curfg='' curbg=''
  local PARTS=('' '▏' '▎' '▍' '▌' '▋' '▊' '▉')
  units=$(( STRIP_WIDTH * 8 ))
  head=0
  [ "$total" -gt 0 ] && head=$(( done * units / total ))
  [ "$head" -gt "$units" ] && head=$units
  while [ "$j" -lt "$STRIP_WIDTH" ]; do
    cs=$(( j * 8 )); ce=$(( cs + 8 ))
    if [ "$head" -ge "$ce" ]; then
      strip_sgr 214 ''; out="${out}▓"
    elif [ "$head" -gt "$cs" ]; then
      strip_sgr "$HEAD" ''; out="${out}${PARTS[$(( head - cs ))]}"
    else
      strip_sgr "$RUNOUT" ''; out="${out}░"
    fi
    j=$(( j + 1 ))
  done
  TRACKBAR="$out\033[0m"
  return 0
}

# The analyser, under the album meter where burncd puts its minute scale. It
# exists because an album is forty minutes of a number that moves once a second,
# and a panel with nothing moving on it looks like a panel that has died — but
# unlike a lamp sweeping a dark field it is telling you something, because the
# columns are the band levels of the sound actually coming out of the deck. It
# stops dead when the music is paused, which is the one thing it has to say that
# the numbers do not say faster.

# What the columns are doing right now, in eighths of a row, 0 to $SPEC_TOP.
# SPEC_H is where each column stands; SPEC_G is the trail it left above itself
# on the way down; SPEC_A is how many frames that trail has been abandoned for,
# which is what fades it out.
SPEC_H=(); SPEC_G=(); SPEC_A=()
SPECROWS=()

spec_reset() {
  local b=0
  while [ "$b" -lt "$SPEC_BANDS" ]; do
    SPEC_H[$b]=0; SPEC_G[$b]=0; SPEC_A[$b]=99
    b=$(( b + 1 ))
  done
  return 0
}
spec_reset

# Advance every column to where the table says it should be, and let the trails
# fall. A column jumps to its new level the instant the level arrives — an
# analyser that eased upward would read as a slow analyser, not a smooth one —
# and only the falling is slowed, because that is the part the eye follows.
spec_step() {  # spec_step <band-heights...>
  local b=0 h
  while [ "$b" -lt "$SPEC_BANDS" ]; do
    h=$1; shift
    [ -z "$h" ] && h=0
    SPEC_H[$b]=$h
    if [ "$h" -ge "${SPEC_G[$b]}" ]; then
      # Caught up with its own trail: there is nothing left up there to dissipate.
      SPEC_G[$b]=$h; SPEC_A[$b]=0
    else
      SPEC_G[$b]=$(( SPEC_G[b] - SPEC_FALL ))
      [ "${SPEC_G[$b]}" -lt "$h" ] && SPEC_G[$b]=$h
      SPEC_A[$b]=$(( SPEC_A[b] + 1 ))
    fi
    b=$(( b + 1 ))
  done
  return 0
}

# One row of the analyser, top row first. Each row covers eight eighths of every
# column, so which glyph a cell gets is just where this row's slice sits relative
# to the column's height and the trail above it.
#
# Filled cells are graded by row rather than by band: the top of the panel is the
# brightest, so a column that reaches the ceiling arrives there rather than
# merely being tall. The trail is graded by age instead, down the same amber
# ramp the meters use, so it reads as the same light going out.
spec_row_str() {  # spec_row_str <row-from-top> -> $SPECROW
  local r=$1 b=0 lo fill g pad
  local out='' curfg='' curbg=''
  local PARTS=('' '▁' '▂' '▃' '▄' '▅' '▆' '▇')
  local ROWFG
  # Brightest at the top of the travel, so height reads as intensity.
  case $r in
    0) ROWFG=$HEAD ;;
    1) ROWFG=220 ;;
    2) ROWFG=214 ;;
    3) ROWFG=172 ;;
    *) ROWFG=130 ;;
  esac
  lo=$(( (SPEC_ROWS - 1 - r) * 8 ))

  # Two columns of margin either side: sixteen bars of three with a column
  # between them is 63 of the 67 inside the rules.
  strip_sgr 236 ''; out="${out}  "
  while [ "$b" -lt "$SPEC_BANDS" ]; do
    [ "$b" -gt 0 ] && { strip_sgr 236 ''; out="${out} "; }
    fill=$(( SPEC_H[b] - lo ))
    g=$(( SPEC_G[b] - lo ))
    if [ "$fill" -ge 8 ]; then
      strip_sgr "$ROWFG" ''
      out="${out}███"
    elif [ "$fill" -gt 0 ]; then
      strip_sgr "$ROWFG" ''
      out="${out}${PARTS[$fill]}${PARTS[$fill]}${PARTS[$fill]}"
    elif [ "$g" -gt 0 ]; then
      # Above the column but inside its trail: the light that has not gone out
      # yet. Older trails are dimmer, and the oldest are a shade off the field.
      case ${SPEC_A[$b]} in
        0|1) strip_sgr 220 ''; out="${out}▓▓▓" ;;
        2|3) strip_sgr 214 ''; out="${out}▒▒▒" ;;
        4|5) strip_sgr 172 ''; out="${out}▒▒▒" ;;
        6|7) strip_sgr 130 ''; out="${out}░░░" ;;
        *)   strip_sgr "$RUNOUT" ''; out="${out}░░░" ;;
      esac
    else
      strip_sgr 236 ''; out="${out}···"
    fi
    b=$(( b + 1 ))
  done
  strip_sgr 236 ''; out="${out}  "
  SPECROW="$out\033[0m"
  return 0
}

# The whole analyser as $SPEC_ROWS finished strings, so a tick can put them on
# the screen without rebuilding the panel around them.
spec_render() {
  local r=0
  SPECROWS=()
  while [ "$r" -lt "$SPEC_ROWS" ]; do
    spec_row_str "$r"
    SPECROWS[$r]="$SPECROW"
    r=$(( r + 1 ))
  done
  return 0
}

# The analyser with the power still on but nothing moving: what a paused deck
# shows. Not blank, because blank is what a broken one shows.
spec_idle() {
  local r=0 b line
  SPECROWS=()
  while [ "$r" -lt "$SPEC_ROWS" ]; do
    if [ "$r" -eq $(( SPEC_ROWS - 1 )) ]; then
      line=''; b=0
      while [ "$b" -lt "$SPEC_BANDS" ]; do
        [ "$b" -gt 0 ] && line="${line} "
        # Braced, and so is every other one of these: bash 3.2 reading $line▁
        # takes the bytes of the ▁ to be part of the variable's name, and the
        # panel comes apart with an unbound variable rather than a bad glyph.
        line="${line}▁▁▁"
        b=$(( b + 1 ))
      done
      SPECROWS[$r]="\033[38;5;130m  ${line}  \033[0m"
    else
      line=''; b=0
      while [ "$b" -lt "$SPEC_BANDS" ]; do
        [ "$b" -gt 0 ] && line="${line} "
        line="${line}···"
        b=$(( b + 1 ))
      done
      SPECROWS[$r]="\033[38;5;236m  ${line}  \033[0m"
    fi
    r=$(( r + 1 ))
  done
  return 0
}

# The rendered analyser as one string of cursor moves and rows, addressed to
# wherever the last panel rebuild left it.
#
# It is built as a string rather than printed row by row because five printfs
# are five writes, and a terminal is free to draw between any two of them: the
# columns come out visibly a step apart. One write cannot be caught halfway.
SPECSTR=''
printf -v SPEC_BLANK '%*s' "$STRIP_WIDTH" ''
spec_str() {
  local r=0
  SPECSTR=''
  [ "$spec_row" -gt 0 ] || return 0
  # core-idle rather than pause, because pause is only one of the ways a deck
  # ends up making no sound. A record that has finished, a track that would not
  # open, mpv still filling its buffer -- all of them are silence, and columns
  # dancing over silence is the panel lying about what you are hearing.
  [ "$cidle" = true ] && spec_idle
  while [ "$r" -lt "$SPEC_ROWS" ]; do
    SPECSTR="${SPECSTR}\033[$(( spec_row + r ));1H\033[K  ${ETCH}▐${OFF}${SPECROWS[$r]}${ETCH}▌${OFF}"
    r=$(( r + 1 ))
  done
  return 0
}

# -------------------------------------------------------------- the analysis --

# Sixteen band levels every tenth of a second, for one file, written where the
# panel can find them. This is the only part of the program that looks at the
# audio itself rather than at what mpv says about it.
#
# One decode feeds all sixteen bandpasses, because decoding the file sixteen
# times would cost sixteen times as much. ffmpeg has no way to say "give me the
# spectrum", so the levels come back as sixteen separate files of RMS readings
# and awk has to put them side by side afterwards.
#
# Written to a temporary name and moved into place, so a table that exists is
# always a table that is finished: the player tests for the file and nothing
# else, and a half-written one would be read as gospel.
spectrum_analyse() {  # spectrum_analyse <audio-file> <table> <pid-file>
  local src=$1 tab=$2 pidf=$3 d fc split f i n ff
  local -a MAPS
  d="$tab.d"
  rm -rf "$d"; mkdir -p "$d" || return 1
  n=$(( 44100 / SPEC_HZ ))

  # Resampled to a known rate first, because the window that makes one row of
  # the table is counted in samples and a 48 kHz file would otherwise land at a
  # different row rate than a 44.1 kHz one.
  split="[0:a]aresample=44100,asplit=$SPEC_BANDS"
  i=0
  for f in $SPEC_FREQS; do split="$split[s$i]"; i=$(( i + 1 )); done
  fc="$split;"
  i=0
  MAPS=()
  for f in $SPEC_FREQS; do
    # Just over an octave wide: enough overlap that no frequency falls in a gap
    # between two bands, tight enough that neighbours still move independently.
    fc="$fc[s$i]bandpass=f=$f:width_type=o:w=1.1,asetnsamples=n=$n,astats=metadata=1:reset=1,ametadata=print:key=lavfi.astats.Overall.RMS_level:file=$d/b$i[o$i];"
    MAPS[${#MAPS[@]}]='-map'
    MAPS[${#MAPS[@]}]="[o$i]"
    MAPS[${#MAPS[@]}]='-f'
    MAPS[${#MAPS[@]}]='null'
    MAPS[${#MAPS[@]}]='-'
    i=$(( i + 1 ))
  done
  fc=${fc%;}

  # -nostdin because this runs in the background behind a program that has the
  # terminal in raw mode, and ffmpeg would otherwise eat the keystrokes.
  #
  # Backgrounded and waited on rather than run in the foreground, only so that
  # its pid can be written down. This whole function is already a background
  # subshell of the event loop, so a pid kept in a variable cannot reach the
  # exit trap — and the exit trap is the one thing that knows the app is over.
  # The file is removed the moment the decode is done, so what cleanup finds is
  # a pid that was still running a moment ago rather than one long recycled.
  ffmpeg -v error -nostdin -i "$src" -filter_complex "$fc" "${MAPS[@]}" \
    >/dev/null 2>&1 &
  ff=$!
  printf '%s\n' "$ff" > "$pidf"
  wait "$ff" || { rm -f "$pidf"; rm -rf "$d"; return 1; }
  rm -f "$pidf"

  awk -v dir="$d" -v nb="$SPEC_BANDS" -v top="$SPEC_TOP" -v win="$SPEC_WINDOW" '
  BEGIN {
    N = 0
    for (b = 0; b < nb; b++) {
      i = 0; file = dir "/b" b
      while ((getline line < file) > 0) {
        if (index(line, "RMS_level")) {
          split(line, p, "=")
          # Digital silence comes back as -inf, which would read as 0 dB — the
          # loudest thing there is — if it were simply added to a number.
          if (p[2] ~ /inf/ || p[2] == "") v = -90; else v = p[2] + 0
          if (v < -90) v = -90
          V[b, i] = v; i++
        }
      }
      close(file)
      if (N == 0 || i < N) N = i
    }
    if (N == 0) exit 1

    # Each band is scaled by what that band actually does over the track, not by
    # one scale for all sixteen: the bass of a record runs tens of decibels above
    # its top octave, and a single scale would leave half the panel flat all
    # night. A column spans the quiet-to-loud of its own band, which is what
    # makes every column worth looking at instead of just the loud ones.
    #
    # No apostrophes anywhere in here, incidentally: this whole program is one
    # single-quoted argument, and one of them ends it early.
    #
    # The scale is anchored at the quarter and ninety-percent marks of what that
    # band actually did, and those two are placed a quarter and six-sevenths of
    # the way up the column. Not the extremes, and this is the whole trick:
    # a record mastered in this century spends its life within a few decibels of
    # its own ceiling, with a long thin tail down into the gaps between songs.
    # Scale that tail into the column and the tail gets the column — every band
    # sits pinned near the top and twitches, which is what this did at first.
    # Throw the tail away and scale the part the music actually occupies, and the
    # columns use their whole height: a quarter of the time at the floor, a sixth
    # at the ceiling, and the rest of it moving between.
    for (b = 0; b < nb; b++) {
      # Half-decibel bins. A whole one is too coarse to divide a scale that can
      # come out six decibels wide.
      for (k = 0; k <= 180; k++) hist[k] = 0
      for (i = 0; i < N; i++) {
        k = int((V[b, i] + 90) * 2); if (k < 0) k = 0; if (k > 180) k = 180
        hist[k]++
      }
      c = 0; qa = -90; qb = 0; gota = 0
      wa = int(N * 0.25); wb = int(N * 0.90)
      for (k = 0; k <= 180; k++) {
        c += hist[k]
        if (!gota && c >= wa) { qa = k / 2 - 90; gota = 1 }
        if (c >= wb) { qb = k / 2 - 90; break }
      }
      span = (qb - qa) / 0.60
      # A band that genuinely does not move — a constant hiss, a held tone — gets
      # a scale wide enough that it stays honestly flat a quarter of the way up,
      # rather than having its own noise magnified to fill the column.
      if (span < win) span = win
      LO[b] = qa - 0.25 * span
      HI[b] = LO[b] + span
    }

    for (i = 0; i < N; i++) {
      s = ""
      for (b = 0; b < nb; b++) {
        h = int((V[b, i] - LO[b]) / (HI[b] - LO[b]) * top + 0.5)
        if (h < 0) h = 0; if (h > top) h = top
        s = s (b ? " " : "") h
      }
      print s
    }
  }' > "$tab.tmp" || { rm -rf "$d" "$tab.tmp"; return 1; }

  rm -rf "$d"
  mv -f "$tab.tmp" "$tab" || { rm -f "$tab.tmp"; return 1; }
  return 0
}

# Analyse a track if it has not been analysed and nothing is already analysing
# it. The lock is a file rather than a variable because the analysis runs in a
# background subshell and a variable set there would not come back.
spectrum_want() {  # spectrum_want <row>
  local row=$1 tab i
  [ "$SPEC_OK" -eq 1 ] || return 0
  [ "$row" -ge 0 ] && [ "$row" -lt "${#ORDER[@]}" ] || return 0
  tab="$WORK/spec/$row.tab"
  [ -f "$tab" ] && return 0
  [ -f "$tab.lock" ] && return 0
  : > "$tab.lock"
  i=${ORDER[$row]}
  ( spectrum_analyse "${FILES[$i]}" "$tab" "$tab.pid"
    rm -f "$tab.lock" "$tab.pid" ) >/dev/null 2>&1 &
  return 0
}

# The table for one track, read in whole. One `read` rather than a loop over the
# lines: a four minute track is two and a half thousand rows, and reading those
# one at a time costs a tenth of a second of silence at every track change.
SPEC=(); SPEC_N=0; SPEC_FOR=-1
spectrum_load() {  # spectrum_load <row>
  local tab="$WORK/spec/$1.tab"
  [ -s "$tab" ] || return 1
  SPEC=()
  IFS=$'\n' read -d '' -r -a SPEC < "$tab" || :
  SPEC_N=${#SPEC[@]}
  [ "$SPEC_N" -gt 0 ] || { SPEC_FOR=-1; return 1; }
  SPEC_FOR=$1
  return 0
}

# What the analyser shows while the analysis is still running, or when there is
# no ffmpeg to run it. Two travelling waves at rates that do not divide into one
# another, so the columns keep drifting out of step instead of settling into a
# pattern you can see repeating. It is honest about being decoration: it never
# claims to be the music, it only says the deck is running.
SPEC_WAVE=(4 8 14 20 26 32 36 39 40 39 36 32 26 20 14 8)
spec_synth() {  # spec_synth <frame>
  local f=$1 b=0
  local -a H
  H=()
  while [ "$b" -lt "$SPEC_BANDS" ]; do
    H[$b]=$(( ( SPEC_WAVE[ (f / 2 + b * 3) % 16 ] + SPEC_WAVE[ (f / 3 + b * 5) % 16 ] ) / 2 ))
    b=$(( b + 1 ))
  done
  spec_step "${H[@]}"
  return 0
}

