# ------------------------------------------------------------------ sources --

# What there is to play, gathered from three unrelated places into one list. Each
# entry is a tab-separated record so a title with a space in it survives being
# put in an array:
#
#   <kind>\t<path>\t<label>\t<detail>
#
# kind is zip, dir or cd. path is what open_source is later handed. label is what
# the picker prints, detail the dim column on its right.
SRC=()

# An audio CD, as macOS presents one: mounted as a volume of .aiff tracks by the
# CDDA filesystem, which is what makes a disc playable with no ripping step at
# all. drutil is asked first because it knows about a disc that has not finished
# mounting, and it is what tells a blank CD-R apart from an album.
CD_VOLUME=''

# Whether the drive has anything in it at all. drutil answers for the drive
# rather than for the filesystem, so it is the one thing that can tell an empty
# bay from a disc that has not finished mounting.
optical_media() {
  local t
  command -v drutil >/dev/null || return 1
  t=$( (drutil status 2>/dev/null || true) | awk -F: '/Type:/ { print $2; exit }' )
  t=$( printf '%s' "$t" | tr -d ' ' )
  case "$t" in ''|[Nn]o*) return 1 ;; esac
  return 0
}

find_cd() {
  local line dev rest mp opts v n
  CD_VOLUME=''

  # The answer that comes from the kernel rather than from what a directory
  # happens to hold: macOS mounts an audio CD with the CDDA filesystem, and
  # nothing else on the machine uses it.
  #
  # Split off the device on the first " on " and the options on the last " (":
  # a device node has no spaces in it, so the front is exact, and taking the
  # last bracket leaves a volume called "Live (Remastered)" with its own name.
  while IFS= read -r line; do
    case "$line" in *' on '*) ;; *) continue ;; esac
    dev=${line%% on *}; rest=${line#* on }
    mp=${rest% (*}; opts=${rest##* (}
    case "$opts" in cddafs,*|cddafs\)*) ;; *) continue ;; esac
    [ -d "$mp" ] || continue
    CD_VOLUME="$mp"; return 0
  done < <(mount 2>/dev/null || true)

  # Some discs mount as a plain volume of named tracks instead, so a volume of
  # nothing but .aiff files is still worth offering — but only once the drive
  # has said it has a disc in it. A directory listing cannot tell an album from
  # an external drive of field recordings; the drive can, and without asking it
  # that drive gets announced as "in the drive" and then has CD-Text and
  # MusicBrainz answers about some entirely other disc applied to its files.
  optical_media || return 1

  for v in /Volumes/*; do
    [ -d "$v" ] || continue
    n=$( (ls "$v" 2>/dev/null || true) | grep -ic '\.aiff\?$' || true )
    [ "${n:-0}" -gt 0 ] || continue
    if (ls "$v" 2>/dev/null || true) | qgrep -i 'Audio Track'; then
      CD_VOLUME="$v"; return 0
    fi
    [ "${n:-0}" -ge 2 ] && { CD_VOLUME="$v"; return 0; }
  done
  return 1
}

scan_sources() {
  local d z n dirs
  SRC=()

  if find_cd; then
    n=$( (ls "$CD_VOLUME" 2>/dev/null || true) | grep -ic '\.aiff\?$' || true )
    SRC+=("cd	$CD_VOLUME	$(basename "$CD_VOLUME")	${n:-0} tracks · in the drive")
  fi

  dirs="${PLAYER_DIRS:-$HOME/Music:$HOME/Downloads}"
  # A colon-separated path list, walked without an IFS change that would then
  # have to be put back before anything else in this function ran.
  while [ -n "$dirs" ]; do
    d="${dirs%%:*}"
    case "$dirs" in *:*) dirs="${dirs#*:}" ;; *) dirs='' ;; esac
    [ -n "$d" ] && [ -d "$d" ] || continue

    while IFS= read -r z; do
      [ -n "$z" ] || continue
      SRC+=("zip	$z	$(basename "$z")	$(du -h "$z" 2>/dev/null | cut -f1 | tr -d ' ') · zip")
    done < <(find "$d" -maxdepth 1 -type f -iname '*.zip' 2>/dev/null | LC_ALL=C sort)

    while IFS= read -r z; do
      [ -n "$z" ] || continue
      n=$(audio_count "$z")
      [ "$n" -gt 0 ] || continue
      SRC+=("dir	$z	$(basename "$z")	$n tracks · folder")
    done < <(find "$d" -maxdepth 1 -type d ! -path "$d" 2>/dev/null | LC_ALL=C sort)
  done
  return 0
}

AUDIO_GLOB=( -iname '*.aif' -o -iname '*.aiff' -o -iname '*.flac' -o -iname '*.mp3'
             -o -iname '*.ogg' -o -iname '*.opus' -o -iname '*.wav' -o -iname '*.m4a'
             -o -iname '*.wma' -o -iname '*.ape'  -o -iname '*.alac' -o -iname '*.mp4' )

audio_count() {  # audio_count <dir>
  find "$1" -maxdepth 1 -type f \( "${AUDIO_GLOB[@]}" \) 2>/dev/null | wc -l | tr -d ' '
}

# ------------------------------------------------------------------ picker --

# The first screen: everything playable this machine can see, on one panel, in
# the order it was found — the disc in the drive first, because if there is one
# in there it is almost certainly what you came to play.
pick_frame() {  # pick_frame <cursor> <top> <rows> <status>
  local cur=$1 top=$2 vis=$3 status=$4 k rec kind path label detail mark meta body
  local last=$(( top + vis ))

  printf -v meta '%d SOURCE%s' "${#SRC[@]}" "$( [ "${#SRC[@]}" -eq 1 ] || printf S )"
  faceplate "$meta"
  printf '\n'
  printf '    %b%s%b\n' "$ETCH" "SELECT A SOURCE" "$OFF"
  printf '\n'

  k=$top
  while [ "$k" -lt "$last" ] && [ "$k" -lt "${#SRC[@]}" ]; do
    rec=${SRC[$k]}
    IFS=$'\t' read -r kind path label detail <<< "$rec"
    case "$kind" in
      cd)  mark='⊙' ;;
      zip) mark='▤' ;;
      *)   mark='▸' ;;
    esac
    fitv "$label" 44
    if [ "$cur" -eq "$k" ]; then
      printf -v body '%s  %s  %s' "$mark" "$FIT" "$(fit "$detail" 18)"
      printf '  %b▶%b %b%s%b\n' "$AMBER" "$OFF" "$INV" "$body" "$OFF"
    else
      printf '    %b%s%b  %s  %b%s%b\n' \
        "$ETCH" "$mark" "$OFF" "$FIT" "$DIM" "$(fit "$detail" 18)" "$OFF"
    fi
    k=$(( k + 1 ))
  done
  [ "$last" -lt "${#SRC[@]}" ] && more_row $(( ${#SRC[@]} - last ))

  printf '\n'
  keys '↑↓' SELECT '⏎' OPEN R RESCAN Q QUIT
  [ -n "$status" ] && printf '\n  %b%s%b\n' "$AMBER" "$status" "$OFF"
  return 0
}

# The picker's own row budget. Same reasoning as np_fit_rows: the frame must stay
# under the window or \033[H loses the panel's top row for good.
pick_rows() {  # pick_rows <status> -> $PICK_ROWS
  local budget
  term_size
  budget=$(( TERM_LINES - PICK_CHROME ))
  [ -n "$1" ] && budget=$(( budget - 2 ))
  [ "${#SRC[@]}" -gt "$budget" ] && budget=$(( budget - 1 ))
  [ "$budget" -lt 1 ] && budget=1
  PICK_ROWS=$budget
  return 0
}

# Returns the chosen record in $PICKED, or nonzero if the user walked away.
PICKED=''
pick_source() {
  local cur=0 top=0 status='' frame
  PICKED=''
  [ "${#SRC[@]}" -gt 0 ] || die "nothing to play. Put an album in ${PLAYER_DIRS:-~/Music or ~/Downloads}, or a CD in the drive"

  # One source and no argument is not a choice, it is the answer.
  if [ "${#SRC[@]}" -eq 1 ]; then PICKED=${SRC[0]}; return 0; fi
  [ "$SCREEN" -eq 1 ] || { PICKED=${SRC[0]}; return 0; }

  tui_block
  while :; do
    [ "$cur" -lt 0 ] && cur=0
    [ "$cur" -ge "${#SRC[@]}" ] && cur=$(( ${#SRC[@]} - 1 ))
    pick_rows "$status"
    [ "$cur" -lt "$top" ] && top=$cur
    [ "$cur" -ge $(( top + PICK_ROWS )) ] && top=$(( cur - PICK_ROWS + 1 ))
    [ "$top" -lt 0 ] && top=0

    frame=$(pick_frame "$cur" "$top" "$PICK_ROWS" "$status")
    paint "$frame"
    status=''

    read_key || { tui_cooked; return 1; }
    case "$KEY" in
      $'\033[A'|k)  cur=$(( cur - 1 )) ;;
      $'\033[B'|j)  cur=$(( cur + 1 )) ;;
      $'\033[5~')   cur=$(( cur - PICK_ROWS )) ;;
      $'\033[6~')   cur=$(( cur + PICK_ROWS )) ;;
      $'\n'|$'\r')  PICKED=${SRC[$cur]}; tui_cooked; return 0 ;;
      r|R)          scan_sources; status='▪ RESCANNED' ;;
      q|Q)          tui_cooked; return 1 ;;
    esac
  done
}

# ------------------------------------------------------------------ loading --

# A stage of the same display, for the seconds a zip takes to come out of its
# archive. The bar is the album meter with no bands yet — one per file as they
# land, which is the honest picture of the wait.
LAST_STAGE=''
load_stage() {  # load_stage <title> <done> <total> <line>
  local frame head=0
  # Without a panel there is nowhere to redraw, so a per-file line would just be
  # the file list twice over. One line per stage, when the stage changes.
  if [ "$SCREEN" -ne 1 ]; then
    if [ "${1%% ·*}" != "$LAST_STAGE" ]; then
      LAST_STAGE=${1%% ·*}
      printf '  %s %s\n' "$LAST_STAGE" "$SRC_LABEL" >&2
    fi
    return 0
  fi
  [ "$3" -gt 0 ] && head=$(( $2 * STRIP_WIDTH * 8 / $3 ))
  bands $(( STRIP_WIDTH * 8 )) 1
  trackbar "$2" "$3"
  frame=$(
    faceplate "$1"
    printf '\n'
    printf '    %b%-8s%b %s\n' "$ETCH" SOURCE "$OFF" "$SRC_LABEL"
    printf '\n'
    printf '    %b%-8s%b %s\n' "$ETCH" READING "$OFF" "$(fit "$4" 52)"
    printf '\n'
    printf '  %b▐%b%b%b▌%b\n' "$ETCH" "$OFF" "$TRACKBAR" "$ETCH" "$OFF"
  )
  paint "$frame"
  return 0
}

# Open whatever was picked and leave a directory of playable files in $AUDIO_DIR.
#
# A zip is unpacked entry by entry rather than in one unzip run, which costs a
# fork per file and buys the only progress report there is: the central directory
# is read once per entry, and on an album that is a dozen reads of a few hundred
# bytes. Everything in the zip is taken, not just the audio — the cover art is
# worth having on the panel, and a zip of an album is not big enough to be worth
# being clever about.
AUDIO_DIR=''
SRC_KIND=''; SRC_PATH=''; SRC_LABEL=''; SRC_DETAIL=''

# Bytes as something a person can read. Only the two messages about room use it,
# and both of them are read by somebody who has just been told no.
room_str() {  # room_str <bytes>
  awk -v b="${1:-0}" 'BEGIN {
    split("B KiB MiB GiB TiB", u, " "); i = 1
    while (b >= 1024 && i < 5) { b /= 1024; i++ }
    f = (i == 1) ? "%d %s" : "%.1f %s"
    printf f, b, u[i] }'
}

# How much room is left where the album is going. In 1K blocks, times 1024, and
# -P because the default df wraps long device names onto a second line and takes
# the columns with it.
room_free() {  # room_free <dir>
  local kb
  kb=$(df -Pk "$1" 2>/dev/null | awk 'NR == 2 { print $4 }')
  case "$kb" in ''|*[!0-9]*) printf 0 ;; *) printf '%s' $(( kb * 1024 )) ;; esac
}

open_source() {  # open_source <record>
  local rec=$1 n=0 total=0 entry esc rc=0 need=0 have=0
  IFS=$'\t' read -r SRC_KIND SRC_PATH SRC_LABEL SRC_DETAIL <<< "$rec"

  case "$SRC_KIND" in
    dir|cd)
      AUDIO_DIR="$SRC_PATH"
      ;;
    zip)
      command -v unzip >/dev/null || die "unzip not found — cannot open $SRC_LABEL"
      scratch
      AUDIO_DIR="$WORK/album"
      mkdir -p "$AUDIO_DIR"
      total=$( (unzip -Z1 "$SRC_PATH" 2>/dev/null || true) | grep -vc '/$' || true )
      [ "${total:-0}" -gt 0 ] || die "nothing inside $SRC_LABEL"

      # Whether it fits, asked before a byte of it is written. A lossless record
      # is two to three times its zip, a long one is several gigabytes of that,
      # and the volume this unpacks onto is nobody's idea of empty. Finding out
      # afterwards means a half-unpacked album and a disk with nothing left on
      # it; finding out now costs one fork and a sentence.
      #
      # The margin is so that a record which only just fits does not leave the
      # volume at zero — the rest of the machine is still using it, and an album
      # is not worth wedging a Mac for.
      need=$(unzip -Zt "$SRC_PATH" 2>/dev/null | awk '/bytes uncompressed/ { print $3; exit }')
      case "$need" in ''|*[!0-9]*) need=0 ;; esac
      if [ "$need" -gt 0 ]; then
        have=$(room_free "$AUDIO_DIR")
        if [ $(( have - need )) -lt 33554432 ]; then
          die "$SRC_LABEL unpacks to $(room_str "$need") and there is $(room_str "$have") free in $WORK — set PLAYER_WORK to somewhere with room"
        fi
      fi

      load_stage "OPENING" 0 "$total" "$SRC_LABEL"
      while IFS= read -r entry; do
        [ -n "$entry" ] || continue
        case "$entry" in */) continue ;; esac
        # unzip reads the name it is handed as a pattern, not as a filename, so
        # the brackets in "Track [Live].mp3" are a character class that matches
        # one of L, i, v, e — and the track is silently not there afterwards.
        # Escaping the three metacharacters is what makes it a literal name.
        esc=${entry//\\/\\\\}
        esc=${esc//\[/\\[}; esc=${esc//\*/\\*}; esc=${esc//\?/\\?}
        # -o overwrites without asking, -qq says nothing, and a failure on one
        # entry is not a reason to abandon an album — a zip with one corrupt
        # booklet scan in it still has twelve good tracks.
        #
        # But not every failure is about the entry. A disk that fills partway
        # through fails every entry after it, identically and silently, and what
        # comes out the far end is an album missing its second half that plays
        # until it doesn't. So the exit code is read: the ones that mean "this
        # entry" carry on, and the ones that mean "this zip" or "this machine"
        # stop and say which. Room was checked before any of this ran, so
        # arriving here full means something else on the volume took it in the
        # meantime — worth saying out loud rather than half-unpacking over.
        #
        # -P '' is not about passwords, it is about not being asked for one: an
        # encrypted entry makes unzip prompt, and it prompts on the terminal this
        # program has in raw mode with the panel drawn over it. Handing it an
        # empty password up front turns a hang nobody can see into exit 82.
        rc=0
        unzip -qq -o -P '' "$SRC_PATH" "$esc" -d "$AUDIO_DIR" 2>/dev/null || rc=$?
        case "$rc" in
          0|1|2|11|81) ;;
          50) die "ran out of room unpacking $SRC_LABEL — $(room_str "$(room_free "$AUDIO_DIR")") left in $WORK" ;;
          51) die "$SRC_LABEL is truncated — it ends partway through $(basename "$entry")" ;;
          9)  die "$SRC_PATH went away while it was being unpacked" ;;
          80) die "interrupted while unpacking $SRC_LABEL" ;;
          82) die "$SRC_LABEL is encrypted — this player cannot open it" ;;
          *)  die "unzip gave up on $SRC_LABEL at $(basename "$entry") (exit $rc)" ;;
        esac
        n=$(( n + 1 ))
        load_stage "OPENING · $(( n * 100 / total ))%" "$n" "$total" "$(basename "$entry")"
      done < <(unzip -Z1 "$SRC_PATH" 2>/dev/null || true)
      ;;
    *)
      die "cannot open a source of kind: $SRC_KIND"
      ;;
  esac
  return 0
}

# ------------------------------------------------------------ read metadata --

FILES=(); DURS=(); TITLES=(); ARTISTS=(); TRKNOS=(); DISCNOS=()
ALBUM=""; ALBUM_ARTIST=""; YEAR=""; UNTAGGED=0; META_SOURCE="tags"
TOTAL=0

read_metadata() {
  local f dur trk disc title album artist aartist year key val n=0 total
  FILES=(); DURS=(); TITLES=(); ARTISTS=(); TRKNOS=(); DISCNOS=()
  ALBUM=""; ALBUM_ARTIST=""; YEAR=""; UNTAGGED=0; TOTAL=0

  total=$(find "$AUDIO_DIR" -type f \( "${AUDIO_GLOB[@]}" \) 2>/dev/null | wc -l | tr -d ' ')
  [ "${total:-0}" -gt 0 ] || die "no audio in $SRC_LABEL"

  while IFS= read -r f; do
    # One ffprobe call per file for duration and the tags we sort and label by.
    dur=""; trk=""; disc=""; title=""; album=""; artist=""; aartist=""; year=""
    while IFS='=' read -r key val; do
      case "$key" in
        duration)                         dur="$val" ;;
        TAG:track|TAG:tracknumber)        trk="$val" ;;
        TAG:disc|TAG:discnumber)          disc="$val" ;;
        TAG:title)                        title="$val" ;;
        TAG:album)                        album="$val" ;;
        TAG:artist)                       artist="$val" ;;
        TAG:album_artist|TAG:albumartist) aartist="$val" ;;
        TAG:date|TAG:year|TAG:originalyear) [ -z "$year" ] && year="$val" ;;
      esac
    done < <(ffprobe -v error -show_entries \
        'format=duration:format_tags=track,tracknumber,disc,discnumber,title,album,artist,album_artist,albumartist,date,year,originalyear' \
        -of default=nw=1 "$f" 2>/dev/null || true)

    # A file ffprobe cannot read is skipped rather than fatal: it is one bad
    # track in a zip, and eleven good ones are still an album worth playing.
    [ -n "$dur" ] && [ "$dur" != "N/A" ] || { n=$(( n + 1 )); continue; }

    # Tags are often "3/12" — keep the part before the slash. Missing track
    # numbers sort last, so tagged files keep their album order regardless.
    # 10# forces base ten: taggers write "08", and bash reads a leading zero as
    # octal and rejects 08 and 09 outright.
    trk="${trk%%/*}";   case "$trk"  in ''|*[!0-9]*) trk=9999; UNTAGGED=1 ;; esac
    disc="${disc%%/*}"; case "$disc" in ''|*[!0-9]*) disc=1 ;; esac

    # A CDDA volume has no tags on it at all, so the track number has to come off
    # the name macOS gave the file — "1 Audio Track.aiff". It matters more than
    # ordering: CD-Text and MusicBrainz both answer in track numbers, and without
    # this every one of them would be applied to the wrong row, because a plain
    # sort puts track 10 between 1 and 2.
    if [ "$SRC_KIND" = cd ] && [ "$trk" = 9999 ]; then
      lead=$(basename "$f"); lead=${lead%%[!0-9]*}
      case "$lead" in
        ''|*[!0-9]*) ;;
        *) trk=$lead; UNTAGGED=0 ;;
      esac
    fi
    trk=$(( 10#$trk )); disc=$(( 10#$disc ))

    # A tag with a tab or a newline in it is rare and entirely possible, and it
    # breaks two things at once: a newline inside a panel row bends the frame the
    # width code works to keep square, and a tab is the separator every record in
    # this file is split on. Flattened to a space here, once.
    title=${title//[$'\t\n\r']/ }
    artist=${artist//[$'\t\n\r']/ }
    album=${album//[$'\t\n\r']/ }
    aartist=${aartist//[$'\t\n\r']/ }

    FILES+=("$f")
    # Round up, never down: a track that ends before the meter says it does looks
    # like a skip.
    DURS+=("$(awk -v d="$dur" 'BEGIN { printf "%d", (d == int(d) ? d : int(d) + 1) }')")
    TITLES+=("${title:-$(basename "$f")}")
    ARTISTS+=("$artist")
    TRKNOS+=("$trk")
    DISCNOS+=("$disc")
    [ -z "$ALBUM" ] && ALBUM="$album"
    [ -z "$ALBUM_ARTIST" ] && ALBUM_ARTIST="${aartist:-$artist}"
    # Dates are often full ISO stamps; the year is the only part anyone labels with.
    [ -z "$YEAR" ] && YEAR="${year%%-*}"

    n=$(( n + 1 ))
    load_stage "READING · $(( n * 100 / total ))%" "$n" "$total" "$(basename "$f")"
  done < <(find "$AUDIO_DIR" -type f \( "${AUDIO_GLOB[@]}" \) 2>/dev/null | LC_ALL=C sort)

  [ "${#FILES[@]}" -gt 0 ] || die "no readable audio in $SRC_LABEL"

  # Fall back to the folder or zip's own name, which is nearly always the album.
  [ -z "$ALBUM" ] && ALBUM="${SRC_LABEL%.zip}"
  return 0
}

# Sort by disc, then track number, then filename. Files without track tags all
# share key 9999 and fall back to a natural filename sort among themselves.
ORDER=()
order_tracks() {
  local i
  ORDER=()
  while IFS= read -r i; do ORDER+=("$i"); done < <(
    for i in $(seq 0 $(( ${#FILES[@]} - 1 ))); do
      printf '%04d\t%04d\t%s\t%d\n' \
        "${DISCNOS[$i]}" "${TRKNOS[$i]}" "$(basename "${FILES[$i]}")" "$i"
    done | LC_ALL=C sort -t"$(printf '\t')" -k1,1n -k2,2n -k3,3V | cut -f4
  )
  TOTAL=0
  for i in "${ORDER[@]}"; do TOTAL=$(( TOTAL + DURS[i] )); done
  return 0
}

# Track number -> the row that holds it, echoed. CD-Text and MusicBrainz both
# answer in track numbers while the arrays are in the order the files were
# scanned, and those are not the same thing, so nothing may index by "n - 1".
row_of_track() {
  local i
  for i in $(seq 0 $(( ${#TRKNOS[@]} - 1 ))); do
    [ "${TRKNOS[$i]}" -eq "$1" ] && { printf '%d' "$i"; return 0; }
  done
  return 1
}

# -------------------------------------------------------------------- resume --

# Where you had got to, so that coming back to a record is not starting it again.
#
# Offered rather than applied: the panel says where it left off and waits for u.
# A player that jumps to the middle of side two because you played it last week
# has taken a decision that was yours to take, and the one thing you cannot do
# once it has is un-hear the surprise.
RESUME_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/player"
RESUME_FILE="$RESUME_DIR/resume"
RESUME_KEY=''
RESUME_ROW=-1
RESUME_POS=0

# What this record is, as a string that will still mean it tomorrow.
#
# A disc says what it is outright. Nothing else does, so everything else is asked
# what it contains instead of where it lives: a folder that has been moved, and a
# zip unpacked into a different scratch directory every single run, are both
# still the same album, and a key made out of the path would lose them both.
resume_key() {
  local s
  if [ -n "${DISCID:-}" ]; then printf 'd:%s' "$DISCID"; return 0; fi
  s=$(printf '%s|%s|%s|%s' "$ALBUM_ARTIST" "$ALBUM" "${#ORDER[@]}" "$TOTAL")
  printf 'a:%s' "$(printf '%s' "$s" | shasum 2>/dev/null | cut -c1-16)"
  return 0
}

resume_load() {
  local k row pos rest
  RESUME_ROW=-1; RESUME_POS=0
  RESUME_KEY=$(resume_key)
  [ -f "$RESUME_FILE" ] || return 1
  while IFS="$(printf '\t')" read -r k row pos rest; do
    [ "$k" = "$RESUME_KEY" ] || continue
    case "$row" in ''|*[!0-9]*) return 1 ;; esac
    case "$pos" in ''|*[!0-9]*) return 1 ;; esac
    [ "$row" -lt "${#ORDER[@]}" ] || return 1
    # Not worth offering to put you back at the top of track one, which is where
    # the record starts anyway, and not worth offering a position half a minute
    # in either -- by the time reading the offer is over you could have been
    # there. Anything further in than that was a real listening session.
    [ "$row" -gt 0 ] || [ "$pos" -ge 30 ] || return 1
    RESUME_ROW=$row
    RESUME_POS=$pos
    return 0
  done < "$RESUME_FILE"
  return 1
}

# Every album but this one, then this one: an upsert with no database under it.
# Built in a temporary file and moved into place, so that a player killed halfway
# through a write leaves the old file whole rather than half of a new one.
resume_save() {  # resume_save <row> <pos>
  local tmp
  [ -n "$RESUME_KEY" ] || return 0
  mkdir -p "$RESUME_DIR" 2>/dev/null || return 0
  tmp="$RESUME_FILE.$$"
  { [ -f "$RESUME_FILE" ] && awk -F"$(printf '\t')" -v k="$RESUME_KEY" \
      '$1 != k' "$RESUME_FILE" 2>/dev/null | tail -200
    printf '%s\t%s\t%s\t%s\n' "$RESUME_KEY" "$1" "$2" "$SRC_LABEL"
  } > "$tmp" 2>/dev/null && mv -f "$tmp" "$RESUME_FILE" 2>/dev/null
  rm -f "$tmp" 2>/dev/null
  return 0
}

# A record played to the end has nowhere to be resumed from, and leaving the last
# position on it would offer to put you back thirty seconds from the run-out
# groove the next time you reached for it.
resume_clear() {
  local tmp
  [ -n "$RESUME_KEY" ] || return 0
  [ -f "$RESUME_FILE" ] || return 0
  tmp="$RESUME_FILE.$$"
  awk -F"$(printf '\t')" -v k="$RESUME_KEY" '$1 != k' "$RESUME_FILE" \
    > "$tmp" 2>/dev/null && mv -f "$tmp" "$RESUME_FILE" 2>/dev/null
  rm -f "$tmp" 2>/dev/null
  return 0
}

# ---------------------------------------------------------------- collection --

# What your own catalogue has to say about the record that is playing.
#
# This is the one thing a general-purpose player cannot do. MusicBrainz knows
# what a disc is; only the shelf it came off knows that you bought it used at
# Amoeba and that it skips on track seven — and track seven skipping is precisely
# the moment you want to be told you already knew.
#
# Nothing here is allowed to matter. Every failure — no file, no awk, a header
# that has been renamed, an album that is simply not in the collection — leaves
# the panel exactly as it would have been, because a missing note is not a reason
# to interrupt a record.
COLL_FILE="${PLAYER_COLLECTION:-}"
COLL_HIT=0
COLL_YEAR=''; COLL_GENRE=''; COLL_TAGS=''; COLL_NOTES=''; COLL_ART=''
COLL_SHELF=''; COLL_ROWS=0

# The catalogue that ships alongside this script, resolved through however many
# symlinks stand between $0 and the file itself — this lives in scripts/player of
# a repository whose data is two directories up, and a symlink into ~/bin is the
# normal way to have it on a PATH.
collection_file() {
  local src dir
  [ -n "$COLL_FILE" ] && { printf '%s' "$COLL_FILE"; return 0; }
  src=$0
  while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" 2>/dev/null && pwd) || break
    src=$(readlink "$src")
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  dir=$(cd -P "$(dirname "$src")" 2>/dev/null && pwd) || return 1
  printf '%s' "$dir/../../data/collection.csv"
  return 0
}

# Columns are found by name rather than by number, because the two CSVs in this
# repository do not agree on whether Number or Book comes first, and a lookup
# that silently reads the wrong column is worse than one that finds nothing.
#
# The quoted-field walk is there for "riot grrrl, compilation, punk rock", which
# is one field containing two commas and would be three fields to anything that
# split on commas alone. A quoted field containing a newline would defeat this,
# and none of the ways this catalogue is produced can make one.
collection_lookup() {
  local f out
  COLL_HIT=0
  COLL_YEAR=''; COLL_GENRE=''; COLL_TAGS=''; COLL_NOTES=''; COLL_ART=''
  [ -n "$ALBUM" ] || return 1
  command -v awk >/dev/null || return 1
  f=$(collection_file) || return 1
  [ -f "$f" ] || return 1

  out=$(awk -v want_a="$ALBUM_ARTIST" -v want_t="$ALBUM" '
    function csvsplit(s, arr,   n,i,c,fl,inq) {
      n=0; fl=""; inq=0
      for (i=1;i<=length(s);i++) {
        c=substr(s,i,1)
        if (inq) {
          if (c=="\"") { if (substr(s,i+1,1)=="\"") { fl=fl "\""; i++ } else inq=0 }
          else fl=fl c
        } else {
          if (c=="\"") inq=1
          else if (c==",") { arr[++n]=fl; fl="" }
          else fl=fl c
        }
      }
      arr[++n]=fl
      return n
    }
    # Loose enough that "The Beatles" finds "Beatles" and punctuation and case
    # never decide it, strict enough that two different records cannot collide.
    function norm(s,   t) {
      t=tolower(s); gsub(/^the +/,"",t); gsub(/[^a-z0-9]/,"",t); return t
    }
    NR==1 {
      n=csvsplit($0,h)
      for (i=1;i<=n;i++) {
        k=tolower(h[i])
        if (k=="artist") ca=i; else if (k=="title") ct=i
        else if (k=="year") cy=i; else if (k=="parent genre") cg=i
        else if (k=="tags") cs=i; else if (k=="notes") cn=i
        else if (k=="art url") cu=i
      }
      next
    }
    {
      n=csvsplit($0,r)
      if (!ct || norm(r[ct])!=norm(want_t)) next
      # Artist has to agree when we have one. When the files carried no album
      # artist at all, a title on its own is accepted only if exactly one record
      # in the catalogue answers to it -- two would be a coin toss.
      if (want_a!="") { if (!ca || norm(r[ca])!=norm(want_a)) next }
      hits++
      y=cy?r[cy]:""; g=cg?r[cg]:""; s=cs?r[cs]:""; nt=cn?r[cn]:""; u=cu?r[cu]:""
    }
    END {
      if (hits==1 || (hits>1 && want_a!="")) {
        # US (\037) separates the fields rather than a tab, because bash treats
        # tab as IFS whitespace: a run of them collapses to one delimiter and an
        # empty field in the middle would shift every later field left. A record
        # with no Notes would hand its Art URL to COLL_NOTES. US is not IFS
        # whitespace, so one separator always means one field boundary.
        gsub(/[\t\037]/," ",y); gsub(/[\t\037]/," ",g); gsub(/[\t\037]/," ",s)
        gsub(/[\t\037]/," ",nt); gsub(/[\t\037]/," ",u)
        printf "%s\037%s\037%s\037%s\037%s\n", y,g,s,nt,u
      }
    }' "$f" 2>/dev/null) || return 1

  [ -n "$out" ] || return 1
  IFS=$'\037' read -r COLL_YEAR COLL_GENRE COLL_TAGS COLL_NOTES COLL_ART \
    <<EOF
$out
EOF
  # Assembled once here rather than on every frame: the panel rebuilds itself
  # once a second for as long as the record lasts, and this string never changes.
  COLL_SHELF=''
  [ -n "$COLL_YEAR" ]  && COLL_SHELF="$COLL_YEAR"
  [ -n "$COLL_GENRE" ] && COLL_SHELF="${COLL_SHELF:+$COLL_SHELF · }$COLL_GENRE"
  [ -n "$COLL_TAGS" ]  && COLL_SHELF="${COLL_SHELF:+$COLL_SHELF · }$COLL_TAGS"
  # How much taller the faceplate just became, so that the track list gives up
  # exactly that many rows and the panel still fits the window it is in.
  COLL_ROWS=0
  [ -n "$COLL_SHELF" ] && COLL_ROWS=$(( COLL_ROWS + 1 ))
  [ -n "$COLL_NOTES" ] && COLL_ROWS=$(( COLL_ROWS + 1 ))
  COLL_HIT=1
  return 0
}

# ---------------------------------------------------------------- the sleeve --

# The cover, drawn beside the panel out of the terminal's own colours.
#
# A record has a front, and a player that never shows it is missing the part of
# the object you would actually be looking at. There is room for it: the panel is
# a fixed 71 columns and most windows are wider than that, so the sleeve goes in
# the space to the right that nothing else was ever going to use. On a window too
# narrow to hold it, it simply is not drawn, and the panel is exactly the panel it
# has always been — which is the whole reason the panel's width is fixed.
#
# Half blocks, not one character per pixel. ▀ paints its top half in the
# foreground colour and its bottom half in the background, so a single cell
# carries two pixels and the picture comes out at twice the vertical resolution
# the character grid has rows. A cell is also about twice as tall as it is wide,
# so two pixels per cell is exactly what makes a square cover come out square.
#
# Truecolour when the terminal says it has it, and the 256-colour cube when it
# does not — see art_render for why the fallback is not a plain nearest colour.
ART_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/player/art"
USE_ART="${PLAYER_ART:-1}"
MB_RELEASE=''
ART_KEY=''; ART_FILE=''
ART_STR=''; ART_COLS=0; ART_ROWS=0
# Column 72 and 73 are the gutter: the panel ends at 71 and a sleeve butted
# straight against it would read as part of the same object. Row 3 is where the
# album title is, so the cover starts level with the name of the record.
ART_COL0=74; ART_ROW0=3
ART_GEOM=''

# What this record is called on disk, so an album fetched once is not fetched
# again. The release ID when a disc gave us one, because that names a pressing
# exactly; otherwise the artist and the title folded down to letters and digits,
# so that the same album tagged two slightly different ways lands on one file.
art_key() {
  local s
  if [ -n "$MB_RELEASE" ]; then s="mbid-$MB_RELEASE"; else s="${ALBUM_ARTIST}-${ALBUM}"; fi
  s=$(printf '%s' "$s" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-')
  s=${s#-}; s=${s%-}; s=${s:0:80}; s=${s%-}
  [ -n "$s" ] || return 1
  printf '%s' "$s"
  return 0
}

# Candidate releases for a record that did not come out of the drive.
#
# A zip or a folder has tags and nothing else, so there is no disc ID to be exact
# with and the archive has to be asked by name. What comes back is a list rather
# than an answer, because an album is in MusicBrainz once per pressing — the
# original, the remaster, the European issue — and cover art is filed against a
# pressing rather than against the album. The first hit is quite often the one
# nobody ever scanned, so the fetch below walks the list until something has a
# front on it.
#
# The terms are matched as quoted phrases, which is strict on purpose: asked for
# an artist and an album that do not belong together, the catalogue answers with
# nothing rather than with its best guess. That is the property this depends on —
# a wrong cover drawn confidently beside the panel would be worse than none, and
# this is what makes that outcome unlikely enough not to need guarding against.
#
# --data-urlencode rather than pasting into the URL: titles carry ampersands,
# spaces and question marks, every one of which means something else in a query
# string. Quotes are stripped out of the terms first — they are the Lucene syntax
# that holds the phrase together, so a title containing one of its own would close
# the phrase early and leave the rest of the title parsed as query operators.
#
# Asked twice, because an empty answer is at least as often the server as the
# catalogue. MusicBrainz rate-limits to about a request a second and says so with
# a 503 whose body is an error rather than a release list, and its search index
# times out often enough to have done it twice while this was being written. Both
# arrive here as no results, and both are usually gone a second later. A pairing
# that genuinely is not in the catalogue answers twice over, which costs one
# spare request on a record that was never going to have a cover anyway.
mb_query() {  # mb_query <artist> <album>
  local q a=${1//\"/} b=${2//\"/} out try
  [ -n "$b" ] || return 1
  if [ -n "$a" ]; then q="artist:\"$a\" AND release:\"$b\""; else q="release:\"$b\""; fi
  for try in 1 2; do
    out=$(curl -sS -m 15 -G -A 'player/1.0 ( https://github.com/gvorbeck )' \
        --data-urlencode "query=$q" --data 'fmt=json' --data 'limit=5' \
        'https://musicbrainz.org/ws/2/release' 2>/dev/null \
      | jq -r '.releases[]?.id // empty' 2>/dev/null)
    [ -n "$out" ] && { printf '%s\n' "$out"; return 0; }
    sleep 1
  done
  return 1
}

mb_release_search() {
  local b
  [ "$USE_MB" = 1 ] || return 1
  [ -n "$ALBUM" ] || return 1
  mb_query "$ALBUM_ARTIST" "$ALBUM" && return 0
  # An untagged folder or zip has no title, only the name whoever made it gave
  # the file — "Comfort Eagle (1998) [FLAC]", "OK_Computer_(Remastered)". The
  # catalogue is matching a phrase against a real title, and none of that is in
  # the title, so the whole query misses on one bracket.
  b=$(printf '%s' "$ALBUM" \
      | sed -E 's/[[({][^])}]*[])}]//g; s/_+/ /g; s/  +/ /g; s/^ +//; s/ +$//')
  [ -n "$b" ] && [ "$b" != "$ALBUM" ] && { mb_query "$ALBUM_ARTIST" "$b" && return 0; }
  # The other half of the same convention: the folder is "Artist - Album", which
  # is both fields inside the one that is meant to be the title. Only worth trying
  # when there is no artist tag standing to contradict it.
  case "$b" in
    *' - '*) [ -z "$ALBUM_ARTIST" ] && { mb_query "${b%% - *}" "${b#* - }" && return 0; } ;;
  esac
  return 1
}

# Whether what came back is actually a picture.
#
# The Cover Art Archive answers with a redirect to the Internet Archive, and those
# nodes are not always well. A sick one has been seen serving an nginx error page
# under a 200 — and, worse, serving it labelled image/jpeg. Neither the status
# line nor the content type can be believed, so the only test worth making is
# whether a decoder can read the bytes, and that is the test.
art_ok() {  # art_ok <file>
  local wh
  [ -s "$1" ] || return 1
  wh=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height \
       -of csv=p=0 "$1" 2>/dev/null || true)
  # ffprobe prints "500,500" for a picture and "0,0" for something it opened but
  # could not measure, which is why this cannot just look for a digit.
  case "$wh" in ''|0,0|*,0|0,*|*[!0-9,]*) return 1 ;; esac
  return 0
}

# A record the archive has no cover for, remembered — but not for ever. Without
# this, an album with no scan costs two lookups on the network every single time
# it is played. Forgotten after a fortnight, so a cover uploaded in the meantime
# still turns up.
art_none_fresh() {
  local f="$ART_FILE.none"
  [ -f "$f" ] || return 1
  [ -n "$(find "$f" -mtime +14 2>/dev/null)" ] && { rm -f "$f"; return 1; }
  return 0
}

# Fetch a front cover and leave it where the panel can find it.
#
# Every part of this is allowed to fail and none of it is allowed to be noticed.
# It runs in the background from the moment the record starts, so the album is
# already playing while this is still deciding whether there is a cover at all —
# and when there is not, nothing about the panel changes.
#
# Downloaded beside the cache entry and moved onto it, so a file in the cache is
# always a whole one: the panel tests for the file and nothing else, and half a
# JPEG would be read as the cover and drawn as rubbish. The part file is named
# after the album rather than after this process, so a fetch that is killed
# mid-download leaves one file that the next attempt at the same record
# overwrites, instead of a new one every time.
art_fetch() {
  local id ids tmp try n=0
  set +e
  tmp="$ART_FILE.part"
  if [ -n "$MB_RELEASE" ]; then ids=$MB_RELEASE; else ids=$(mb_release_search); fi
  for id in $ids; do
    n=$(( n + 1 ))
    [ "$n" -gt 5 ] && break
    # Twice per candidate. A first failure is more often a sick archive node than
    # a missing cover, and the redirect lands on a different node next time.
    for try in 1 2; do
      rm -f "$tmp"
      curl -sSL -m 25 -o "$tmp" -A 'player/1.0 ( https://github.com/gvorbeck )' \
        "https://coverartarchive.org/release/$id/front-500" 2>/dev/null
      art_ok "$tmp" && { mv -f "$tmp" "$ART_FILE" 2>/dev/null && return 0; }
    done
  done
  rm -f "$tmp"
  : > "$ART_FILE.none" 2>/dev/null
  return 1
}

# Decide there is a cover to look for, and go and look in the background.
art_start() {
  ART_STR=''; ART_KEY=''; ART_FILE=''
  [ "$USE_ART" = 1 ] || return 0
  [ "$UTF8" -eq 1 ] || return 0
  command -v ffmpeg >/dev/null && command -v ffprobe >/dev/null || return 0
  command -v curl >/dev/null && command -v jq >/dev/null || return 0
  [ -n "$ALBUM" ] || return 0
  mkdir -p "$ART_CACHE" 2>/dev/null || return 0
  ART_KEY=$(art_key) || { ART_KEY=''; return 0; }
  ART_FILE="$ART_CACHE/$ART_KEY.jpg"
  # Already on disk from a previous session, or already known not to exist. Either
  # way there is nothing to ask the network; art_tick finds the file by itself.
  [ -s "$ART_FILE" ] && return 0
  art_none_fresh && return 0
  ( art_fetch >/dev/null 2>&1 ) &
  return 0
}

# --------------------------------------------------------------- CD metadata --

# macOS mounts an audio CD as a volume of files called "1 Audio Track.aiff",
# which is a track list with no titles in it. There are two better answers and
# this tries both, in the order of how much they can be trusted.
#
# CD-Text is written on the disc itself by whoever pressed it, so when it is
# there it is the answer. Most discs do not carry it.
#
# MusicBrainz is asked with a disc ID computed from the table of contents, which
# identifies a pressing rather than an album — so it distinguishes the 1984 CD
# from the 2011 remaster with the bonus tracks, and gets the track list right for
# whichever one is actually in the drive. It needs the network, and it is only
# asked when CD-Text has already come up empty.
#
# Whichever answered is printed on the faceplate. A track list is only as good as
# its source, and "CD-TEXT" and "MUSICBRAINZ" are different degrees of certain.
# CD-Text off the disc, into TITLES/ARTISTS/ALBUM. cdrtools prints it in a couple
# of shapes depending on version, so both are matched and neither is required.
#
# Every value on the disc arrives inside single quotes, and the quote that ends
# one is the one before " from '" or the one at the end of the line — not simply
# the next one along. Matching to the next one along cuts "Don't Stop Me Now"
# down to "Don", which is a title the disc does not have and no way to tell that
# from a disc that really is called that.
cd_text() {
  local out line name n i got=0 titles=0
  command -v cdrecord >/dev/null || command -v cdda2wav >/dev/null || return 1
  detect_dev || true

  out=''
  if command -v cdda2wav >/dev/null; then
    out=$( (cdda2wav dev="$DEV" -J -v titles 2>&1) || true )
  fi
  if ! printf '%s' "$out" | qgrep -i 'title'; then
    command -v cdrecord >/dev/null && out=$( (cdrecord dev="$DEV" -toc -v 2>&1) || true )
  fi
  [ -n "$out" ] || return 1

  # "Album title: 'Nonagon Infinity' from 'King Gizzard'"
  line=$(printf '%s\n' "$out" \
    | sed -n -e "s/^Album title:[ ]*'\(.*\)'[ ]*from[ ]*'.*'[ ]*\$/\1/p" \
             -e "s/^Album title:[ ]*'\(.*\)'[ ]*\$/\1/p" | head -1)
  [ -n "$line" ] && { ALBUM="$line"; got=1; }
  line=$(printf '%s\n' "$out" \
    | sed -n "s/^Album title:.*'[ ]*from[ ]*'\(.*\)'[ ]*\$/\1/p" | head -1)
  [ -n "$line" ] && { ALBUM_ARTIST="$line"; got=1; }

  # "Track  1 title: 'Robot Stop' from 'King Gizzard'"
  while IFS= read -r line; do
    n=$(printf '%s' "$line" | sed -n "s/^Track[ ]*\([0-9]*\).*/\1/p")
    case "$n" in ''|*[!0-9]*) continue ;; esac
    i=$(row_of_track $(( 10#$n )) ) || continue
    # Read into a local first: a shape this does not match would otherwise blank
    # the tidy "Track 07" cd_metadata has already put there, and a row with no
    # title at all is worse than a row with a dull one.
    name=$(printf '%s' "$line" \
      | sed -n -e "s/^Track[ ]*[0-9]*[ ]*title:[ ]*'\(.*\)'[ ]*from[ ]*'.*'[ ]*\$/\1/p" \
               -e "s/^Track[ ]*[0-9]*[ ]*title:[ ]*'\(.*\)'[ ]*\$/\1/p")
    [ -n "$name" ] || continue
    TITLES[$i]="${name//[$'\t\n\r']/ }"
    name=$(printf '%s' "$line" \
      | sed -n "s/^Track[ ]*[0-9]*[ ]*title:.*'[ ]*from[ ]*'\(.*\)'[ ]*\$/\1/p")
    [ -n "$name" ] && ARTISTS[$i]="${name//[$'\t\n\r']/ }"
    got=1; titles=$(( titles + 1 ))
  done < <(printf '%s\n' "$out" | grep -i '^Track[ ]*[0-9]*[ ]*title:' || true)

  # Not $got: an album title on its own is not a track list, and returning 0 for
  # one would both stamp CD-TEXT on the faceplate over a column of bare track
  # numbers and rob the disc of the MusicBrainz lookup that could have named
  # them. Whatever album and artist were found stay put either way — mb_lookup
  # overwrites what it knows better and leaves the rest alone.
  [ "$titles" -gt 0 ] || return 1
  META_SOURCE="CD-Text"
  return 0
}

# The MusicBrainz disc ID: SHA-1 over the first track, the last track, the
# lead-out offset and all 99 track offsets, each as uppercase hex, then base64
# with a URL-safe alphabet. It is a fingerprint of the pressing, which is why it
# can tell two masterings of the same album apart.
#
# The offsets come from the drive's table of contents in frames, plus the 150
# frame pre-gap that every CD address is measured from.
mb_discid() {  # mb_discid -> $DISCID, $MB_TOC
  local out line n off first=0 last=0 leadout=0 hex='' i
  local -a OFFS
  DISCID=''; MB_TOC=''
  command -v cdrecord >/dev/null || return 1
  command -v shasum   >/dev/null || return 1
  detect_dev || true

  out=$( (cdrecord dev="$DEV" -toc 2>&1) || true )
  OFFS=()
  # "track:   1 lba:         0 (       0) 00:02:00 adr: 1 control: 0 mode: -1"
  while IFS= read -r line; do
    n=$(printf '%s' "$line" | sed -n 's/^track:[ ]*\([0-9]*\).*/\1/p')
    off=$(printf '%s' "$line" | sed -n 's/.*lba:[ ]*\(-*[0-9]*\).*/\1/p')
    case "$n$off" in ''|*[!0-9-]*) continue ;; esac
    case "$n" in ''|*[!0-9]*) continue ;; esac
    case "$off" in ''|*[!0-9-]*) continue ;; esac
    n=$(( 10#$n ))
    OFFS[$n]=$(( off + 150 ))
    [ "$first" -eq 0 ] && first=$n
    [ "$n" -gt "$last" ] && last=$n
  done < <(printf '%s\n' "$out" | grep '^track:' || true)

  # The lead-out is track 0xAA in the TOC, printed by cdrtools as "lout".
  leadout=$(printf '%s\n' "$out" \
    | sed -n 's/^track:[ ]*lout[ ]*lba:[ ]*\([0-9]*\).*/\1/p' | head -1)
  case "$leadout" in ''|*[!0-9]*) return 1 ;; esac
  leadout=$(( leadout + 150 ))

  [ "$first" -gt 0 ] && [ "$last" -ge "$first" ] || return 1

  printf -v hex '%02X%02X%08X' "$first" "$last" "$leadout"
  MB_TOC="$first $last $leadout"
  i=1
  while [ "$i" -le 99 ]; do
    printf -v hex '%s%08X' "$hex" "${OFFS[$i]:-0}"
    [ "$i" -ge "$first" ] && [ "$i" -le "$last" ] && MB_TOC="$MB_TOC ${OFFS[$i]:-0}"
    i=$(( i + 1 ))
  done

  # base64 of the raw SHA-1, then MusicBrainz's own alphabet: + / = become . _ -
  DISCID=$(printf '%s' "$hex" | xxd -r -p 2>/dev/null | shasum -b 2>/dev/null \
    | cut -d' ' -f1 | xxd -r -p 2>/dev/null | base64 2>/dev/null \
    | tr '+/=' '._-' | tr -d '\n')
  [ -n "$DISCID" ] || return 1
  return 0
}

# Ask MusicBrainz what disc this is. Deliberately forgiving: no network, a disc
# nobody has submitted, a rate limit or a malformed answer all mean the same
# thing here — the track numbers stay, and the panel says so.
mb_lookup() {
  local json titles artists alb art i n=0 t
  [ "$USE_MB" = 1 ] || return 1
  command -v curl >/dev/null || return 1
  mb_discid || return 1

  json=$(curl -sS -m 12 -A 'player/1.0 ( https://github.com/gvorbeck )' \
    "https://musicbrainz.org/ws/2/discid/${DISCID}?fmt=json&inc=recordings+artist-credits" \
    2>/dev/null || true)
  [ -n "$json" ] || return 1
  printf '%s' "$json" | qgrep '"releases"' || return 1

  if command -v jq >/dev/null; then
    alb=$(printf '%s' "$json" | jq -r '.releases[0].title // empty' 2>/dev/null || true)
    art=$(printf '%s' "$json" | jq -r '.releases[0]."artist-credit"[0].name // empty' 2>/dev/null || true)
    t=$(printf '%s' "$json"   | jq -r '.releases[0].date // empty' 2>/dev/null || true)
    # Kept for the sleeve. The Cover Art Archive is keyed on a release, and a
    # disc ID resolves to one exactly — which is the strongest identification
    # anything here ever gets, and worth writing down while we hold it.
    MB_RELEASE=$(printf '%s' "$json" | jq -r '.releases[0].id // empty' 2>/dev/null || true)
    # The medium this disc actually is, matched on the disc ID that was used to
    # ask the question — not every medium that has one. A release is one entry
    # per disc in the box, so taking them all concatenates disc two's track list
    # onto disc one's, and the loop below then hands disc one's titles to
    # whichever disc is in the drive. Bracketed and indexed rather than piped
    # through select, because a medium carries several disc IDs for the same
    # pressing and select would emit it once per ID.
    titles=$(printf '%s' "$json" | jq -r --arg id "$DISCID" \
      '[.releases[0].media[]? | select([.discs[]?.id] | index($id))][0] | .tracks[]?.title' \
      2>/dev/null || true)
    # A release with one medium and no disc IDs listed against it is still that
    # medium, so a single-disc answer is worth taking on its own.
    [ -n "$titles" ] || titles=$(printf '%s' "$json" | jq -r \
      'select((.releases[0].media | length) == 1) | .releases[0].media[0].tracks[]?.title' \
      2>/dev/null || true)
  else
    return 1
  fi

  [ -n "$alb" ] && ALBUM="$alb"
  [ -n "$art" ] && ALBUM_ARTIST="$art"
  [ -n "$t" ]   && YEAR="${t%%-*}"

  # The list comes back in track order, so the nth title belongs to track n --
  # which is not row n, hence the lookup.
  n=0
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    n=$(( n + 1 ))
    i=$(row_of_track "$n") || continue
    TITLES[$i]="${t//[$'\t\n\r']/ }"
    [ -n "$ALBUM_ARTIST" ] && ARTISTS[$i]="$ALBUM_ARTIST"
  done < <(printf '%s\n' "$titles")

  [ "$n" -gt 0 ] || return 1
  META_SOURCE="MusicBrainz"
  return 0
}

# A mounted CD has no tags at all, so everything the panel shows has to come from
# somewhere else. Tried in order of trust, and whichever answers is recorded.
cd_metadata() {
  local i
  META_SOURCE="track numbers"
  # macOS numbers them "1 Audio Track.aiff"; make that a clean default first, so
  # a failure below still leaves a tidy list rather than filenames.
  i=0
  while [ "$i" -lt "${#TITLES[@]}" ]; do
    case "${TITLES[$i]}" in
      # Not printf -v: bash 3.2 will not write into an array element that way.
      *Audio\ Track*|*audio\ track*) TITLES[$i]=$(printf 'Track %02d' "${TRKNOS[$i]}") ;;
    esac
    i=$(( i + 1 ))
  done
  [ -z "$ALBUM" ] && ALBUM="$(basename "$SRC_PATH")"

  load_stage "READING DISC" 1 3 "looking for CD-Text"
  cd_text && return 0
  load_stage "READING DISC" 2 3 "asking MusicBrainz"
  mb_lookup && return 0
  load_stage "READING DISC" 3 3 "no titles on this disc"
  return 1
}

# ------------------------------------------------------------ now playing --

# The panel the app spends its life on. Three blocks under the faceplate: what
# the album is, what its tracks are, and where in them the playhead has got to.
#
# Two meters rather than one, because they answer different questions and each
# one is the wrong answer to the other's. The track bar is "how much of this song
# is left", which is what you want when you are deciding whether to skip. The
# album meter is burncd's capacity meter with the playhead on it — the tracks as
# bands, so you can see the shape of the record and where in that shape you are.
#
# Everything here is read out of the caller's locals. np_frame is called from
# inside the event loop, which is where all the state lives.
# How the columns between the track number and the duration are divided between
# the title and the artist — and whether there is an artist column at all.
#
# On an album there is not. Every row would carry the same name, and that name is
# already printed at the top of the panel under ARTIST: a column that repeats one
# fact fifty times is not a column, it is a margin with writing on it. Dropping it
# hands the title fifty-two columns instead of thirty-two, which is the difference
# between "Libet's all joyful camarad…" and the title the record actually has.
#
# On a compilation it is a real column, because there the artist changes per row
# and is the second thing you read. It is then sized to the longest name the
# record actually contains rather than to the worst case, so the titles still get
# whatever the names do not use.
#
# Either way it is decided once for the session and not per row, so the list
# stays a grid: this gives the titles the slack, it does not make the edges
# ragged.
NP_TITLE_W=32
NP_ARTIST_W=18
np_columns() {
  local k one='' first=1 same=1 max=0
  for k in "${ORDER[@]:-}"; do
    [ -n "$k" ] || continue
    if [ "$first" -eq 1 ]; then
      one=${ARTISTS[$k]:-}; first=0
    elif [ "${ARTISTS[$k]:-}" != "$one" ]; then
      same=0
    fi
    wcols "${ARTISTS[$k]:-}"
    [ "$WCOLS" -gt "$max" ] && max=$WCOLS
  done
  # One artist all the way down, and it is the one already on the faceplate. The
  # test is against ALBUM_ARTIST rather than just "they all agree", because a
  # record whose tracks say "Miles Davis Quintet" under an album credited to
  # "Miles Davis" is not repeating the header — it is saying something else, and
  # dropping the column would throw that away.
  if [ "$same" -eq 1 ] && { [ -z "$one" ] || [ "$one" = "$ALBUM_ARTIST" ]; }; then
    NP_ARTIST_W=0
    NP_TITLE_W=52
    return 0
  fi
  [ "$max" -gt 18 ] && max=18
  NP_ARTIST_W=$max
  NP_TITLE_W=$(( 50 - max ))
  return 0
}

np_frame() {
  local k i row body meta mark lbl art want lo hi
  local last=$(( np_top + np_rows ))

  printf -v meta '%s · %d TRACKS%s' "$mode_label" "${#ORDER[@]}" "$meta_tail"
  faceplate "$meta"
  printf '\n'
  printf '    %b%-8s%b %s\n' "$ETCH" ALBUM  "$OFF" "${ALBUM:-—}"
  printf '    %b%-8s%b %s\n' "$ETCH" ARTIST "$OFF" "${ALBUM_ARTIST:-—}"
  # Not the metadata source as well: the faceplate says where the titles came
  # from, and saying it twice on one screen reads like two different facts.
  printf '    %b%-8s%b %s\n' "$ETCH" SOURCE "$OFF" "$(fit "$SRC_LABEL" 52)"
  # What the shelf says, when this record is on it. The note is in amber and the
  # rest is plain, because the note is the half you wrote down yourself and the
  # only line here you cannot get from any other player.
  if [ "$COLL_HIT" -eq 1 ]; then
    [ -n "$COLL_SHELF" ] && printf '    %b%-8s%b %s\n' "$ETCH" SHELF "$OFF" \
      "$(fit "$COLL_SHELF" 52)"
    [ -n "$COLL_NOTES" ] && printf '    %b%-8s%b %b%s%b\n' "$ETCH" NOTE "$OFF" \
      "$AMBER" "$(fit "$COLL_NOTES" 52)" "$OFF"
  fi
  printf '\n'

  k=$np_top
  while [ "$k" -lt "$last" ] && [ "$k" -lt "${#ORDER[@]}" ]; do
    i=${ORDER[$k]}
    # Two different things are marked on this list and they are not the same
    # thing: ♪ is the track the music is coming out of, and the reverse bar with
    # burncd's ▶ in the gutter is the row the cursor is on. Usually they agree;
    # when you are browsing ahead they do not, and the panel has to be able to
    # say so — which is why the playing mark is not a second arrow.
    if [ "$k" -eq "$cur_track" ]; then
      if [ "$paused" = true ]; then mark='‖'; else mark='♪'; fi
    else
      mark=' '
    fi
    printf -v row '%02d' $(( k + 1 ))
    fitv "${TITLES[$i]}" "$NP_TITLE_W"; lbl=$FIT
    # The artist field carries its own leading gap, so that a record with no
    # artist column leaves no gap where one would have been — the title simply
    # runs on to where the artist used to start.
    if [ "$NP_ARTIST_W" -gt 0 ]; then
      fitv "${ARTISTS[$i]}" "$NP_ARTIST_W" right
      art="  $FIT"
    else
      art=''
    fi
    mmssv "${DURS[$i]}"
    if [ "$k" -eq "$np_cur" ]; then
      printf -v body '%s %s  %s%s  %5s' "$mark" "$row" "$lbl" "$art" "$MMSS"
      printf '  %b▶%b %b%s%b\n' "$AMBER" "$OFF" "$INV" "$body" "$OFF"
    else
      printf '    %b%s%b %b%s%b  %s%s  %b%5s%b\n' \
        "$AMBER" "$mark" "$OFF" "$ETCH" "$row" "$OFF" "$lbl" \
        "$art" "$ETCH" "$MMSS" "$OFF"
    fi
    k=$(( k + 1 ))
  done
  [ "$last" -lt "${#ORDER[@]}" ] && more_row $(( ${#ORDER[@]} - last ))

  # The track readout, and the bar for it. The label sits on the left and the
  # counter on the right, with the pad between them worked out from the finished
  # "0:00 / 0:00" string — the same arithmetic burncd's capacity meter uses, so
  # both readouts land on the same right-hand edge as the bars under them.
  printf '\n'
  mmssv "$pos";  lo=$MMSS
  mmssv "$tdur"; hi=$MMSS
  printf -v body 'TRACK %02d OF %02d' $(( cur_track + 1 )) "${#ORDER[@]}"
  printf -v want '%s / %s' "$lo" "$hi"
  pad $(( PANEL - ${#body} - ${#want} ))
  printf '  %b%s%b%s%b%s%b / %s\n' \
    "$ETCH" "$body" "$OFF" "$PAD" "$AMBER" "$lo" "$OFF" "$hi"
  trackbar "$pos" "$tdur"
  printf '  %b▐%b%b%b▌%b\n' "$ETCH" "$OFF" "$TRACKBAR" "$ETCH" "$OFF"

  # The album meter, with the playhead where it actually is across the whole
  # record rather than across this one song.
  printf '\n'
  mmssv "$apos";  lo=$MMSS
  mmssv "$TOTAL"; hi=$MMSS
  body=ALBUM
  printf -v want '%s / %s' "$lo" "$hi"
  pad $(( PANEL - ${#body} - ${#want} ))
  printf '  %b%s%b%s%b%s%b / %s\n' \
    "$ETCH" "$body" "$OFF" "$PAD" "$AMBER" "$lo" "$OFF" "$hi"
  bandbar "$ahead"
  printf '  %b▐%b%b%b▌%b\n' "$ETCH" "$OFF" "$BANDBAR" "$ETCH" "$OFF"

  # The analyser stands where burncd puts its minute scale, and says the one
  # thing no number on this panel says at a glance: what the music is doing.
  #
  # Its rows are left empty here and written over by np_draw, in the same write
  # that puts this frame on the screen. Two reasons, and the second one is why
  # it is worth the indirection:
  #
  # np_frame is run inside $( ) to be captured, which makes it a subshell, and a
  # subshell's writes to the column state would be thrown away with it — the
  # columns would fall back a frame every time the panel rebuilt.
  #
  # And the analyser is two thousand bytes of escapes and three-byte blocks. The
  # frame goes through two whole-string substitutions on its way to the screen,
  # and both of them walk multibyte text a character at a time: carrying the
  # analyser through them cost fifty milliseconds of every panel rebuild, which
  # is the best part of a tick, once a second, at exactly the moment the columns
  # were meant to move. Written straight to its rows instead, it costs one.
  i=0
  while [ "$i" -lt "$SPEC_ROWS" ]; do
    printf '  %b▐%b%s%b▌%b\n' "$ETCH" "$OFF" "$SPEC_BLANK" "$ETCH" "$OFF"
    i=$(( i + 1 ))
  done

  printf '\n'
  keys '␣' PLAY '←→' SEEK '↑↓' SELECT '⏎' JUMP N NEXT P PREV
  keys S SHUFFLE R REPEAT Q QUIT
  [ -n "$status" ] && printf '\n  %b%s%b\n' "$AMBER" "$status" "$OFF"
  return 0
}

# How many track rows fit. Counted rather than assumed, for the reason paint()
# sets out: \033[H is absolute, so a frame one row taller than the window scrolls
# the panel's top row away permanently and every frame after it homes to a row
# that holds something else.
np_fit_rows() {  # np_fit_rows <status> -> $NP_ROWS
  local budget
  term_size
  budget=$(( TERM_LINES - NP_CHROME - COLL_ROWS ))
  [ -n "$1" ] && budget=$(( budget - 2 ))
  [ "${#ORDER[@]}" -gt "$budget" ] && budget=$(( budget - 1 ))
  [ "$budget" -lt 1 ] && budget=1
  NP_ROWS=$budget
  return 0
}

# ------------------------------------------------------------------ engine --

# mpv, driven over its JSON IPC socket, holding the whole record at once.
#
# The playlist is mpv's, in the order the panel shows it, and every track is
# handed over before the first one has finished. That is the only arrangement in
# which mpv can read ahead into the next file while the current one is still
# playing, and reading ahead is the whole of gapless — a file opened at the
# moment the previous one ends is a file being opened during the silence.
#
# What that costs is that mpv now has an opinion about what comes next, and the
# panel used to be the only thing that did. The two are kept from disagreeing by
# having exactly one source of truth: mpv's playlist-pos. This program never
# assumes a track change, it asks for one and waits to be told — and a track that
# simply ran out arrives by the same route as one picked with the cursor. Shuffle
# and REPEAT ALBUM are still this program's ideas, applied by moving playlist-pos
# when mpv reports where it went by itself.
SOCK=''; CMDFIFO=''

engine_start() {
  local i
  scratch
  SOCK="$WORK/ipc.sock"
  CMDFIFO="$WORK/cmd"
  rm -f "$SOCK" "$CMDFIFO"
  mkfifo "$CMDFIFO" || die "cannot create the command pipe"

  # --idle so mpv survives the end of every track and waits to be told the next
  # one. --no-terminal so it never writes on the panel or steals a keystroke.
  # --gapless-audio=yes and --prefetch-playlist=yes are what make a record play
  # like a record. mpv's own default is "weak", which only bridges a boundary
  # when the two files agree on rate and channel layout — true of a clean rip and
  # not true of a folder with one track at 48k in it, which is exactly the album
  # you would notice the gap on. "yes" bridges it either way.
  #
  # The prefetch is the half that actually matters. Gapless is a promise mpv can
  # only keep about a file it has already opened, so without it the next track is
  # still being found at the moment the last sample of this one goes out, and the
  # seam is however long that took. burncd writes these discs disc-at-once so
  # there is no gap between tracks; playing them back with one is the same album
  # told wrong.
  mpv --no-video --idle=yes --no-terminal --no-config \
      --keep-open=no \
      --gapless-audio=yes --prefetch-playlist=yes \
      --input-ipc-server="$SOCK" >/dev/null 2>&1 &
  MPV_PID=$!

  for i in $(seq 1 40); do
    [ -S "$SOCK" ] && break
    sleep 0.1
  done
  [ -S "$SOCK" ] || die "mpv did not open its control socket"

  # Read-write rather than write-only. Opening a fifo for writing alone blocks
  # until something opens the read end, and the reader here is nc — which is not
  # started until the pipeline below, so a plain > would deadlock the app before
  # it drew a single frame.
  exec 3<>"$CMDFIFO"
  return 0
}

# One command to mpv. Everything the transport does goes through here.
mpv_cmd() { printf '%s\n' "$1" >&3; }

# ------------------------------------------------------------------- play --

# The event loop, and the whole of the running app.
#
# Three things happen at once and bash can block on exactly one of them, so all
# three are funnelled into a single stream of \r-terminated records and the loop
# below blocks on that:
#
#   \016      a tick, twenty a second: move the lamp, ask mpv where it is
#   K<key>    a keystroke, read off /dev/tty by a reader of its own
#   {...}     a line of JSON from mpv
#
# nc is the foreground member of the producer block on purpose. When mpv is told
# to quit, its socket closes, nc ends, the other two producers are killed and the
# pipe closes — which is what ends the loop. There is no other way out, and that
# is the point: one exit path, and it runs the teardown every time.
KEYMARK=$'\013'
SCAN_MARK=$'\016'

key_reader() {
  # /dev/tty explicitly: the reader's own stdin is the pipeline, and it must not
  # take a byte of it. Job control is off in a script, so this shares the shell's
  # process group and can read the terminal without earning a SIGTTIN.
  local k
  while read_key; do
    printf '%s%s\r' "$KEYMARK" "$KEY"
  done < /dev/tty
}

play() {
  local np_cur=0 np_top=0 np_rows=1 cur_track=0 status='' frame_no=0
  local pos=0 tdur=0 apos=0 ahead=0 paused=false
  local shuffle=0 repeat=0 mode_label=PLAYING meta_tail='' np_follow=1
  local rec key frame i last_pos=-1 last_draw='' drew=0
  local ptenth=0
  # asked distinguishes a move this loop asked for from one mpv made by itself at
  # the end of a track — the two look identical by the time they come back as a
  # property change, and shuffle has to tell them apart. started is what stops
  # mpv's opening "nothing is playing" from being read as the end of the record.
  local plpos=-1 asked=0 started=0
  # Whether anything is actually coming out of the deck, which is not the same
  # question as whether it is paused, and whether a track has failed to open --
  # which latches, because mpv answers an unreadable file by walking straight on
  # to the next one and a whole record can go past in a second that way.
  local cidle=false failed=0
  # How many frames this second has already had, so a backlog of ticks that
  # built up behind a terminal that stopped reading can be dropped rather than
  # drawn.
  local tick_sec=-1 tick_n=0
  # A seek waiting for the track it belongs to to actually be playing, and the
  # last whole second written to the resume file, so that writing it again is
  # cheap to decide against.
  local pend_seek=-1 saved_at=-1
  # A mouse report, taken apart.
  local mrep mend mb mx my mrest
  local -a DUR_BY_ROW PRE

  # The bands are the tracks of the album, fixed for the whole session, and only
  # the head moves — so they are worked out once here rather than per frame.
  DUR_BY_ROW=(); PRE=(); apos=0
  i=0
  while [ "$i" -lt "${#ORDER[@]}" ]; do
    DUR_BY_ROW[$i]=${DURS[${ORDER[$i]}]}
    PRE[$i]=$apos
    apos=$(( apos + DUR_BY_ROW[i] ))
    i=$(( i + 1 ))
  done
  apos=0
  if [ "${#DUR_BY_ROW[@]}" -gt 0 ]; then
    bands $(( STRIP_WIDTH * 8 )) "${DUR_BY_ROW[@]}"
  else
    bands 0
  fi
  # Same reasoning, and the same once: the track list's columns are a property of
  # the record, so they are measured here rather than on every frame.
  np_columns

  printf -v meta_tail ' · %s' "$META_SOURCE"

  tui_block
  mouse_on
  {
    key_reader & KR=$!
    while :; do printf '%s\r' "$SCAN_MARK"; sleep "$TICK"; done & TK=$!
    nc -U "$SOCK" < "$CMDFIFO" | while IFS= read -r l; do printf '%s\r' "$l"; done
    kill "$KR" "$TK" 2>/dev/null
  } | {
    # The rest of the script wants set -e; this loop does not. Half of what it
    # does is ask a question — is the cursor past the end, did the album run
    # out, is there a track before this one — and under set -e a "no" from a bare
    # test or a helper's return 1 would take the whole player down mid-song. The
    # right-hand side of a pipe is a subshell, so this stays inside the loop.
    set +e

    # And the same reason is why the window-size trap has to be set again here.
    # bash resets every trap it is not ignoring when it makes a subshell, so the
    # one screen_on installed does not exist on this side of the pipe — which is
    # the side that draws the panel. Without it term_size answers out of a cache
    # nothing ever invalidates, np_fit_rows budgets rows for the window the app
    # started in, and a window made shorter mid-album gets a frame taller than
    # it: every paint scrolls, \033[H starts addressing the wrong row, and the
    # panel is wrecked for the rest of the session.
    #
    # last_pos too, because clearing the size only takes effect on a redraw and
    # the tick below only redraws when a number changed. -1 is not a position
    # any track can be at, so the next tick rebuilds at the new size.
    trap 'TERM_LINES=; TERM_COLS=; last_pos=-1' WINCH

    # Observed rather than polled: these change rarely and mpv volunteers them.
    # time-pos is observed too — mpv throttles it to about eighteen a second,
    # which is under the redraw budget and saves a round trip per frame.
    mpv_cmd '{"command":["observe_property",1,"time-pos"]}'
    mpv_cmd '{"command":["observe_property",2,"pause"]}'
    mpv_cmd '{"command":["observe_property",3,"duration"]}'
    # Which track is playing is mpv's answer now, not this loop's assumption.
    # Everything that moves the record — the n key, a row picked with enter,
    # shuffle, and a track simply running out — arrives back here as a change to
    # this one property, and there is exactly one piece of code that acts on it.
    mpv_cmd '{"command":["observe_property",4,"playlist-pos"]}'
    # Whether sound is coming out. The analyser is drawn from this rather than
    # from pause, so that a record which has finished, or one whose next track
    # will not open, shows a deck at rest instead of columns dancing to nothing.
    mpv_cmd '{"command":["observe_property",5,"core-idle"]}'
    playlist_build

    while IFS= read -r -d $'\r' rec || [ -n "$rec" ]; do
      case "$rec" in

        "$SCAN_MARK")
          # A tick that has been sitting in the pipe is a tick about a moment
          # that has already gone. Nothing throttles the generator: it writes
          # one every fiftieth of a second whether or not anything has read the
          # last, and a terminal is free to stop draining -- a window behind
          # another window on macOS is drained slowly enough that a second of
          # frames does not fit through it. The ticks then queue instead of
          # being lost, and when the window comes forward the panel replays
          # every frame it missed, one at a time, racing the meters up to where
          # the music already is. That is the lag you can watch catching up.
          #
          # So the frames are rationed against the clock rather than against the
          # queue: past the tick rate in any one second, the surplus goes on the
          # floor. Draining a backlog then costs a case and two additions each
          # instead of a rendered frame, and the panel arrives at the truth in
          # the time it takes to read the pipe rather than in the time it took
          # to fall behind. SECONDS is a builtin, so this asks the clock without
          # starting a process twenty times a second to do it.
          if [ "$SECONDS" != "$tick_sec" ]; then tick_sec=$SECONDS; tick_n=0; fi
          tick_n=$(( tick_n + 1 ))
          [ "$tick_n" -gt "$TICK_HZ" ] && continue
          frame_no=$(( frame_no + 1 ))
          # Advanced before anything is drawn and outside the two branches
          # below, so the columns move at the tick's rate whether this frame
          # rebuilds the panel or only repaints the analyser.
          # Rendered here too, not just advanced, so that both branches below —
          # the panel rebuild and the analyser-only repaint — print the same
          # rows without either of them building them twice.
          [ "$cidle" != true ] && { spec_advance "$frame_no"; spec_render; }
          # A whole frame twenty times over to advance one digit is nineteen
          # redraws wasted. The panel is rebuilt when a number on it changed;
          # every other tick repaints the analyser's rows alone, in place.
          if [ "$pos" != "$last_pos" ]; then
            last_pos=$pos
            np_draw
          elif [ "$drew" -eq 1 ] && [ "$cidle" != true ] && [ "$spec_row" -gt 0 ]; then
            spec_str
            printf '%b' "$SPECSTR"
          fi
          continue
          ;;

        "$KEYMARK"*)
          key=${rec#"$KEYMARK"}
          case "$key" in
            ' ')            mpv_cmd '{"command":["cycle","pause"]}' ;;
            $'\033[D'|h)    mpv_cmd '{"command":["seek",-5,"relative"]}' ;;
            $'\033[C'|l)    mpv_cmd '{"command":["seek",5,"relative"]}' ;;
            $'\033[1;2D')   mpv_cmd '{"command":["seek",-30,"relative"]}' ;;
            $'\033[1;2C')   mpv_cmd '{"command":["seek",30,"relative"]}' ;;
            # Moving the cursor is browsing, and browsing means the cursor stops
            # chasing the music until you pick something with it again.
            $'\033[A'|k)    np_cur=$(( np_cur - 1 )); np_clamp; np_follow=0 ;;
            $'\033[B'|j)    np_cur=$(( np_cur + 1 )); np_clamp; np_follow=0 ;;
            $'\033[5~')     np_cur=$(( np_cur - np_rows )); np_clamp; np_follow=0 ;;
            $'\033[6~')     np_cur=$(( np_cur + np_rows )); np_clamp; np_follow=0 ;;
            $'\n'|$'\r')    np_follow=1; load_track "$np_cur" ;;
            n|N)            np_follow=1; next_track; np_cur=$cur_track ;;
            p|P)            np_follow=1; prev_track; np_cur=$cur_track ;;
            s|S)            shuffle=$(( 1 - shuffle ))
                            status="▪ SHUFFLE $( [ "$shuffle" -eq 1 ] && printf ON || printf OFF )" ;;
            r|R)            repeat=$(( (repeat + 1) % 3 ))
                            # REPEAT TRACK is mpv's own loop-file rather than a
                            # reload when the track ends: a track told to start
                            # again after it has already finished is a file being
                            # opened during the silence, which is the gap this
                            # whole arrangement exists to avoid. REPEAT ALBUM
                            # stays ours — album_ended has to ask shuffle what
                            # comes next, and mpv's loop-playlist would not.
                            case $repeat in
                              0) mpv_cmd '{"command":["set_property","loop-file","no"]}'
                                 status='▪ REPEAT OFF' ;;
                              1) mpv_cmd '{"command":["set_property","loop-file","no"]}'
                                 status='▪ REPEAT ALBUM' ;;
                              2) mpv_cmd '{"command":["set_property","loop-file","inf"]}'
                                 status='▪ REPEAT TRACK' ;;
                            esac ;;
            u|U)            [ "$RESUME_ROW" -ge 0 ] || continue
                            # The seek cannot go out with the track change. mpv
                            # moves playlist-pos before it has opened the file,
                            # and a seek into a file that is not yet playing is
                            # a seek into the one that still is. Left pending and
                            # spent on the first time-pos of the new track, which
                            # is a thing mpv only sends once it is really there.
                            np_follow=1
                            pend_seek=$RESUME_POS
                            load_track "$RESUME_ROW"
                            RESUME_ROW=-1 ;;
            q|Q)            mpv_cmd '{"command":["quit"]}' ;;
            # A mouse report, in the SGR form asked for by mouse_on:
            # ESC [ < button ; column ; row M for a press or a drag, m for a
            # release. read_key already brings these in whole — it runs a CSI
            # sequence to its first letter, and M and m are letters.
            #
            # Taken apart with substitutions rather than a regex because this is
            # in the event loop and a drag delivers one of these per pixel row
            # the pointer crosses. Each field is checked on its own: a truncated
            # report would otherwise leave a field empty, and an empty one goes
            # into the arithmetic below as a zero rather than as a mistake.
            $'\033[<'*)     mrep=${key:3}
                            mend=${mrep: -1}; mrep=${mrep%?}
                            IFS=';' read -r mb mx my mrest <<< "$mrep"
                            case "$mb" in ''|*[!0-9]*) continue ;; esac
                            case "$mx" in ''|*[!0-9]*) continue ;; esac
                            case "$my" in ''|*[!0-9]*) continue ;; esac
                            mouse_at "$mb" "$mx" "$my" "$mend" || continue ;;
            *)              continue ;;
          esac
          np_draw
          continue
          ;;

        '{'*)
          case "$rec" in
            *'"name":"time-pos"'*)
              if [[ "$rec" =~ \"data\":([0-9]+)\.?([0-9]*) ]]; then
                pos="${BASH_REMATCH[1]}"
                # The readouts want whole seconds; the analyser's table has ten
                # rows to the second, so the first decimal has to survive too.
                ptenth="${BASH_REMATCH[2]:0:1}"
                [ -z "$ptenth" ] && ptenth=0
                if [ "$pend_seek" -ge 0 ]; then
                  # The track is genuinely playing now — this is the first thing
                  # mpv says that proves it — so the resume seek can be spent.
                  # Cleared before it is sent, because the seek itself comes
                  # straight back through here as another time-pos.
                  i=$pend_seek
                  pend_seek=-1
                  mpv_cmd "{\"command\":[\"seek\",$i,\"absolute\"]}"
                # Five seconds rather than every one of them: a file write a
                # second for the length of a record is a lot of writing to save a
                # number that is only ever read once, and five seconds is inside
                # the margin of where you would say you had got to anyway.
                elif [ "$pos" -ge $(( saved_at + 5 )) ] || [ "$pos" -le $(( saved_at - 5 )) ]; then
                  saved_at=$pos
                  resume_save "$cur_track" "$pos"
                fi
              fi ;;
            *'"name":"duration"'*)
              if [[ "$rec" =~ \"data\":([0-9]+)\.?([0-9]*) ]]; then
                tdur="${BASH_REMATCH[1]}"
              fi ;;
            *'"name":"pause"'*)
              [[ "$rec" =~ \"data\":(true|false) ]] && paused="${BASH_REMATCH[1]}"
              # The pause a failure puts on is not the pause the space bar puts
              # on, and the faceplate should not claim otherwise.
              [ "$failed" -eq 1 ] \
                || mode_label=$( [ "$paused" = true ] && printf PAUSED || printf PLAYING )
              np_draw ;;
            *'"name":"core-idle"'*)
              # Only read. Nothing is redrawn off it, because it goes true for a
              # fraction of a second at every gapless seam and a redraw there
              # would put a stutter into the one place this player exists to
              # keep smooth. The next tick picks it up.
              [[ "$rec" =~ \"data\":(true|false) ]] && cidle="${BASH_REMATCH[1]}" ;;
            *'"name":"playlist-pos"'*)
              # The one place a track change is acted on, whatever caused it.
              if [[ "$rec" =~ \"data\":(-?[0-9]+) ]]; then
                plpos="${BASH_REMATCH[1]}"
                if [ "$plpos" -lt 0 ]; then
                  # -1 is also what mpv says while it is idle with nothing loaded,
                  # which it says once at startup before the first entry has been
                  # appended. Only a -1 that comes after something has actually
                  # played is the end of the record; the opening one is not the
                  # album finishing before it began.
                  # And a record that stopped because its files would not open
                  # has not finished either, whatever mpv fell off the end of.
                  [ "$started" -eq 1 ] && [ "$failed" -eq 0 ] && album_ended
                elif [ "$failed" -eq 1 ]; then
                  # mpv is still walking off the entries behind a failure. The
                  # panel stays on the track that actually stopped, because that
                  # is the one worth telling you about.
                  :
                elif [ "$started" -eq 0 ]; then
                  # The first track of the session is taken as it comes. It is
                  # nobody's idea of an advance — nothing has played yet for it
                  # to be following — and sending it through shuffle would jump
                  # off the opening track before a note of it was out.
                  started=1
                  asked=0
                  enter_track "$plpos"
                  # After enter_track, not before: starting a track clears the
                  # status line, and the offer is the one thing on it that has to
                  # outlive the track starting.
                  if [ "$RESUME_ROW" -ge 0 ]; then
                    status="▪ RESUME AT ${TRKNOS[${ORDER[$RESUME_ROW]}]} · $(mmss "$RESUME_POS") — PRESS U"
                    np_draw
                  fi
                elif [ "$asked" -eq 1 ]; then
                  # A move this loop asked for is the move it asked for, and is
                  # not put back through shuffle.
                  asked=0
                  enter_track "$plpos"
                else
                  auto_advanced "$plpos"
                fi
              fi ;;
            # A file that ended because it finished is not handled here: mpv
            # walks on to the next entry by itself, and acting on that as well
            # would advance the record twice for every track that played. A file
            # that ended because it would not open is another matter entirely.
            *'"event":"end-file"'*)
              case "$rec" in
                *'"reason":"error"'*) track_failed "$rec" ;;
              esac ;;
          esac
          continue
          ;;
      esac
    done
  } || true
  # || true because quitting is the normal way out and it is not a clean exit
  # anywhere in that pipeline: q tells mpv to quit, mpv drops the socket, nc ends
  # on a broken connection, and pipefail hands the whole pipeline nc's opinion of
  # that. Getting to here means the loop ended, which is all this needs to know.
  tui_cooked
  return 0
}

# ------------------------------------------------------- the loop's helpers --

# All of these are called from inside the event loop and read and write its
# locals. bash scopes dynamically, which is what makes that work and what keeps
# the loop itself short enough to read in one go.

np_clamp() {
  [ "$np_cur" -lt 0 ] && np_cur=0
  [ "$np_cur" -ge "${#ORDER[@]}" ] && np_cur=$(( ${#ORDER[@]} - 1 ))
  return 0
}

# Move the columns on by one frame, from the table if there is one and from the
# waves if there is not. Called once per tick and nowhere else, so that the
# trails fall at a rate tied to the clock rather than to how often the panel
# happens to be rebuilt.
spec_advance() {  # spec_advance <frame>
  local idx
  local IFS=$' \t\n'
  # The table arrives partway through a track, so this keeps asking until it
  # does. Both tests are builtins — no process is started per frame to find out.
  if [ "$SPEC_FOR" -ne "$cur_track" ]; then
    spectrum_load "$cur_track" || { spec_synth "$1"; return 0; }
  fi
  idx=$(( pos * SPEC_HZ + ptenth ))
  [ "$idx" -lt 0 ] && idx=0
  [ "$idx" -ge "$SPEC_N" ] && idx=$(( SPEC_N - 1 ))
  # Word-splitting the row into sixteen arguments: no fork, and no subshell to
  # lose the column state in.
  set -- ${SPEC[$idx]}
  spec_step "$@"
  return 0
}

# Where the analyser's top row is on the screen, so a tick can address it
# outright instead of redrawing the whole panel to move a column.
spec_row=0
np_draw() {
  local frame nls
  [ "$SCREEN" -eq 1 ] || return 0
  np_fit_rows "$status"
  np_rows=$NP_ROWS
  [ "$np_cur" -lt "$np_top" ] && np_top=$np_cur
  [ "$np_cur" -ge $(( np_top + np_rows )) ] && np_top=$(( np_cur - np_rows + 1 ))
  [ "$np_top" -lt 0 ] && np_top=0

  # Where the playhead is across the whole record: everything before this track,
  # plus how far into it we are.
  apos=$(( ${PRE[$cur_track]:-0} + pos ))
  [ "$apos" -gt "$TOTAL" ] && apos=$TOTAL
  ahead=0
  [ "$TOTAL" -gt 0 ] && ahead=$(( apos * STRIP_WIDTH * 8 / TOTAL ))

  frame=$(np_frame)
  # Where the analyser ended up, so a tick can address those rows outright
  # instead of rebuilding the panel to move a column.
  #
  # Counted off the finished frame rather than from a constant, because the track
  # list and the status line both change the panel's height. $( ) strips the
  # trailing newline, so the frame holds one fewer newline than it has lines;
  # what follows the analyser is fixed — a blank and two keycap rows, plus a
  # blank and the status line when there is one — and the analyser's own rows
  # come off the total to get back to the first of them.
  #
  # Counted by doubling the newlines and taking the difference in length, which
  # looks like the long way round and is not: deleting everything that is not a
  # newline means a negated bracket class, and bash matches one of those a
  # character at a time through the multibyte machinery. On a panel this size
  # that is a third of a second, once a second, with the event loop stopped dead
  # behind it — the lamp froze and then jumped. Substituting a plain newline is a
  # literal match and costs about seven milliseconds.
  nls=${frame//$'\n'/$'\n\n'}
  spec_row=$(( ${#nls} - ${#frame} + 1 - 3 - (SPEC_ROWS - 1) ))
  [ -n "$status" ] && spec_row=$(( spec_row - 2 ))
  # Counted first, so the analyser knows its rows before the frame is painted
  # and both can go out in one write.
  [ "${#SPECROWS[@]}" -eq 0 ] && spec_render   # the first frame of all
  # After spec_row, because the sleeve's height is bounded by where the analyser
  # starts, and before the paint that both of them go out in.
  art_tick
  spec_str
  paint "$frame" "$SPECSTR$ART_STR"
  drew=1
  return 0
}

# The cover as one string of cursor moves and half blocks, addressed to the empty
# column beside the panel.
#
# Built as a string and emitted inside the same write as the panel, for the same
# reason the analyser is: the paint that draws a frame ends every line with an
# erase-to-end-of-line, which wipes everything to the right of the panel as it
# goes. A cover printed after that write would be visibly absent for as long as
# the terminal took to get between the two, once a second, for the whole record.
#
# The 256-colour fallback is not a plain nearest neighbour over the cube. That
# palette is a coarse 6×6×6 cube with a fine 24-step grey ramp beside it, and a
# nearly-grey pixel is quantised far better by the ramp than by the cube — which
# is precisely the case of a black and white sleeve, where the cube alone bands it
# into steps you can count. So each pixel is offered to both and takes whichever
# lands closer, with a saturation guard so that a colour with any real chroma in
# it is never dragged into the greys.
#
# No dithering. It was tried, at three amplitudes, and every one of them read as
# visible checkerboard noise rather than as smoother colour — because the thing
# being dithered here is not a pixel but a whole character cell, and at 32 cells
# across there is nowhere for the error to hide.
art_render() {  # art_render <cols> <rows>
  local w=$1 h=$2 tc=0
  case "${COLORTERM:-}" in truecolor|24bit) tc=1 ;; esac
  ART_STR=$(
    ffmpeg -v error -nostdin -i "$ART_FILE" \
        -vf "scale=$w:$(( h * 2 )):flags=bilinear,format=rgb24" \
        -f rawvideo -pix_fmt rgb24 - 2>/dev/null \
      | od -An -tu1 -v \
      | awk -v w="$w" -v h="$h" -v r0="$ART_ROW0" -v c0="$ART_COL0" -v tc="$tc" '
        BEGIN {
          split("0 95 135 175 215 255", LV, " ")     # the six levels of the cube
          for (g = 0; g < 24; g++) GR[g] = 8 + g * 10
        }
        # Every working variable here is declared as an extra parameter, because
        # awk has no other way to make one local — and a stray global in this
        # file would be shared with the pixel counter below.
        function near(v,   best, bd, k, d) {
          best = 0; bd = 1e9
          for (k = 1; k <= 6; k++) { d = v - LV[k]; if (d < 0) d = -d
            if (d < bd) { bd = d; best = k - 1 } }
          return best
        }
        function idx256(r, g, b,   cr, cg, cb, dc, gi, gv, dg, mx, mn) {
          cr = near(r); cg = near(g); cb = near(b)
          dc = (r-LV[cr+1])^2 + (g-LV[cg+1])^2 + (b-LV[cb+1])^2
          mx = r; if (g > mx) mx = g; if (b > mx) mx = b
          mn = r; if (g < mn) mn = g; if (b < mn) mn = b
          if (mx - mn > 20) return 16 + 36*cr + 6*cg + cb   # too coloured to be grey
          gi = int(((r + g + b) / 3 - 8) / 10 + 0.5)
          if (gi < 0) gi = 0; if (gi > 23) gi = 23
          gv = GR[gi]
          dg = (r-gv)^2 + (g-gv)^2 + (b-gv)^2
          if (dg < dc) return 232 + gi
          return 16 + 36*cr + 6*cg + cb
        }
        { for (i = 1; i <= NF; i++) P[n++] = $i }
        function sgr(kind, x, y,   o, r, g, b) {
          o = (y * w + x) * 3; r = P[o]; g = P[o+1]; b = P[o+2]
          if (tc == 1) return sprintf("\033[%d;2;%d;%d;%dm", kind, r, g, b)
          return sprintf("\033[%d;5;%dm", kind, idx256(r, g, b))
        }
        END {
          # A short read means ffmpeg could not decode it. Drawing what did
          # arrive would put a black square beside the panel, which is a worse
          # answer than no sleeve at all.
          if (n < w * h * 6) exit
          out = ""
          for (ry = 0; ry < h; ry++) {
            out = out sprintf("\033[%d;%dH", r0 + ry, c0)
            # Colour changes are what this costs, not characters: the two SGRs
            # for a cell are twelve times the size of the cell itself, and a
            # sleeve has long runs that do not change. Only emit one when it
            # actually differs from the one already in force.
            pf = ""; pb = ""
            for (x = 0; x < w; x++) {
              fg = sgr(38, x, ry * 2); bg = sgr(48, x, ry * 2 + 1)
              if (fg != pf) { out = out fg; pf = fg }
              if (bg != pb) { out = out bg; pb = bg }
              out = out "\342\226\200"                     # U+2580 UPPER HALF BLOCK
            }
            out = out "\033[0m"
          }
          printf "%s", out
        }'
  ) || { ART_STR=''; return 1; }
  [ -n "$ART_STR" ] || return 1
  return 0
}

# Whether there is a cover to draw yet, how big it can be, and — the once it
# matters — drawing it.
#
# Called from every panel rebuild, which is about once a second, because the fetch
# runs in the background and there is no other moment at which to notice that it
# finished. What that costs on the frames where nothing has changed is one stat
# and some arithmetic; the render itself happens once.
#
# The height is bounded by where the analyser starts. On a tall window that bound
# never binds, but on a short one the analyser's rows would otherwise sit under
# the bottom of the sleeve — and the analyser repaints its own rows nineteen times
# a second with an erase-to-end-of-line on each, which would strobe a hole through
# the picture. Keeping the sleeve above it means the only thing that ever erases
# the cover is the full rebuild that redraws it in the same write.
art_tick() {
  local w h avail cap g
  [ -n "$ART_FILE" ] || return 0
  [ "$spec_row" -gt 0 ] || return 0
  term_size
  avail=$(( TERM_COLS - ART_COL0 + 1 ))
  w=$avail
  [ "$w" -gt 32 ] && w=32
  # Two pixel rows to a cell and a cell twice as tall as it is wide, so a square
  # cover is twice as many columns as rows.
  h=$(( w / 2 ))
  cap=$(( spec_row - ART_ROW0 ))
  [ "$h" -gt "$cap" ] && h=$cap
  w=$(( h * 2 ))
  if [ "$w" -lt 12 ] || [ "$w" -gt "$avail" ]; then
    ART_STR=''; ART_COLS=0; ART_ROWS=0; ART_GEOM=''
    return 0
  fi
  g="$w.$h"
  # A window that changed shape needs the picture resampled, not merely moved.
  [ "$g" != "$ART_GEOM" ] && { ART_GEOM=$g; ART_STR=''; }
  [ -n "$ART_STR" ] && return 0
  [ -s "$ART_FILE" ] || return 0
  if art_render "$w" "$h"; then
    ART_COLS=$w; ART_ROWS=$h
  else
    # A cache entry that will not decode is one that will not decode next second
    # either, so stop asking. It is cleared rather than deleted: another player
    # may be part way through writing it.
    ART_COLS=0; ART_ROWS=0; ART_FILE=''
  fi
  return 0
}

# What is under the pointer, and what that means.
#
# The panel's height is not fixed — the track list grows into the window, the
# shelf lines come and go with the record, the status line appears and clears —
# so none of these rows can be a constant. They are all counted off spec_row,
# which np_draw has already worked out from the finished frame, and off the
# header block, whose only variable part is the shelf. Reading the geometry from
# the same two facts the drawing uses means the pointer cannot drift out of
# agreement with what is actually on the screen.
#
# Relative to the analyser's first row, walking back up np_frame: the album meter
# is one above it, its label two, a blank three, and the track meter four.
mouse_at() {  # mouse_at <button> <col> <row> <M-or-m>
  local b=$1 x=$2 y=$3 e=$4 j k first
  [ "$e" = M ] || return 1          # releases say nothing a press has not said
  [ "$spec_row" -gt 0 ] || return 1

  # The wheel is not a button, whatever the encoding says. Over a panel whose
  # one long list is the track list, scrolling means the same as the arrow keys.
  case "$b" in
    64) np_cur=$(( np_cur - 1 )); np_clamp; np_follow=0; return 0 ;;
    65) np_cur=$(( np_cur + 1 )); np_clamp; np_follow=0; return 0 ;;
  esac
  # Left button only, pressed (0) or dragged (32). Middle and right have no
  # meaning here, and answering them with a seek would be a nasty surprise.
  [ "$b" -eq 0 ] || [ "$b" -eq 32 ] || return 1

  # The meters. Both are drawn as two spaces, a bezel, $STRIP_WIDTH cells and the
  # far bezel, so the first cell is column four and cell j is column 4 + j.
  j=$(( x - 4 ))
  if [ "$j" -ge 0 ] && [ "$j" -lt "$STRIP_WIDTH" ]; then
    if [ "$y" -eq $(( spec_row - 1 )) ]; then
      album_seek $(( j * TOTAL / STRIP_WIDTH )) $(( b == 32 )) || return 1
      return 0
    fi
    if [ "$y" -eq $(( spec_row - 4 )) ] && [ "$tdur" -gt 0 ]; then
      mpv_cmd "{\"command\":[\"seek\",$(( j * tdur / STRIP_WIDTH )),\"absolute\"]}"
      return 0
    fi
  fi

  # The track list. Five fixed header lines, the shelf lines when the record is
  # on it, and the blank under them.
  #
  # A drag across the list is not a series of choices, so only a press counts
  # here. And a press selects rather than plays: the first click moves the cursor
  # and the second one on the same row starts it, which is the difference between
  # reading the list with the pointer and being made to listen to whatever the
  # pointer happened to land on.
  [ "$b" -eq 0 ] || return 1
  first=$(( 7 + COLL_ROWS ))
  k=$(( y - first ))
  if [ "$k" -ge 0 ] && [ "$k" -lt "$np_rows" ] \
     && [ $(( np_top + k )) -lt "${#ORDER[@]}" ]; then
    k=$(( np_top + k ))
    if [ "$k" -eq "$np_cur" ]; then
      np_follow=1
      load_track "$k"
    else
      np_cur=$k
      np_clamp
      np_follow=0
    fi
    return 0
  fi
  return 1
}

# The whole record handed over at once, in the order the panel shows it, so that
# the row a track sits on and its number in mpv's playlist are the same integer.
# That identity is the reason the rest of this is short: the panel can follow the
# music by watching one property instead of driving it a file at a time.
#
# append-play rather than append, because the first entry to land is the one that
# starts the record and every one after it queues behind what is already playing.
# Handing mpv the list in advance is also the only way the prefetch has anything
# to prefetch — a file asked for at the moment the previous one ends is a file
# being opened during the silence you were trying not to have.
playlist_build() {
  local i f
  mpv_cmd '{"command":["playlist-clear"]}'
  i=0
  while [ "$i" -lt "${#ORDER[@]}" ]; do
    f=${FILES[${ORDER[$i]}]}
    # JSON, so the path has to survive being one. Backslashes first, then quotes,
    # or the escaping of the quotes gets escaped in turn.
    f=${f//\\/\\\\}
    f=${f//\"/\\\"}
    mpv_cmd "{\"command\":[\"loadfile\",\"$f\",\"append-play\"]}"
    i=$(( i + 1 ))
  done
  return 0
}

# Ask for a row. Nothing on the panel moves here: mpv answers by moving
# playlist-pos, and enter_track — which is listening for that anyway, because a
# track running out moves it too — does the work. One path in and out of a track
# change, so a track started by hand and a track started by the record itself
# cannot come to disagree about what is playing.
load_track() {  # load_track <row>
  [ "$1" -ge 0 ] && [ "$1" -lt "${#ORDER[@]}" ] || return 1
  # Asking for a track by hand is how you say you want the deck running again,
  # so it clears a failure and takes off the pause that failure put on. Without
  # the unpause, picking another track after a bad one looks like a second
  # failure: the row changes and nothing plays.
  if [ "$failed" -eq 1 ]; then
    failed=0
    mpv_cmd '{"command":["set_property","pause",false]}'
  fi
  asked=1
  mpv_cmd "{\"command\":[\"set_property\",\"playlist-pos\",$1]}"
  return 0
}

# mpv could not open a file. Its answer is to walk straight on to the next entry,
# which for a record whose tracks have all become unreadable means fifty failures
# in about two seconds, playlist-pos falling off the end, and a panel that says
# END OF ALBUM — the same thing it says when a record has simply finished. The
# difference between "you have heard this" and "this is gone" is the whole of
# what the panel is for, so the first failure stops the record where it stands.
#
# The file is looked at rather than guessed about, because the interesting case
# is not a bad rip: it is a whole unpacked album disappearing underneath itself.
# That is why scratch() no longer puts one in $TMPDIR — but a disk can still fill
# and a directory can still be deleted by hand, and "the tracks are gone" is a
# far more useful thing to be told than "the track would not play". It is also
# the one that says what to do about it.
# Which row is the failing one is not worth guessing at — mpv names no file in
# the event, and whether the move to the entry that failed has come back through
# playlist-pos yet is a matter of which order two messages happened to arrive in.
# So the whole record is counted instead. It is fifty stats on a path that only
# runs when something has already gone wrong.
track_failed() {  # track_failed <the end-file record>
  local i gone=0 what=''
  [ "$failed" -eq 0 ] || return 0
  failed=1
  mpv_cmd '{"command":["set_property","pause",true]}'
  # Not PAUSED, which is a deck waiting for you. This one is not waiting.
  mode_label=STOPPED
  for i in "${ORDER[@]:-}"; do
    [ -n "$i" ] || continue
    [ -f "${FILES[$i]}" ] || gone=$(( gone + 1 ))
  done
  if [ "$gone" -gt 0 ]; then
    status="▪ $gone OF ${#ORDER[@]} TRACKS ARE NO LONGER ON DISK"
    if [ -n "$WORK" ] && [ "$SRC_KIND" = zip ]; then
      status="$status — THE UNPACKED COPY IS GONE. Q, THEN PLAY IT AGAIN"
    else
      status="$status — STOPPED HERE"
    fi
  else
    [[ "$1" =~ \"file_error\":\"([^\"]*)\" ]] && what=" · ${BASH_REMATCH[1]}"
    status="▪ CANNOT READ THIS TRACK$what — STOPPED HERE, ⏎ TO TRY ANOTHER"
  fi
  np_draw
  return 0
}

# A point on the album meter, as somewhere to actually put the needle.
#
# The meter is the whole record, so a position on it is not a position in a file
# — it names a track and an offset into that track, and landing on it may mean
# changing tracks first. PRE is the running total of everything before each row,
# so the row wanted is the last one that starts at or before the target.
#
# Within the track already playing this is a plain seek. Anywhere else it is a
# track change with the offset left pending, for the same reason the resume key
# leaves one: mpv moves playlist-pos before the new file is open, and a seek sent
# alongside the move lands in the track being left rather than the one arriving.
# The second argument is what a drag passes, and it means "only if this lands in
# the track already playing". A drag reports a position for every cell the
# pointer crosses, so without it one sweep of the meter would ask for a track
# change per band it went over — and the loop can only have one such request
# outstanding at a time. asked is a flag, not a queue: the reply to the second
# request would arrive with the flag already spent and be read as the record
# advancing on its own, which under shuffle means jumping somewhere nobody asked
# for. So a drag scrubs inside the current track, where every position is a plain
# seek and none of that arises, and a press is what moves between tracks.
album_seek() {  # album_seek <album-seconds> [same-track-only]
  local t=$1 r=0 n=${#ORDER[@]}
  [ "$n" -gt 0 ] && [ "$TOTAL" -gt 0 ] || return 1
  [ "$t" -lt 0 ] && t=0
  [ "$t" -ge "$TOTAL" ] && t=$(( TOTAL - 1 ))
  while [ $(( r + 1 )) -lt "$n" ] && [ "${PRE[$(( r + 1 ))]}" -le "$t" ]; do
    r=$(( r + 1 ))
  done
  t=$(( t - PRE[r] ))
  [ "$t" -lt 0 ] && t=0
  if [ "$r" -eq "$cur_track" ]; then
    mpv_cmd "{\"command\":[\"seek\",$t,\"absolute\"]}"
  else
    [ "${2:-0}" -eq 1 ] && return 1
    # Pointing at a track is choosing it, so the cursor goes back to following
    # the music — the same thing pressing Return on a row does.
    np_follow=1
    pend_seek=$t
    load_track "$r"
  fi
  return 0
}

# A row became the one playing. Everything the panel was saying was about the
# track before it, and this is where that is put right.
enter_track() {  # enter_track <row>
  local i
  [ "$1" -ge 0 ] && [ "$1" -lt "${#ORDER[@]}" ] || return 1
  cur_track=$1
  i=${ORDER[$cur_track]}
  pos=0
  ptenth=0
  tdur=${DURS[$i]}
  last_pos=-1
  # This track's levels if they are not already being worked out, and the next
  # one's as well: analysing a track takes a few seconds and a track lasts
  # minutes, so asking one ahead means the analyser is live from the first note
  # of everything except whatever you started with.
  spectrum_want "$cur_track"
  spectrum_want $(( cur_track + 1 ))
  # The columns belong to the track that just ended, and starting the next one
  # at whatever height that one finished at reads as a glitch.
  spec_reset
  # Where the record is now, written down before a note of the new track has
  # played, so that quitting between tracks still comes back to the right one.
  # saved_at moves with it, so the periodic write below has a truth to compare to
  # rather than the last track's second count.
  saved_at=0
  resume_save "$cur_track" 0
  # Whatever the panel was saying was about the track before this one -- including
  # "end of album", which a track starting has just made untrue.
  status=''
  mode_label=$( [ "$paused" = true ] && printf PAUSED || printf PLAYING )
  # The cursor follows the music unless you have gone off browsing on your own.
  # Here rather than in a caller, because a track that started on its own has to
  # move the cursor exactly as one started by hand does.
  if [ "$np_follow" -eq 1 ] && [ "$np_cur" -ne "$cur_track" ]; then
    np_cur=$cur_track
    np_clamp
  fi
  np_draw
  return 0
}

# The next row to play, which is not the same question as the next row down.
next_track() {
  local n
  # Under REPEAT TRACK, "next" is this one from the top — asked for as a seek
  # rather than as a move, because setting playlist-pos to the row it is already
  # on is a no-op and the track would just carry on playing.
  if [ "$repeat" -eq 2 ]; then
    mpv_cmd '{"command":["seek",0,"absolute"]}'
    return 0
  fi
  if [ "$shuffle" -eq 1 ] && [ "${#ORDER[@]}" -gt 1 ]; then
    # A different track, chosen without a fork: $RANDOM is a builtin.
    n=$cur_track
    while [ "$n" -eq "$cur_track" ]; do n=$(( RANDOM % ${#ORDER[@]} )); done
    load_track "$n"; return 0
  fi
  n=$(( cur_track + 1 ))
  if [ "$n" -ge "${#ORDER[@]}" ]; then
    if [ "$repeat" -eq 1 ]; then n=0; else return 1; fi
  fi
  load_track "$n"
  return 0
}

# Chosen for us: mpv has just walked on to the next entry by itself. Sequential
# play is already right and already gapless, so the only thing worth interrupting
# is shuffle — and interrupting it costs the seam, which is the trade shuffle
# makes by its nature anyway.
auto_advanced() {  # auto_advanced <row mpv moved to>
  local n
  if [ "$shuffle" -eq 1 ] && [ "${#ORDER[@]}" -gt 1 ]; then
    # Anything but the track that just played. The row mpv moved to is the wrong
    # one to rule out: it is merely the next one down the list, nobody has heard
    # it, and excluding it while leaving cur_track in the draw is what lets the
    # track that has this second finished come straight back round again.
    n=$cur_track
    while [ "$n" -eq "$cur_track" ]; do n=$(( RANDOM % ${#ORDER[@]} )); done
    load_track "$n"
    return 0
  fi
  enter_track "$1"
  return 0
}

prev_track() {
  # Within the first few seconds of a track, "previous" means the one before it;
  # after that it means the start of this one, which is what every deck ever made
  # has done and what your hand expects.
  if [ "$pos" -gt 3 ]; then
    mpv_cmd '{"command":["seek",0,"absolute"]}'
    return 0
  fi
  [ "$cur_track" -gt 0 ] || { mpv_cmd '{"command":["seek",0,"absolute"]}'; return 0; }
  load_track $(( cur_track - 1 ))
  return 0
}

# The record ran out: mpv reached the end of the playlist and went idle, which it
# reports by putting playlist-pos back to -1. The panel says so rather than
# quietly sitting there looking like it hung.
album_ended() {
  local n
  # Shuffle is not over just because the bottom row has played. mpv walks the
  # playlist in order and falls off the end of it; under shuffle that means it
  # ran out of entries to walk to, not that every track has had its turn — and
  # the row it happened to fall off is only the last one by accident. Asked
  # first, because a shuffled record ignores where the list ends.
  if [ "$shuffle" -eq 1 ] && [ "${#ORDER[@]}" -gt 1 ]; then
    n=$cur_track
    while [ "$n" -eq "$cur_track" ]; do n=$(( RANDOM % ${#ORDER[@]} )); done
    load_track "$n"
    return 0
  fi
  # REPEAT ALBUM is handled here rather than by mpv's own loop-playlist, because
  # this is also where shuffle has to be asked, and one place that decides what
  # follows the last track is easier to be sure of than two.
  if [ "$repeat" -eq 1 ] && [ "${#ORDER[@]}" -gt 0 ]; then
    load_track 0
    return 0
  fi
  # A record heard to the end is not a record you are partway through. Left as it
  # was, the next time you reached for this one it would offer to drop you thirty
  # seconds from the run-out groove.
  resume_clear
  mode_label=FINISHED
  status='▪ END OF ALBUM — PRESS Q TO QUIT, ⏎ TO PLAY A TRACK'
  # The last reading mpv sent was a fraction before the end, and leaving it there
  # would park both meters just short of full on a record that has finished.
  pos=$tdur
  last_pos=-1
  np_draw
  return 0
}

# ------------------------------------------------------------------- main --

term_size
if [ -t 0 ] && [ -t 1 ] \
   && [ "$TERM_LINES" -ge "$NP_MIN_LINES" ] && [ "$TERM_COLS" -ge $(( PANEL + 2 )) ]; then
  screen_on || true
fi

# What to play: an argument if there was one, the disc if --cd was asked for, or
# whatever the picker is told to show.
if [ -n "$SOURCE_ARG" ]; then
  [ -e "$SOURCE_ARG" ] || die "no such file or directory: $SOURCE_ARG"
  if [ -d "$SOURCE_ARG" ]; then
    PICKED="dir	$SOURCE_ARG	$(basename "$SOURCE_ARG")	folder"
  else
    case "$SOURCE_ARG" in
      *.zip|*.ZIP) PICKED="zip	$SOURCE_ARG	$(basename "$SOURCE_ARG")	zip" ;;
      *)           die "not a zip or a folder: $SOURCE_ARG" ;;
    esac
  fi
elif [ "$WANT_CD" -eq 1 ]; then
  find_cd || die "no audio CD in the drive"
  PICKED="cd	$CD_VOLUME	$(basename "$CD_VOLUME")	in the drive"
else
  scan_sources
  pick_source || { screen_off; exit 0; }
fi

open_source "$PICKED"
read_metadata
[ "$SRC_KIND" = cd ] && { cd_metadata || true; }
order_tracks

if [ "$DRY_RUN" -eq 1 ]; then
  screen_off
  printf '\n  %s — %s (%s)\n' "${ALBUM:-—}" "${ALBUM_ARTIST:-—}" "${YEAR:-—}"
  printf '  %d tracks, %s, from %s\n\n' "${#ORDER[@]}" "$(mmss "$TOTAL")" "$META_SOURCE"
  i=1
  for k in "${ORDER[@]}"; do
    printf '   %2d. %s %6s\n' "$i" "$(fit "${TITLES[$k]}" 52)" "$(mmss "${DURS[$k]}")"
    i=$(( i + 1 ))
  done
  printf '\n'
  exit 0
fi

[ "$SCREEN" -eq 1 ] || die "the panel needs a terminal at least ${NP_MIN_LINES} rows by $(( PANEL + 2 )) columns"

# Both before the engine, because both are on the very first frame the panel
# draws — and both after everything that names the album, because each is looked
# up by what the record turned out to be rather than by where it came from.
collection_lookup || true
resume_load || true
# The sleeve goes looking on its own and arrives whenever it arrives. Started
# here so that a cover already in the cache is on the very first frame, and one
# that has to be fetched does not hold the record up for a second of network.
art_start || true

engine_start
play
screen_off
exit 0
